<UserControl x:Class="HamoPos.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1200"
             FlowDirection="RightToLeft"
             FontFamily="Times New Roman, Segoe UI, Tahoma, Arial">

    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <!-- 0: Header & Navigation Bar -->
            <RowDefinition Height="Auto" />
            <!-- 1: 4 Financial & Quantity KPI Cards (قيمة الشراء، الكراتين، المفرد، الأصناف) -->
            <RowDefinition Height="Auto" />
            <!-- 2: Filters & Search Bar -->
            <RowDefinition Height="Auto" />
            <!-- 3: Products DataGrid Details -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- 0: HEADER & ACTIONS BAR -->
        <!-- ======================================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource ActionButton}" Command="{Binding BackToMainCommand}" Padding="14,8" Margin="0,0,14,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔙 " FontSize="14" />
                        <TextBlock Text="{Binding Loc[Nav_BackToMain]}" FontWeight="Bold" />
                    </StackPanel>
                </Button>
                <Border Width="42" Height="42" Background="#1E3A8A" CornerRadius="12" Margin="0,0,12,0" BorderBrush="{DynamicResource PrimaryAccent}" BorderThickness="1.5">
                    <TextBlock Text="📦" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Loc[Inv_Title]}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock Text="{Binding Loc[Inv_Subtitle]}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0" />
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource PrimarySuccessButton}" Command="{Binding DataContext.ShowAddProductCommand, RelativeSource={RelativeSource AncestorType=Window}}" Padding="16,10" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="➕ " FontSize="13" />
                        <TextBlock Text="{Binding Loc[Inv_AddProduct]}" FontWeight="Bold" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ActionButton}" Command="{Binding RefreshCommand}" Padding="14,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄 " FontSize="13" />
                        <TextBlock Text="{Binding Loc[Inv_Refresh]}" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ======================================================== -->
        <!-- 1: 4 FINANCIAL & QUANTITY KPI CARDS -->
        <!-- ======================================================== -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <!-- 1: Total Stock Purchase Cost Value -->
                <ColumnDefinition Width="1.2*" />
                <!-- 2: Total Cartons Count -->
                <ColumnDefinition Width="*" />
                <!-- 3: Total Pieces Count (Single) -->
                <ColumnDefinition Width="*" />
                <!-- 4: Total Registered Product Items -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: 💰 إجمالي قيمة الشراء بالمخزن -->
            <Border Grid.Column="0" Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" BorderBrush="{DynamicResource PrimaryAccent}" BorderThickness="1.5" Padding="14,12" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding Loc[Inv_TotalCostValue]}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding TotalStockPurchaseCost, StringFormat='{}{0:N0}'}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource PrimaryAccent}" />
                        <TextBlock Text=" د.ع" FontSize="12" Foreground="{DynamicResource PrimaryAccent}" VerticalAlignment="Bottom" Margin="4,0,0,2" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 2: 📦 إجمالي عدد الكراتين بالمخزن -->
            <Border Grid.Column="1" Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1.5" Padding="14,12" Margin="5,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding Loc[Inv_TotalCartons]}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding TotalStockCartons, StringFormat='{}{0:N0}'}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource SuccessBrush}" />
                        <TextBlock Text=" " FontSize="12" />
                        <TextBlock Text="{Binding Loc[Inv_UnitCartons]}" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Bottom" Margin="2,0,0,2" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 3: 🔢 إجمالي القطع المفردة بالمخزن -->
            <Border Grid.Column="2" Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1.5" Padding="14,12" Margin="5,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding Loc[Inv_TotalPieces]}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding TotalStockPieces, StringFormat='{}{0:N0}'}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource WarningBrush}" />
                        <TextBlock Text=" " FontSize="12" />
                        <TextBlock Text="{Binding Loc[Inv_UnitPieces]}" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Bottom" Margin="2,0,0,2" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 4: 🏷️ عدد أصناف المواد المسجلة -->
            <Border Grid.Column="3" Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1.5" Padding="14,12" Margin="5,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding Loc[Inv_RegisteredProducts]}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding TotalItemsCount, StringFormat='{}{0:N0}'}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text=" " FontSize="12" />
                        <TextBlock Text="{Binding Loc[Inv_UnitTypes]}" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Bottom" Margin="2,0,0,2" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- 2: FILTERS & SEARCH -->
        <!-- ======================================================== -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="240" />
            </Grid.ColumnDefinitions>

            <!-- Search Input -->
            <TextBox Style="{StaticResource ModernDarkTextBox}" 
                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                     Padding="12,8" FontSize="14" Margin="0,0,12,0" VerticalAlignment="Center" 
                     ToolTip="{Binding Loc[Inv_SearchPlaceholder]}" />

            <!-- Category Filter ComboBox -->
            <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name" 
                      Height="42" VerticalContentAlignment="Center" Background="{DynamicResource BgDarkSecondary}" Foreground="{DynamicResource TextPrimary}" FontSize="13" />
        </Grid>

        <!-- ======================================================== -->
        <!-- 3: PRODUCTS FULL DETAILS DATAGRID -->
        <!-- ======================================================== -->
        <Border Grid.Row="3" Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="14">
            <DataGrid ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" AutoGenerateColumns="False" 
                      IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      Background="Transparent" RowBackground="Transparent" BorderThickness="0"
                      CanUserResizeColumns="False" CanUserReorderColumns="False" CanUserResizeRows="False" CanUserSortColumns="False"
                      HorizontalGridLinesBrush="{DynamicResource BorderDark}"
                      MouseDoubleClick="DataGrid_MouseDoubleClick"
                      RowHeight="48">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1E293B" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الباركود" Binding="{Binding Barcode}" Width="130" Foreground="{DynamicResource PrimaryAccent}" FontWeight="Bold" FontSize="13" />
                    <DataGridTextColumn Header="اسم المادة" Binding="{Binding Name}" Width="2*" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="14" />
                    <DataGridTextColumn Header="التصنيف" Binding="{Binding Category.Name}" Width="120" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                    <DataGridTextColumn Header="المندوب المورد" Binding="{Binding SupplierName}" Width="130" Foreground="{DynamicResource TextMuted}" FontSize="12" />
                    
                    <!-- سعر الشراء والتكلفة -->
                    <DataGridTextColumn Header="سعر الشراء (التكلفة)" Binding="{Binding Cost, StringFormat='{}{0:N0} د.ع'}" Width="140" Foreground="{DynamicResource WarningBrush}" FontWeight="Bold" FontSize="13" />
                    
                    <!-- سعر البيع المفرد -->
                    <DataGridTextColumn Header="سعر البيع (مفرد)" Binding="{Binding Price, StringFormat='{}{0:N0} د.ع'}" Width="130" Foreground="{DynamicResource SuccessBrush}" FontWeight="Black" FontSize="13" />
                    
                    <!-- المخزون (قطع مفردة) -->
                    <DataGridTextColumn Header="القطع (المفرد)" Binding="{Binding StockQuantity, StringFormat='{}{0:N0}'}" Width="110" Foreground="{DynamicResource WarningBrush}" FontWeight="Black" FontSize="14" />
                    
                    <!-- الكراتين -->
                    <DataGridTextColumn Header="الكراتين" Binding="{Binding CartonsCount, StringFormat='{}{0:N0}'}" Width="90" Foreground="{DynamicResource PrimaryAccent}" FontWeight="Bold" FontSize="13" />
                    
                    <!-- الإجراءات -->
                    <DataGridTemplateColumn Header="إجراءات" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource PrimaryAccentButton}" 
                                            Command="{Binding DataContext.EditProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" Padding="10,5" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding DataContext.Loc[Inv_Edit], RelativeSource={RelativeSource AncestorType=UserControl}}" FontWeight="Bold" />
                                    </Button>
                                    <Button Style="{StaticResource DangerButton}" 
                                            Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" Padding="10,5">
                                        <TextBlock Text="{Binding DataContext.Loc[Inv_Delete], RelativeSource={RelativeSource AncestorType=UserControl}}" FontWeight="Bold" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
