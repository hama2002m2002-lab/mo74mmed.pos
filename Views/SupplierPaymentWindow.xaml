<Window x:Class="HamoPos.Views.SupplierPaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تسجيل دفعة نقدية للمندوب"
        Height="460" Width="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI, Tahoma, Arial">

    <Border Background="{DynamicResource BgDarkSecondary}" 
            CornerRadius="16" 
            BorderBrush="{DynamicResource BorderDark}" 
            BorderThickness="1.5" 
            Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.6" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" Background="#064E3B" CornerRadius="10" Margin="0,0,10,0">
                        <TextBlock Text="💳" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="تسجيل دفعة نقدية للمندوب" FontSize="16" FontWeight="Black" Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock x:Name="TxtSupplierName" Text="اسم المندوب" FontSize="12" Foreground="#34D399" FontWeight="Bold" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <Button HorizontalAlignment="Right" Click="Close_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6">
                    <TextBlock Text="✕" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" />
                </Button>
            </Grid>

            <!-- Body Form -->
            <StackPanel Grid.Row="1">
                <TextBlock Text="المبلغ المدفوع (د.ع):" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                <TextBox x:Name="TxtAmount" Style="{DynamicResource ModernDarkTextBox}" FontSize="18" FontWeight="Black" TextAlignment="Center" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,0,12" Height="42" />

                <TextBlock Text="رقم الوصل / الإيصال:" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                <TextBox x:Name="TxtReceiptNumber" Style="{DynamicResource ModernDarkTextBox}" FontSize="13" Margin="0,0,0,12" Height="36" />

                <TextBlock Text="ملاحظات وبيان السداد:" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                <TextBox x:Name="TxtNotes" Style="{DynamicResource ModernDarkTextBox}" FontSize="13" Margin="0,0,0,16" Height="36" />
            </StackPanel>

            <!-- Footer Actions -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Click="Save_Click" Style="{DynamicResource PrimarySuccessButton}" Height="42" Cursor="Hand">
                    <TextBlock Text="✔ تأكيد السداد وحفظ الدفعة" FontWeight="Bold" FontSize="13" />
                </Button>
                <Button Grid.Column="2" Click="Close_Click" Style="{DynamicResource ActionButton}" Height="42" Cursor="Hand">
                    <TextBlock Text="إلغاء" FontWeight="Bold" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
