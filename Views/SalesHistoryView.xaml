<UserControl x:Class="HamoPos.Views.SalesHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1200"
             FlowDirection="RightToLeft"
             FontFamily="Times New Roman, Segoe UI, Tahoma, Arial">

    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto" />
            <!-- 1: 4 Financial KPI Summary Cards -->
            <RowDefinition Height="Auto" />
            <!-- 2: Filter Toolbar & Presets -->
            <RowDefinition Height="Auto" />
            <!-- 3: Invoices DataGrid -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- 0: HEADER -->
        <!-- ======================================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="44" Height="44" Background="#1E3A8A" CornerRadius="12" Margin="0,0,12,0" BorderBrush="{DynamicResource PrimaryAccent}" BorderThickness="1.5">
                    <TextBlock Text="💰" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Loc[Nav_SalesHistory]}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock Text="سجل المبيعات الشامل، استعراض تفاصيل الفواتير والوصلات، وإعادة طباعتها" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <Button HorizontalAlignment="Right" Style="{DynamicResource ActionButton}" Command="{Binding RefreshCommand}" Padding="14,8" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔄 " FontSize="13" />
                    <TextBlock Text="تحديث البيانات" FontWeight="Bold" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- ======================================================== -->
        <!-- 1: 4 FINANCIAL KPI SUMMARY CARDS -->
        <!-- ======================================================== -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: 💰 إجمالي المبيعات -->
            <Border Grid.Column="0" Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" BorderBrush="{DynamicResource PrimaryAccent}" BorderThickness="1.5" Padding="14,10" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="💰 إجمالي المبيعات للفترة المحددة" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding TotalSalesAmount, StringFormat='{}{0:N0}'}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource PrimaryAccent}" />
                        <TextBlock Text=" د.ع" FontSize="12" Foreground="{DynamicResource PrimaryAccent}" VerticalAlignment="Bottom" Margin="4,0,0,2" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 2: 🧾 عدد الفواتير المنفذة -->
            <Border Grid.Column="1" Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1.5" Padding="14,10" Margin="5,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="🧾 عدد الفواتير والوصلات" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding TotalInvoicesCount, StringFormat='{}{0:N0}'}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource SuccessBrush}" />
                        <TextBlock Text=" فاتورة" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Bottom" Margin="4,0,0,2" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 3: 📈 صافي أرباح المبيعات -->
            <Border Grid.Column="2" Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1.5" Padding="14,10" Margin="5,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="📈 صافي الأرباح المحققة" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding TotalProfitAmount, StringFormat='{}{0:N0}'}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource WarningBrush}" />
                        <TextBlock Text=" د.ع" FontSize="12" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Bottom" Margin="4,0,0,2" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 4: 💳 متوسط قيمة الفاتورة -->
            <Border Grid.Column="3" Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1.5" Padding="14,10" Margin="5,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="💳 متوسط قيمة الفاتورة" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding AverageInvoiceAmount, StringFormat='{}{0:N0}'}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text=" د.ع" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Bottom" Margin="4,0,0,2" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- 2: FILTERS TOOLBAR & PRESETS -->
        <!-- ======================================================== -->
        <Border Grid.Row="2" Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="14,10" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: Quick Date Presets & Custom Calendar Date Pickers -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Quick Date Presets -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="الفترة الزمنية:" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button Style="{DynamicResource ActionButton}" Command="{Binding FilterTodayCommand}" Padding="10,6" Margin="0,0,4,0">
                            <TextBlock Text="📅 اليوم" FontWeight="Bold" FontSize="12" />
                        </Button>
                        <Button Style="{DynamicResource ActionButton}" Command="{Binding FilterYesterdayCommand}" Padding="10,6" Margin="0,0,4,0">
                            <TextBlock Text="أمس" FontSize="12" />
                        </Button>
                        <Button Style="{DynamicResource ActionButton}" Command="{Binding FilterWeekCommand}" Padding="10,6" Margin="0,0,4,0">
                            <TextBlock Text="آخر 7 أيام" FontSize="12" />
                        </Button>
                        <Button Style="{DynamicResource ActionButton}" Command="{Binding FilterMonthCommand}" Padding="10,6" Margin="0,0,4,0">
                            <TextBlock Text="هذا الشهر" FontSize="12" />
                        </Button>
                        <Button Style="{DynamicResource ActionButton}" Command="{Binding FilterAllCommand}" Padding="10,6">
                            <TextBlock Text="كافة المبيعات" FontSize="12" />
                        </Button>
                    </StackPanel>

                    <!-- Custom Calendar Date Selector (من تاريخ / إلى تاريخ) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="{DynamicResource BgDarkPrimary}" CornerRadius="10" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="8,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📅 من:" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <DatePicker SelectedDate="{Binding CustomStartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                            Height="32" Width="135" Margin="0,0,8,0" VerticalAlignment="Center" />

                                <TextBlock Text="إلى:" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <DatePicker SelectedDate="{Binding CustomEndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                            Height="32" Width="135" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Row 1: Search & Dropdown Filters -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <!-- Search Box (Supports Barcode, Product Name, Invoice Number, Cashier, Customer) -->
                        <ColumnDefinition Width="2.2*" />
                        <!-- Payment Method Filter -->
                        <ColumnDefinition Width="150" />
                        <!-- Cashier Filter -->
                        <ColumnDefinition Width="170" />
                    </Grid.ColumnDefinitions>

                    <!-- Modern Search Box with integrated icon & watermark -->
                    <Border Grid.Column="0" Background="{DynamicResource BgDarkPrimary}" CornerRadius="10" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1.5" Height="42" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="10,0,6,0" Foreground="{DynamicResource TextSecondary}" />

                            <TextBox Grid.Column="1" 
                                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                     FontSize="13" FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextPrimary}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="4,8"
                                     VerticalContentAlignment="Center" />

                            <!-- Placeholder Watermark Text -->
                            <TextBlock Grid.Column="1" 
                                       Text="ابحث بالباركود، اسم المادة، رقم الوصل، الكاشير، أو العميل..." 
                                       FontSize="12" Foreground="{DynamicResource TextMuted}"
                                       VerticalAlignment="Center" Margin="6,0,0,0" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SearchQuery}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Clear Search Button -->
                            <Button Grid.Column="2" 
                                    Command="{Binding ClearSearchCommand}"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Cursor="Hand" Margin="0,0,6,0" VerticalAlignment="Center" Padding="4">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SearchQuery}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="✕" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Payment Method Dropdown -->
                    <ComboBox Grid.Column="1" SelectedValue="{Binding SelectedPaymentMethod}" SelectedValuePath="Tag" Height="42" Margin="0,0,10,0" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="💳 طرق الدفع (الكل)" Tag="All" IsSelected="True" />
                        <ComboBoxItem Content="💵 نقداً (Cash)" Tag="Cash" />
                        <ComboBoxItem Content="💳 بطاقة (Card)" Tag="Card" />
                    </ComboBox>

                    <!-- Cashier Selector -->
                    <ComboBox Grid.Column="2" ItemsSource="{Binding CashierNames}" SelectedItem="{Binding SelectedCashier}" Height="42" VerticalContentAlignment="Center" />
                </Grid>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- 3: INVOICES MASTER DATAGRID -->
        <!-- ======================================================== -->
        <Border Grid.Row="3" Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="12">
            <DataGrid ItemsSource="{Binding FilteredSales}" SelectedItem="{Binding SelectedSale}" AutoGenerateColumns="False" 
                      IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      Background="Transparent" RowBackground="Transparent" BorderThickness="0"
                      HorizontalGridLinesBrush="{DynamicResource BorderDark}"
                      RowHeight="48">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BgDarkHover}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Status}" Value="Returned">
                                <Setter Property="Background" Value="#2D0B0B" />
                                <Setter Property="Foreground" Value="#F87171" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <!-- رقم الفاتورة -->
                    <DataGridTemplateColumn Header="رقم الوصل" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding InvoiceNumber}" FontWeight="Bold" FontSize="13">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryAccent}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Returned">
                                                        <Setter Property="Foreground" Value="#EF4444" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- التاريخ والوقت -->
                    <DataGridTemplateColumn Header="التاريخ والوقت" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📅 " FontSize="10" />
                                        <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:yyyy/MM/dd hh:mm tt}'}" FontSize="12" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <Border Background="#450A0A" CornerRadius="4" Padding="4,1" Margin="0,2,0,0" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Returned">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding UpdatedAt, StringFormat='{}إرجاع: {0:yyyy/MM/dd hh:mm tt}'}" FontSize="10.5" Foreground="#FCA5A5" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- الكاشير -->
                    <DataGridTextColumn Header="الكاشير" Binding="{Binding User.FullName, TargetNullValue='كاشير عام'}" Width="130" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" FontSize="13" />

                    <!-- عدد المواد -->
                    <DataGridTextColumn Header="المواد" Binding="{Binding Items.Count, StringFormat='{}{0} أصناف'}" Width="90" Foreground="{DynamicResource TextSecondary}" FontSize="12" />

                    <!-- المجموع الفرعي -->
                    <DataGridTextColumn Header="المجموع الفرعي" Binding="{Binding SubTotal, StringFormat='{}{0:N0} د.ع'}" Width="120" Foreground="{DynamicResource TextSecondary}" FontSize="12" />

                    <!-- الخصم -->
                    <DataGridTextColumn Header="الخصم" Binding="{Binding DiscountAmount, StringFormat='{}{0:N0} د.ع'}" Width="100" Foreground="{DynamicResource DangerBrush}" FontSize="12" />

                    <!-- المبلغ الإجمالي النهائي -->
                    <DataGridTemplateColumn Header="المبلغ الإجمالي" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TotalAmount, StringFormat='{}{0:N0} د.ع'}" FontWeight="Black" FontSize="13.5" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Returned">
                                                    <Setter Property="Foreground" Value="#EF4444" />
                                                    <Setter Property="Text" Value="{Binding TotalAmount, StringFormat='{}- {0:N0} د.ع'}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- طريقة الدفع -->
                    <DataGridTemplateColumn Header="طريقة الدفع" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="6" Padding="8,3" HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#1E3A8A" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PaymentMethod}" Value="Cash">
                                                    <Setter Property="Background" Value="#064E3B" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding PaymentMethod}" FontSize="11" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#93C5FD" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PaymentMethod}" Value="Cash">
                                                        <Setter Property="Foreground" Value="#34D399" />
                                                        <Setter Property="Text" Value="💵 نقداً" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PaymentMethod}" Value="Card">
                                                        <Setter Property="Text" Value="💳 بطاقة" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- الحالة -->
                    <DataGridTemplateColumn Header="الحالة" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" Padding="8,4" HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#064E3B" />
                                            <Setter Property="BorderBrush" Value="#10B981" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Returned">
                                                    <Setter Property="Background" Value="#500724" />
                                                    <Setter Property="BorderBrush" Value="#EF4444" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#34D399" />
                                                <Setter Property="Text" Value="🟢 مكتمل" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Returned">
                                                        <Setter Property="Foreground" Value="#F87171" />
                                                        <Setter Property="Text" Value="🔴 مسترجع" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- الإجراءات (عرض وطباعة واسترجاع) -->
                    <DataGridTemplateColumn Header="إجراءات" Width="240">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <!-- زر عرض تفاصيل الوصل -->
                                    <Button Style="{DynamicResource PrimaryAccentButton}" 
                                            Command="{Binding DataContext.ViewInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" Padding="8,4" FontSize="11" Margin="0,0,4,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="👁️ " FontSize="11" />
                                            <TextBlock Text="معاينة" FontWeight="Bold" FontSize="11" />
                                        </StackPanel>
                                    </Button>

                                    <!-- زر طباعة الوصل المباشرة -->
                                    <Button Style="{DynamicResource ActionButton}" 
                                            Command="{Binding DataContext.PrintInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" Padding="8,4" FontSize="11" Margin="0,0,4,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🖨️ " FontSize="11" />
                                            <TextBlock Text="طباعة" FontWeight="Bold" FontSize="11" />
                                        </StackPanel>
                                    </Button>

                                    <!-- زر استرجاع الوصل -->
                                    <Button Command="{Binding DataContext.ReturnSaleInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" Padding="8,4" FontSize="11">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource DangerButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Returned">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                        <Setter Property="Opacity" Value="0.4" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔄 " FontSize="11" />
                                            <TextBlock Text="استرجاع" FontWeight="Bold" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ======================================================== -->
        <!-- MODAL: DETAILED INVOICE RECEIPT VIEWER & PRINTER -->
        <!-- ======================================================== -->
        <Grid Grid.RowSpan="4" Visibility="{Binding IsInvoiceModalOpen, Converter={StaticResource BoolToVis}}" Background="#80000000">
            <Border Background="{DynamicResource BgDarkSecondary}" CornerRadius="18" BorderBrush="{DynamicResource BorderDark}" BorderThickness="2" 
                    Width="520" MaxHeight="720" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Modal Header -->
                        <RowDefinition Height="Auto" />
                        <!-- Receipt Content Details -->
                        <RowDefinition Height="*" />
                        <!-- Action Buttons -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🧾 " FontSize="18" />
                            <TextBlock Text="تفاصيل وصل البيع والفاتورة" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Style="{DynamicResource ActionButton}" Command="{Binding CloseInvoiceModalCommand}" Padding="8,4">
                            <TextBlock Text="✕" FontSize="14" FontWeight="Bold" />
                        </Button>
                    </Grid>

                    <!-- Receipt Preview Box (Scrollable) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14">
                        <Border Background="#FFFFFF" CornerRadius="10" BorderBrush="#000000" BorderThickness="1.5" Padding="18">
                            <StackPanel>
                                <!-- Receipt Store Header -->
                                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <TextBlock Text="⚡ 7amo.pos" FontSize="18" FontWeight="Black" Foreground="#000000" HorizontalAlignment="Center" />
                                    <TextBlock Text="نظام نقاط البيع وإدارة المخازن المتكامل" FontSize="11" Foreground="#475569" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    <TextBlock Text="-----------------------------------------------------" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>

                                <!-- Meta Info -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding SelectedSale.InvoiceNumber, StringFormat='رقم الوصل: {0}'}" FontSize="12" FontWeight="Bold" Foreground="#000000" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedSale.CreatedAt, StringFormat='التاريخ: {0:yyyy-MM-dd hh:mm tt}'}" FontSize="11" Foreground="#475569" HorizontalAlignment="Right" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding SelectedSale.User.FullName, TargetNullValue='كاشير عام', StringFormat='الكاشير: {0}'}" FontSize="11" Foreground="#475569" Margin="0,3,0,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedSale.PaymentMethod, StringFormat='الدفع: {0}'}" FontSize="11" FontWeight="Bold" Foreground="#000000" HorizontalAlignment="Right" Margin="0,3,0,0" />
                                </Grid>

                                <Separator Background="#000000" Margin="0,4,0,8" />

                                <!-- Items Table Header -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1.2*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="المادة" FontSize="11" FontWeight="Bold" Foreground="#000000" />
                                    <TextBlock Grid.Column="1" Text="الكمية" FontSize="11" FontWeight="Bold" Foreground="#000000" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="السعر" FontSize="11" FontWeight="Bold" Foreground="#000000" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="الإجمالي" FontSize="11" FontWeight="Bold" Foreground="#000000" HorizontalAlignment="Right" />
                                </Grid>

                                <!-- Items List -->
                                <ItemsControl ItemsSource="{Binding SelectedSale.Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="1.2*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding ProductName}" FontSize="11" Foreground="#000000" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat='{}{0:N0}'}" FontSize="11" Foreground="#000000" HorizontalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding UnitPrice, StringFormat='{}{0:N0}'}" FontSize="11" Foreground="#000000" HorizontalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding TotalPrice, StringFormat='{}{0:N0} د.ع'}" FontSize="11" FontWeight="Bold" Foreground="#000000" HorizontalAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Separator Background="#000000" Margin="0,8,0,8" />

                                <!-- Financial Totals -->
                                <StackPanel HorizontalAlignment="Right" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,2">
                                        <TextBlock Text="المجموع الفرعي: " FontSize="11" Foreground="#475569" />
                                        <TextBlock Text="{Binding SelectedSale.SubTotal, StringFormat='{}{0:N0} د.ع'}" FontSize="12" FontWeight="Bold" Foreground="#000000" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                                        <TextBlock Text="الخصم الممنوح: " FontSize="11" Foreground="#DC2626" />
                                        <TextBlock Text="{Binding SelectedSale.DiscountAmount, StringFormat='{}{0:N0} د.ع'}" FontSize="12" FontWeight="Bold" Foreground="#DC2626" />
                                    </StackPanel>

                                    <Border Background="#F1F5F9" CornerRadius="6" Padding="10,6" Margin="0,4,0,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="المبلغ الإجمالي المطلوب: " FontSize="13" FontWeight="Bold" Foreground="#000000" />
                                            <TextBlock Text="{Binding SelectedSale.TotalAmount, StringFormat='{}{0:N0} د.ع'}" FontSize="16" FontWeight="Black" Foreground="#059669" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Footer Message -->
                                <TextBlock Text="شكراً لتعاملكم معنا ونتشرف بزيارتكم دائماً" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </ScrollViewer>

                    <!-- Modal Actions -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{DynamicResource DangerButton}" Command="{Binding ReturnSaleInvoiceCommand}" Padding="16,8" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄 " FontSize="14" />
                                <TextBlock Text="استرجاع هذا الوصل" FontWeight="Bold" FontSize="13" />
                            </StackPanel>
                        </Button>
                        <Button Style="{DynamicResource ActionButton}" Command="{Binding CloseInvoiceModalCommand}" Padding="16,8" Margin="0,0,10,0">
                            <TextBlock Text="إغلاق" FontWeight="SemiBold" />
                        </Button>
                        <Button Style="{DynamicResource PrimarySuccessButton}" Command="{Binding PrintCurrentModalInvoiceCommand}" Padding="20,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🖨️ " FontSize="15" />
                                <TextBlock Text="طباعة الوصل" FontWeight="Black" FontSize="13" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
