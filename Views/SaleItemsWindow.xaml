<Window x:Class="HamoPos.Views.SaleItemsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تفاصيل الفاتورة"
        Height="550" Width="680"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI, Tahoma, Arial">

    <Border Background="{DynamicResource BgDarkSecondary}" 
            CornerRadius="16" 
            BorderBrush="{DynamicResource BorderDark}" 
            BorderThickness="1.5" 
            Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.6" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Header -->
                <RowDefinition Height="Auto" />
                <!-- Items Table -->
                <RowDefinition Height="*" />
                <!-- Footer -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" Background="#0C2548" CornerRadius="10" Margin="0,0,10,0">
                        <TextBlock Text="🧾" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtInvoiceNumber" Text="تفاصيل الفاتورة" FontSize="16" FontWeight="Black" Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock x:Name="TxtInvoiceMeta" Text="قائمة المواد المشتراة في هذه الفاتورة" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <Button HorizontalAlignment="Right" Click="Close_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6">
                    <TextBlock Text="✕" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" />
                </Button>
            </Grid>

            <!-- Table -->
            <Border Grid.Row="1" Background="#0A0F1D" CornerRadius="12" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="8">
                <DataGrid x:Name="GridItems" AutoGenerateColumns="False" 
                          IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          Background="Transparent" RowBackground="Transparent" BorderThickness="0"
                          HorizontalGridLinesBrush="{DynamicResource BorderDark}"
                          RowHeight="40">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="المادة" Binding="{Binding ProductName}" Width="2*" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" />
                        <DataGridTextColumn Header="سعر الوحدة" Binding="{Binding UnitPrice, StringFormat='{}{0:N0} د.ع'}" Width="130" Foreground="{DynamicResource SuccessBrush}" />
                        <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, StringFormat='{}{0:0}'}" Width="90" Foreground="{DynamicResource WarningBrush}" FontWeight="Bold" />
                        <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalPrice, StringFormat='{}{0:N0} د.ع'}" Width="130" Foreground="{DynamicResource PrimaryAccent}" FontWeight="Black" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Footer Actions -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Button Click="Close_Click" Style="{DynamicResource ActionButton}" Padding="24,8" HorizontalAlignment="Right" Cursor="Hand">
                    <TextBlock Text="إغلاق النافذة" FontWeight="Bold" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
