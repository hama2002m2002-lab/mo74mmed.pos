<UserControl x:Class="HamoPos.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="1100" d:DesignWidth="1200"
             FlowDirection="RightToLeft"
             FontFamily="Times New Roman, Segoe UI, Tahoma, Arial">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <!-- 0: Title & Refresh -->
                <RowDefinition Height="Auto" />
                <!-- 1: Top KPI Stat Cards -->
                <RowDefinition Height="Auto" />
                <!-- 2: Primary Visual Charts (Weekly Trend + Payment Distribution) -->
                <RowDefinition Height="Auto" />
                <!-- 3: Secondary Visual Charts (Top Products + Peak Hours Activity) -->
                <RowDefinition Height="Auto" />
                <!-- 4: Recent Sales & Low Stock Tables -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ======================================================== -->
            <!-- 0: SECTION TITLE & REFRESH -->
            <!-- ======================================================== -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="{Binding Loc[Dash_Title]}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock Text="{Binding Loc[Dash_Subtitle]}" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0" />
                </StackPanel>

                <Button HorizontalAlignment="Right" Style="{StaticResource ActionButton}" Command="{Binding RefreshCommand}" Padding="14,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄 " FontSize="13" />
                        <TextBlock Text="{Binding Loc[Dash_Refresh]}" FontWeight="Bold" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ======================================================== -->
            <!-- 1: TOP KPI STAT CARDS (4 CARDS) -->
            <!-- ======================================================== -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Card 1: Today Revenue -->
                <Border Grid.Column="0" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="16" Margin="0,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="38" Height="38" Background="#064E3B" CornerRadius="8" Margin="0,0,10,0">
                                <TextBlock Text="💵" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding Loc[Dash_TodaySales]}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Text="{Binding TodayRevenue, StringFormat='{}{0:N0}'}" FontSize="24" FontWeight="Black" Foreground="{DynamicResource SuccessBrush}" />
                            <TextBlock Text="{Binding Loc[App_Currency_Short], StringFormat=' {0}'}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Bottom" Margin="4,0,0,3" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Card 2: Today Invoices -->
                <Border Grid.Column="1" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="16" Margin="8,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="38" Height="38" Background="#1E3A8A" CornerRadius="8" Margin="0,0,10,0">
                                <TextBlock Text="🧾" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding Loc[Dash_TodayInvoices]}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Text="{Binding TodayInvoicesCount}" FontSize="24" FontWeight="Black" Foreground="{DynamicResource PrimaryAccent}" />
                            <TextBlock Text="{Binding Loc[Dash_InvoiceUnit], StringFormat=' {0}'}" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Bottom" Margin="4,0,0,3" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Card 3: Monthly Revenue -->
                <Border Grid.Column="2" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="16" Margin="8,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="38" Height="38" Background="#581C87" CornerRadius="8" Margin="0,0,10,0">
                                <TextBlock Text="📈" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding Loc[Dash_MonthSales]}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Text="{Binding MonthlyRevenue, StringFormat='{}{0:N0}'}" FontSize="24" FontWeight="Black" Foreground="#C084FC" />
                            <TextBlock Text="{Binding Loc[App_Currency_Short], StringFormat=' {0}'}" FontSize="14" FontWeight="Bold" Foreground="#C084FC" VerticalAlignment="Bottom" Margin="4,0,0,3" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Card 4: Low Stock Alert -->
                <Border Grid.Column="3" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="16" Margin="8,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="38" Height="38" Background="#78350F" CornerRadius="8" Margin="0,0,10,0">
                                <TextBlock Text="⚠️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding Loc[Dash_LowStockAlerts]}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Text="{Binding LowStockCount}" FontSize="24" FontWeight="Black" Foreground="{DynamicResource WarningBrush}" />
                            <TextBlock Text="{Binding Loc[Dash_ItemsNeedOrder], StringFormat=' {0}'}" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Bottom" Margin="4,0,0,3" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ======================================================== -->
            <!-- 2: PRIMARY CHARTS ROW (WEEKLY SALES + PAYMENT DISTRIBUTION) -->
            <!-- ======================================================== -->
            <Grid Grid.Row="2" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6.2*" />
                    <ColumnDefinition Width="3.8*" />
                </Grid.ColumnDefinitions>

                <!-- CHART 1: WEEKLY SALES TREND (BAR CHART) -->
                <Border Grid.Column="0" Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="18" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Header -->
                            <RowDefinition Height="Auto" />
                            <!-- Visual Chart Canvas -->
                            <RowDefinition Height="180" />
                            <!-- Footer Summary Stats -->
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Chart Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊 " FontSize="16" />
                                <TextBlock Text="{Binding Loc[Dash_ChartWeeklySales]}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                            </StackPanel>
                        </Grid>

                        <!-- Chart Columns Container -->
                        <Border Grid.Row="1" Background="{DynamicResource BgDarkPrimary}" CornerRadius="10" Padding="12,10" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1">
                            <ItemsControl ItemsSource="{Binding WeeklySalesBars}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="4,0">
                                            <Grid.RowDefinitions>
                                                <!-- Revenue Label -->
                                                <RowDefinition Height="Auto" />
                                                <!-- Animated Bar -->
                                                <RowDefinition Height="Auto" />
                                                <!-- Day Label & Date -->
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Revenue Label on top of Bar -->
                                            <TextBlock Grid.Row="0" Text="{Binding FormattedRevenue}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryAccent}" />
                                                                <Setter Property="FontWeight" Value="Black" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- Visual Glowing Vertical Bar -->
                                            <Border Grid.Row="1" Width="32" Height="{Binding BarHeight}" CornerRadius="6,6,2,2" HorizontalAlignment="Center" Margin="0,0,0,6">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                                                    <GradientStop Color="#1E3A8A" Offset="0" />
                                                                    <GradientStop Color="#3B82F6" Offset="1" />
                                                                </LinearGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                <Setter Property="Background">
                                                                    <Setter.Value>
                                                                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                                                            <GradientStop Color="#059669" Offset="0" />
                                                                            <GradientStop Color="#10B981" Offset="1" />
                                                                        </LinearGradientBrush>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Opacity" Value="0.85" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <!-- Day Name & Date -->
                                            <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding DayName}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                    <Setter Property="Foreground" Value="#34D399" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding ShortDate}" FontSize="9" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- Footer Summary Stats -->
                        <Grid Grid.Row="2" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Loc[Dash_WeeklyTotal]}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="{Binding WeeklyTotalRevenue, StringFormat=' {0:N0} د.ع'}" FontSize="13" FontWeight="Black" Foreground="{DynamicResource PrimaryAccent}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Loc[Dash_DailyAverage]}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="{Binding DailyAverageRevenue, StringFormat=' {0:N0} د.ع'}" FontSize="13" FontWeight="Black" Foreground="{DynamicResource SuccessBrush}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- CHART 2: PAYMENT METHODS DISTRIBUTION (PROGRESS BARS) -->
                <Border Grid.Column="1" Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="💳 " FontSize="16" />
                            <TextBlock Text="{Binding Loc[Dash_ChartPaymentDist]}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                        </StackPanel>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding PaymentDistributions}" VerticalAlignment="Center">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0F172A" CornerRadius="10" Padding="12,10" Margin="0,0,0,10" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Row 1: Icon + Method Name + Percentage -->
                                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Icon}" FontSize="13" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding MethodName}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding FormattedAmount}" FontSize="12" FontWeight="Black" Foreground="{DynamicResource TextPrimary}" Margin="0,0,6,0" />
                                                    <Border Background="#1E293B" CornerRadius="4" Padding="6,1">
                                                        <TextBlock Text="{Binding FormattedPercentage}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Row 2: Visual Percentage Bar -->
                                            <Border Grid.Row="1" Height="8" Background="#1E293B" CornerRadius="4">
                                                <Grid>
                                                    <ProgressBar Value="{Binding Percentage}" Maximum="100" Height="8" Background="Transparent" BorderThickness="0" Foreground="{Binding ColorHex}" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>

            <!-- ======================================================== -->
            <!-- 3: SECONDARY CHARTS (TOP PRODUCTS + PEAK HOURS ACTIVITY) -->
            <!-- ======================================================== -->
            <Grid Grid.Row="3" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5.5*" />
                    <ColumnDefinition Width="4.5*" />
                </Grid.ColumnDefinitions>

                <!-- CHART 3: TOP 5 BEST SELLING PRODUCTS (HORIZONTAL BARS) -->
                <Border Grid.Column="0" Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="18" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="🏆 " FontSize="16" />
                            <TextBlock Text="{Binding Loc[Dash_ChartTopProducts]}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                        </StackPanel>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding TopProductsChart}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0F172A" CornerRadius="8" Padding="10,8" Margin="0,0,0,8" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Rank Badge -->
                                            <Border Grid.Column="0" Width="30" Height="30" Background="#1E293B" CornerRadius="6" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding RankBadge}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Name & Visual Progress Bar -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProductName}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />
                                                <ProgressBar Value="{Binding BarPercent}" Maximum="100" Height="6" Background="#1E293B" BorderThickness="0" Foreground="{Binding BarColor}" />
                                            </StackPanel>

                                            <!-- Quantity & Total Amount -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Quantity, StringFormat='{}{0:N0} قطعة'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding FormattedAmount}" FontSize="11" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- CHART 4: PEAK HOURS & ACTIVITY RADAR -->
                <Border Grid.Column="1" Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="⏰ " FontSize="16" />
                            <TextBlock Text="{Binding Loc[Dash_ChartPeakHours]}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                        </StackPanel>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding HourlyActivities}" VerticalAlignment="Center">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0F172A" CornerRadius="8" Padding="10,8" Margin="0,0,0,8" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="30" Height="30" Background="#1E293B" CornerRadius="6" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Icon}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TimeSlotName}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4" />
                                                <ProgressBar Value="{Binding ActivityPercent}" Maximum="100" Height="6" Background="#1E293B" BorderThickness="0" Foreground="{Binding ColorHex}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding SalesCount, StringFormat='{}{0} عملية'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding FormattedAmount}" FontSize="10" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>

            <!-- ======================================================== -->
            <!-- 4: BOTTOM ROW: RECENT SALES & LOW STOCK TABLES -->
            <!-- ======================================================== -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*" />
                    <ColumnDefinition Width="4*" />
                </Grid.ColumnDefinitions>

                <!-- Recent Sales Table -->
                <Border Grid.Column="0" Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="18" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="🧾 " FontSize="16" />
                            <TextBlock Text="{Binding Loc[Dash_RecentInvoices]}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                        </StackPanel>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding RecentSales}" AutoGenerateColumns="False" 
                                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  Background="Transparent" RowBackground="Transparent" BorderThickness="0"
                                  HorizontalGridLinesBrush="{DynamicResource BorderDark}" RowHeight="40">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding InvoiceNumber}" Width="150" Foreground="{DynamicResource PrimaryAccent}" FontWeight="Bold" />
                                <DataGridTextColumn Header="الوقت" Binding="{Binding CreatedAt, StringFormat='{}{0:hh:mm tt}'}" Width="90" Foreground="{DynamicResource TextSecondary}" />
                                <DataGridTextColumn Header="طريقة الدفع" Binding="{Binding PaymentMethod}" Width="100" Foreground="{DynamicResource TextPrimary}" />
                                <DataGridTextColumn Header="المبلغ الإجمالي" Binding="{Binding TotalAmount, StringFormat='{}{0:N0} د.ع'}" Width="*" Foreground="{DynamicResource SuccessBrush}" FontWeight="Black" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Low Stock Items Table -->
                <Border Grid.Column="1" Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="⚠️ " FontSize="16" />
                            <TextBlock Text="{Binding Loc[Dash_ExpiringLowStock]}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" />
                        </StackPanel>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding LowStockProducts}" AutoGenerateColumns="False" 
                                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  Background="Transparent" RowBackground="Transparent" BorderThickness="0"
                                  HorizontalGridLinesBrush="{DynamicResource BorderDark}" RowHeight="40">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="المادة" Binding="{Binding Name}" Width="2*" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" />
                                <DataGridTextColumn Header="المتبقي" Binding="{Binding StockQuantity, StringFormat='{}{0:N0}'}" Width="*" Foreground="{DynamicResource WarningBrush}" FontWeight="Black" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
