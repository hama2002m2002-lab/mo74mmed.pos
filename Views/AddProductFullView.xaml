<UserControl x:Class="HamoPos.Views.AddProductFullView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1300"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <!-- 0: Header & Action Buttons Bar -->
            <RowDefinition Height="Auto" />
            <!-- 1: Top Expiry & Audit Info Bar -->
            <RowDefinition Height="Auto" />
            <!-- 2: Full Width Form Workspace -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- 0: TOP ACTION BUTTONS & TITLE BAR -->
        <!-- ======================================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource ActionButton}" Command="{Binding BackToNavigationCommand}" Padding="14,8" Margin="0,0,14,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔙 " FontSize="14" />
                        <TextBlock Text="{Binding Loc[Add_BackToMain]}" FontWeight="Bold" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding FormHeaderTitle}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Action Buttons on Top Right -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- 1. Browse Inventory Modal Button -->
                <Button Style="{StaticResource ActionButton}" Command="{Binding OpenInventoryLookupCommand}" Padding="14,9" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📦 " FontSize="15" />
                        <TextBlock Text="{Binding Loc[Add_BrowseInventory]}" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <!-- 2. Clear All Fields Button -->
                <Button Style="{StaticResource ActionButton}" Command="{Binding ClearFormCommand}" Padding="14,9" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🧹 " FontSize="15" />
                        <TextBlock Text="{Binding Loc[Add_ClearFields]}" />
                    </StackPanel>
                </Button>

                <!-- 3. Save Product Button -->
                <Button Style="{StaticResource PrimarySuccessButton}" Command="{Binding SaveProductCommand}" Padding="20,9">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💾 " FontSize="16" />
                        <TextBlock Text="{Binding Loc[Add_SaveButton]}" FontWeight="Bold" FontSize="14" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ======================================================== -->
        <!-- 1: EXPIRY DATES, ALERTS & AUDIT HEADER -->
        <!-- ======================================================== -->
        <Border Grid.Row="1" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="16,10" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Expiry Date Settings -->
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <!-- Audit Fields -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Expiry Date Label -->
                    <TextBlock Text="{Binding Loc[Add_ExpiryDate]}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    
                    <!-- Date Input (Manual Left-To-Right + Calendar Picker, dynamic for light/dark theme) -->
                    <Border Background="{DynamicResource BgDarkPrimary}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1.5" CornerRadius="8" Height="36" Margin="0,0,16,0" Padding="4,2" VerticalAlignment="Center">
                        <Grid FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="32" />
                            </Grid.ColumnDefinitions>
                            <!-- Manual Text Box (LTR) -->
                            <TextBox Grid.Column="0" 
                                     Text="{Binding ExpiryDateManualString, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="Transparent" Foreground="{DynamicResource PrimaryAccent}" BorderThickness="0" 
                                     FontSize="13.5" FontWeight="Bold" FontFamily="Segoe UI, Tahoma, Consolas"
                                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                     ToolTip="اكتب التاريخ يدوياً من اليسار لليمين (مثال: 2026/12/31)" />
                            
                            <!-- Calendar Picker Icon Button -->
                            <DatePicker Grid.Column="1" SelectedDate="{Binding ExpiryDate, Mode=TwoWay}" 
                                        Opacity="0.05" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        ToolTip="اختر التاريخ من التقويم" />
                            <TextBlock Grid.Column="1" Text="📅" FontSize="14" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Alert Days Label -->
                    <TextBlock Text="{Binding Loc[Add_AlertDays]}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    
                    <!-- Alert Days Input (Dynamic light/dark theme, LTR) -->
                    <Border Background="{DynamicResource BgDarkPrimary}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1.5" CornerRadius="8" Width="70" Height="36" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBox Text="{Binding ExpiryAlertDays, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0}'}" 
                                 GotFocus="NumberTextBox_GotFocus"
                                 Background="Transparent" Foreground="{DynamicResource PrimaryAccent}" BorderThickness="0"
                                 FontSize="15" FontWeight="Black" FontFamily="Segoe UI, Tahoma, Arial" FlowDirection="LeftToRight"
                                 TextAlignment="Center" VerticalContentAlignment="Center" />
                    </Border>

                    <!-- Expiry Status Badge -->
                    <Border Background="{DynamicResource BgDarkPrimary}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ExpiryStatusMessage}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" />
                    </Border>
                </StackPanel>

                <Separator Grid.Column="1" Background="{DynamicResource BorderDark}" Margin="16,0" />

                <!-- Audit Info (Read-Only) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource BgDarkPrimary}" CornerRadius="8" Padding="12,6" Margin="0,0,10,0" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Loc[Add_FirstAdded]}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding CreatedAtString}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource BgDarkPrimary}" CornerRadius="8" Padding="12,6" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Loc[Add_LastUpdated]}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding UpdatedAtString}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- 2: FULL WIDTH FORM WORKSPACE -->
        <!-- ======================================================== -->
        <Border Grid.Row="2" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="24,20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- SECTION 1: BARCODE, NAME, CATEGORY, & SUPPLIER (4 Columns) -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <!-- Barcode -->
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="14" />
                            <!-- Name -->
                            <ColumnDefinition Width="1.8*" />
                            <ColumnDefinition Width="14" />
                            <!-- Category -->
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="14" />
                            <!-- Supplier -->
                            <ColumnDefinition Width="1.4*" />
                        </Grid.ColumnDefinitions>

                        <!-- Barcode Field -->
                        <StackPanel Grid.Column="0">
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="{Binding Loc[Add_Barcode]}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}" />
                                <Button Command="{Binding GenerateBarcodeCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right"
                                        ToolTip="اضغط هنا أو انقر مرتين على الحقل لتوليد باركود تلقائي">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚡ توليد باركود" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBox x:Name="TxtBarcode" Style="{StaticResource ModernDarkTextBox}" 
                                     Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" 
                                     TextAlignment="Center" FontSize="14" FontWeight="Bold"
                                     GotFocus="NumberTextBox_GotFocus"
                                     PreviewMouseDown="TxtBarcode_PreviewMouseDown"
                                     PreviewMouseDoubleClick="TxtBarcode_PreviewMouseDoubleClick"
                                     MouseDoubleClick="TxtBarcode_MouseDoubleClick"
                                     KeyDown="TxtBarcode_KeyDown"
                                     ToolTip="انقر مرتين لتوليد باركود فريد يبدأ بـ 200245 أو اضغط Enter للانتقال لاسم المادة" />
                        </StackPanel>

                        <!-- Product Name Field -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding Loc[Add_ProductName]}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtName" Style="{StaticResource ModernDarkTextBox}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="14" FontWeight="Bold" />
                        </StackPanel>

                        <!-- Category Field (Dark/Light High-Contrast Theme with Add Category Button) -->
                        <StackPanel Grid.Column="4">
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="{Binding Loc[Inv_Category]}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                <Button Command="{Binding OpenAddCategoryModalCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Loc[Add_NewCategory]}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name" 
                                      Height="42" VerticalContentAlignment="Center" Background="{DynamicResource BgDarkPrimary}" Foreground="{DynamicResource TextPrimary}" FontSize="13" />
                        </StackPanel>

                        <!-- Supplier / Rep Field with Small Add/Details Button -->
                        <StackPanel Grid.Column="6">
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="{Binding Loc[Add_SupplierName]}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                <Button Command="{Binding OpenSupplierModalCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Loc[Add_SupplierDetails]}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBox Style="{StaticResource ModernDarkTextBox}" Text="{Binding SupplierName, UpdateSourceTrigger=PropertyChanged}" FontSize="14" />
                        </StackPanel>
                    </Grid>

                    <Separator Background="{DynamicResource BorderDark}" Margin="0,4,0,18" />

                    <!-- SECTION 2: CARTONS, ITEMS PER CARTON, EXTRA PIECES, TOTAL ITEMS, & PURCHASE PRICES -->
                    <TextBlock Text="{Binding Loc[Add_CartonDetailsHeader]}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10" />

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <!-- 1. Cartons -->
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <!-- 2. Items per Carton -->
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <!-- 3. Extra Single Pieces (Optional) -->
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <!-- 4. Total Items (Calculated / Read-Only) -->
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <!-- 5. Carton Purchase Price -->
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <!-- 6. Cost per Single Item (Calculated / Read-Only) -->
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 1. Cartons Count -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Loc[Add_CartonsCount]}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource ModernDarkTextBox}" Text="{Binding CartonsCount, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0}'}" 
                                     GotFocus="NumberTextBox_GotFocus" TextAlignment="Center" FontSize="15" FontWeight="Bold" />
                        </StackPanel>

                        <!-- 2. Items per Carton -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding Loc[Add_ItemsInCarton]}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource ModernDarkTextBox}" Text="{Binding ItemsPerCarton, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0}'}" 
                                     GotFocus="NumberTextBox_GotFocus" TextAlignment="Center" FontSize="15" FontWeight="Bold" />
                        </StackPanel>

                        <!-- 3. Extra Single Pieces (Optional) -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="{Binding Loc[Add_ExtraPieces]}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource ModernDarkTextBox}" Text="{Binding ExtraPiecesCount, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0}'}" 
                                     GotFocus="NumberTextBox_GotFocus" TextAlignment="Center" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}"
                                     ToolTip="قطع مفردة إضافية تضاف إلى مجموع المواد الكلي (اختياري)" />
                        </StackPanel>

                        <!-- 4. Total Items (Calculated / Read-Only) -->
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="{Binding Loc[Add_TotalStock]}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource ModernDarkTextBox}" Text="{Binding StockQuantity, Mode=OneWay, StringFormat='{}{0:0}'}" 
                                     IsReadOnly="True" IsTabStop="False"
                                     TextAlignment="Center" FontSize="15" Background="{DynamicResource BgDarkPrimary}" BorderBrush="{DynamicResource PrimaryAccent}" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}"
                                     ToolTip="يتم حسابه تلقائياً: (الكراتين × المواد داخل الكرتون) + القطع الإضافية" />
                        </StackPanel>

                        <!-- 5. Carton Purchase Price -->
                        <StackPanel Grid.Column="8">
                            <TextBlock Text="{Binding Loc[Add_CartonBuyPrice]}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource ModernDarkTextBox}" Text="{Binding CartonPurchasePrice, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0}'}" 
                                     GotFocus="NumberTextBox_GotFocus" TextAlignment="Center" FontSize="15" FontWeight="Bold" />
                        </StackPanel>

                        <!-- 6. Single Item Cost (Auto Calculated / Read-Only) -->
                        <StackPanel Grid.Column="10">
                            <TextBlock Text="{Binding Loc[Add_PieceCost]}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource ModernDarkTextBox}" Text="{Binding Cost, Mode=OneWay, StringFormat='{}{0:0}'}" 
                                     IsReadOnly="True" IsTabStop="False"
                                     TextAlignment="Center" FontSize="15" Background="{DynamicResource BgDarkPrimary}" BorderBrush="{DynamicResource WarningBrush}" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"
                                     ToolTip="يتم حسابه تلقائياً من سعر شراء الكرتون مقسوماً على عدد المواد" />
                        </StackPanel>
                    </Grid>

                    <Separator Background="{DynamicResource BorderDark}" Margin="0,4,0,18" />

                    <!-- SECTION 3: SELLING PRICES & PROFIT CALCULATIONS (3 SETS FULL WIDTH) -->
                    <TextBlock Text="{Binding Loc[Add_SellingPricingHeader]}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10" />

                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <!-- 1. Retail -->
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <!-- 2. Wholesale -->
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <!-- 3. Carton -->
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 1. Retail Selling Price & Profit -->
                        <Border Grid.Column="0" Background="{DynamicResource BgDarkPrimary}" CornerRadius="10" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="14">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[Add_RetailPrice]}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6" />
                                <TextBox Style="{StaticResource ModernDarkTextBox}" Text="{Binding Price, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0}'}" 
                                         GotFocus="NumberTextBox_GotFocus" TextAlignment="Center" FontSize="16" FontWeight="Black" Margin="0,0,0,10" />

                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Loc[Add_RetailProfitPiece]}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text="{Binding RetailProfitAmount, StringFormat='{}{0:N0} د.ع'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                
                                <!-- NEW: Total Carton Profit Sold at Retail Piece Price -->
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Loc[Add_RetailCartonProfit]}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text="{Binding RetailCartonProfitAmount, StringFormat='{}{0:N0} د.ع'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Right" />
                                </Grid>

                                <Grid>
                                    <TextBlock Text="{Binding Loc[Add_RetailMargin]}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text="{Binding RetailProfitPercent, StringFormat='{}{0:N1}%'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 2. Wholesale Selling Price & Profit -->
                        <Border Grid.Column="2" Background="{DynamicResource BgDarkPrimary}" CornerRadius="10" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="14">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[Add_WholesalePrice]}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6" />
                                <TextBox Style="{StaticResource ModernDarkTextBox}" Text="{Binding WholesalePrice, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0}'}" 
                                         GotFocus="NumberTextBox_GotFocus" TextAlignment="Center" FontSize="16" FontWeight="Black" Margin="0,0,0,10" />

                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Loc[Add_WholesaleProfitPiece]}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text="{Binding WholesaleProfitAmount, StringFormat='{}{0:N0} د.ع'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid>
                                    <TextBlock Text="{Binding Loc[Add_WholesaleMargin]}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text="{Binding WholesaleProfitPercent, StringFormat='{}{0:N1}%'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 3. Carton Selling Price & Profit -->
                        <Border Grid.Column="4" Background="{DynamicResource BgDarkPrimary}" CornerRadius="10" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="14">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[Add_CartonSellPrice]}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6" />
                                <TextBox Style="{StaticResource ModernDarkTextBox}" Text="{Binding CartonSellingPrice, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0}'}" 
                                         GotFocus="NumberTextBox_GotFocus" TextAlignment="Center" FontSize="16" FontWeight="Black" Margin="0,0,0,10" />

                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Loc[Add_CartonProfitWhole]}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text="{Binding CartonProfitAmount, StringFormat='{}{0:N0} د.ع'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid>
                                    <TextBlock Text="{Binding Loc[Add_CartonMargin]}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text="{Binding CartonProfitPercent, StringFormat='{}{0:N1}%'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ======================================================== -->
        <!-- POPUP MODAL 1: INVENTORY LOOKUP / EDIT MODAL -->
        <!-- ======================================================== -->
        <Border Grid.RowSpan="3" Background="#DD000000" 
                Visibility="{Binding IsInventoryLookupOpen, Converter={StaticResource BoolToVis}}" 
                Margin="-24,-16">
            <Border Width="850" MaxHeight="600" Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Header & Close -->
                        <RowDefinition Height="Auto" />
                        <!-- Search Box -->
                        <RowDefinition Height="Auto" />
                        <!-- Items DataGrid -->
                        <RowDefinition Height="*" />
                        <!-- Bottom Action -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="📦 اختيار مادة من المخزن لتعديل بياناتها" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Command="{Binding CloseInventoryLookupCommand}" Cursor="Hand" Padding="4">
                            <TextBlock Text="✕" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" />
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <TextBox Style="{StaticResource ModernDarkTextBox}" Text="{Binding InventoryLookupSearchQuery, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="14" />
                    </Grid>

                    <Border Grid.Row="2" Background="{DynamicResource BgDarkPrimary}" CornerRadius="8" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="4" Height="360">
                        <DataGrid ItemsSource="{Binding InventoryLookupList}" AutoGenerateColumns="False" 
                                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  Background="Transparent" RowBackground="Transparent" BorderThickness="0"
                                  CanUserResizeColumns="False" CanUserReorderColumns="False" CanUserResizeRows="False" CanUserSortColumns="False"
                                  HorizontalGridLinesBrush="{DynamicResource BorderDark}"
                                  RowHeight="40">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الباركود" Binding="{Binding Barcode}" Width="130" Foreground="{DynamicResource PrimaryAccent}" />
                                <DataGridTextColumn Header="اسم المادة" Binding="{Binding Name}" Width="2*" Foreground="{DynamicResource TextPrimary}" />
                                <DataGridTextColumn Header="المندوب" Binding="{Binding SupplierName}" Width="120" Foreground="{DynamicResource TextSecondary}" />
                                <DataGridTextColumn Header="المخزون" Binding="{Binding StockQuantity, StringFormat='{}{0:N0}'}" Width="90" Foreground="{DynamicResource WarningBrush}" />
                                <DataGridTextColumn Header="سعر المفرد" Binding="{Binding Price, StringFormat='{}{0:N0} د.ع'}" Width="110" Foreground="{DynamicResource SuccessBrush}" />
                                <DataGridTemplateColumn Header="إجراء" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource PrimaryAccentButton}" 
                                                    Command="{Binding DataContext.SelectProductFromLookupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}" Padding="10,4" FontSize="11">
                                                <TextBlock Text="✏️ تعديل" />
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Button Grid.Row="3" Style="{StaticResource ActionButton}" Command="{Binding CloseInventoryLookupCommand}" Height="38" Margin="0,12,0,0">
                        <TextBlock Text="إغلاق النافذة" />
                    </Button>
                </Grid>
            </Border>
        </Border>

        <!-- ======================================================== -->
        <!-- POPUP MODAL 2: SUPPLIER DETAILS MODAL -->
        <!-- ======================================================== -->
        <Border Grid.RowSpan="3" Background="#DD000000" 
                Visibility="{Binding IsSupplierModalOpen, Converter={StaticResource BoolToVis}}" 
                Margin="-24,-16">
            <Border Width="500" Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="🤝 تفاصيل وبيانات المندوب / المورد" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Command="{Binding CloseSupplierModalCommand}" Cursor="Hand" Padding="4">
                            <TextBlock Text="✕" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" />
                        </Button>
                    </Grid>

                    <TextBlock Text="اسم المندوب / الشركة:" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource ModernDarkTextBox}" Text="{Binding SupplierName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                    <TextBlock Text="رقم هاتف المندوب:" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource ModernDarkTextBox}" Text="{Binding SupplierPhone, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                    <TextBlock Text="عنوان أو مكتب المندوب:" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource ModernDarkTextBox}" Text="{Binding SupplierAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                    <TextBlock Text="الرصيد المالي الحالي للمندوب (د.ع):" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource ModernDarkTextBox}" Text="{Binding SupplierBalance, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0}'}" 
                             GotFocus="NumberTextBox_GotFocus" TextAlignment="Center" Margin="0,0,0,18" />

                    <Button Style="{StaticResource PrimarySuccessButton}" Command="{Binding CloseSupplierModalCommand}" Height="40">
                        <TextBlock Text="✔ تأكيد وحفظ بيانات المندوب" FontWeight="Bold" />
                    </Button>
                </StackPanel>
            </Border>
        </Border>

        <!-- ======================================================== -->
        <!-- POPUP MODAL 3: ADD NEW CATEGORY MODAL -->
        <!-- ======================================================== -->
        <Border Grid.RowSpan="3" Background="#DD000000" 
                Visibility="{Binding IsAddCategoryModalOpen, Converter={StaticResource BoolToVis}}" 
                Margin="-24,-16">
            <Border Width="420" Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="{Binding Loc[Add_CategoryModalTitle]}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Command="{Binding CloseAddCategoryModalCommand}" Cursor="Hand" Padding="4">
                            <TextBlock Text="✕" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" />
                        </Button>
                    </Grid>

                    <TextBlock Text="{Binding Loc[Add_CategoryName]}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6" />
                    <TextBox Style="{StaticResource ModernDarkTextBox}" Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}" FontSize="14" FontWeight="Bold" Margin="0,0,0,18" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource PrimarySuccessButton}" Command="{Binding SaveNewCategoryCommand}" Height="40">
                            <TextBlock Text="{Binding Loc[Gen_Save]}" FontWeight="Bold" />
                        </Button>

                        <Button Grid.Column="2" Style="{StaticResource ActionButton}" Command="{Binding CloseAddCategoryModalCommand}" Height="40">
                            <TextBlock Text="{Binding Loc[Gen_Cancel]}" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
