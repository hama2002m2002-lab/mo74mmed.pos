                            <StackPanel Orientation="Horizontal">
                                <Border Background="#1E3A8A" CornerRadius="6" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Loc[Rep_Sales_WholesaleTag]}" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" />
                                </Border>
                                <TextBlock Text="{Binding Loc[Rep_Sales_WholesaleProfit]}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                            </StackPanel>
                            <TextBlock Text="{Binding WholesaleGrossProfit, StringFormat='{}{0:N0} د.ع'}" FontSize="20" FontWeight="Black" Foreground="#60A5FA" Margin="0,6,0,2" />
                            <TextBlock Text="{Binding Loc[Rep_Sales_WholesaleFormula]}" FontSize="10" Foreground="{DynamicResource TextMuted}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" BorderBrush="#F59E0B" BorderThickness="1.5" Padding="14" Margin="8,0,0,0">
