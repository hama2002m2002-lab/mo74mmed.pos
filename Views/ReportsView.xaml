                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="14" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc[Rep_Inv_CostValue]}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Text="{Binding TotalInventoryCostValue, StringFormat='{}{0:N0} د.ع'}" FontSize="18" FontWeight="Black" Foreground="{DynamicResource PrimaryAccent}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="14" Margin="3,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc[Rep_Inv_SellingValue]}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Text="{Binding TotalInventorySellingValue, StringFormat='{}{0:N0} د.ع'}" FontSize="18" FontWeight="Black" Foreground="{DynamicResource SuccessBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="14" Margin="3,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc[Rep_Inv_ExpectedProfit]}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Text="{Binding ExpectedInventoryProfit, StringFormat='{}{0:N0} د.ع'}" FontSize="18" FontWeight="Black" Foreground="#34D399" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="14" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc[Rep_Inv_OutOfStock]}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
