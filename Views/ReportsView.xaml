<UserControl x:Class="HamoPos.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1300"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <!-- 0: Header & Filter Bar -->
            <RowDefinition Height="Auto" />
            <!-- 1: Hub 9-Reports Grid or Full-Screen Report View -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- 0: TOP HEADER & DATE CONTROLS -->
        <!-- ======================================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Navigation Button: Back to Main in Hub View, OR Back to Reports Hub in Detail View -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Back to Main (When in Hub Mode) -->
                <Button Style="{StaticResource ActionButton}" Command="{Binding BackToMainCommand}" 
                        Visibility="{Binding IsHubViewActive, Converter={StaticResource BoolToVis}}"
                        Padding="14,8" Margin="0,0,14,0" ToolTip="العودة للرئيسية">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔙 " FontSize="14" />
                        <TextBlock Text="{Binding Loc[Nav_BackToMain]}" FontWeight="Bold" />
                    </StackPanel>
                </Button>

                <!-- Back to Reports Hub (When in Report Detail Full-Screen Mode) -->
                <Button Style="{StaticResource PrimaryAccentButton}" Command="{Binding BackToHubCommand}" 
                        Visibility="{Binding IsReportDetailActive, Converter={StaticResource BoolToVis}}"
                        Padding="16,8" Margin="0,0,14,0" ToolTip="العودة لقائمة التقارير">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔙 " FontSize="14" />
                        <TextBlock Text="{Binding Loc[Rep_BackToHub]}" FontWeight="Bold" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Title & Subtitle -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Loc[Rep_Title]}" FontSize="18" FontWeight="Black" Foreground="{DynamicResource TextPrimary}" />
                <TextBlock Text="{Binding Loc[Rep_Subtitle]}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
            </StackPanel>

            <!-- Period Preset Buttons & Custom DatePickers -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource ActionButton}" Command="{Binding FilterTodayCommand}" Padding="10,6" Margin="0,0,6,0">
                    <TextBlock Text="{Binding Loc[Rep_Today]}" FontWeight="Bold" />
                </Button>
                <Button Style="{StaticResource ActionButton}" Command="{Binding FilterThisMonthCommand}" Padding="10,6" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Loc[Rep_ThisMonth]}" FontWeight="Bold" />
                </Button>

                <TextBlock Text="{Binding Loc[Rep_From]}" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}" Width="130" Height="36" VerticalContentAlignment="Center" Margin="0,0,10,0" />

                <TextBlock Text="{Binding Loc[Rep_To]}" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}" Width="130" Height="36" VerticalContentAlignment="Center" Margin="0,0,12,0" />

                <Button Style="{StaticResource PrimaryAccentButton}" Command="{Binding RefreshCommand}" Padding="14,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔍 " FontSize="12" />
                        <TextBlock Text="{Binding Loc[Rep_Refresh]}" FontWeight="Bold" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ======================================================== -->
        <!-- 1: HUB VIEW (9 COMPACT INTERACTIVE REPORT BUTTONS/CARDS) -->
        <!-- ======================================================== -->
        <Grid Grid.Row="1" Visibility="{Binding IsHubViewActive, Converter={StaticResource BoolToVis}}" VerticalAlignment="Top" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Hero Master Report Button (التقرير المالي الشامل المتكامل) -->
            <Button Grid.Row="0" Grid.ColumnSpan="3" Command="{Binding SwitchReportTabCommand}" CommandParameter="Master" 
                    Height="80" Margin="0,0,0,16" Background="#0C1B33" BorderBrush="#38BDF8" BorderThickness="2" Cursor="Hand" Padding="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16" Padding="18,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                
                                <Border Grid.Column="0" Width="50" Height="50" Background="#0284C7" CornerRadius="12" Margin="0,0,14,0">
                                    <TextBlock Text="💎" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="التقرير المالي الشامل المتكامل (Master Report)" FontSize="17" FontWeight="Black" Foreground="#FFFFFF" />
                                        <Border Background="#059669" CornerRadius="6" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="كل التقارير في زر واحد 🌟" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="المبيعات، المرجوعات، الأرباح، الديون، تسجيل وإدارة المصروفات، واحتساب صافي الأرباح النهائي بدقة متناهية" FontSize="11.5" Foreground="#94A3B8" Margin="0,3,0,0" />
                                </StackPanel>

                                <Border Grid.Column="2" Background="#1E293B" CornerRadius="10" Padding="14,8" BorderBrush="#38BDF8" BorderThickness="1">
                                    <TextBlock Text="فتح التقرير الشامل ➔" FontSize="12.5" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Card 1: Sales & Net Profits -->
            <Button Grid.Row="1" Grid.Column="0" Command="{Binding SwitchReportTabCommand}" CommandParameter="Sales" 
                    Height="80" Margin="0,0,10,12" Background="{DynamicResource BgDarkSecondary}" BorderBrush="#10B981" BorderThickness="1.5" Cursor="Hand" Padding="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="14,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="44" Height="44" Background="#064E3B" CornerRadius="10" Margin="0,0,14,0">
                                    <TextBlock Text="📊" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding Loc[Rep_Tab_Sales]}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Card 2: Damaged Items -->
            <Button Grid.Row="1" Grid.Column="1" Command="{Binding SwitchReportTabCommand}" CommandParameter="Damaged" 
                    Height="80" Margin="5,0,5,12" Background="{DynamicResource BgDarkSecondary}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1.5" Cursor="Hand" Padding="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="14,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="44" Height="44" Background="#450A0A" CornerRadius="10" Margin="0,0,14,0">
                                    <TextBlock Text="⚠️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding Loc[Rep_Tab_Damaged]}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Card 3: Returns & Refunds -->
            <Button Grid.Row="1" Grid.Column="2" Command="{Binding SwitchReportTabCommand}" CommandParameter="Returns" 
                    Height="80" Margin="10,0,0,12" Background="{DynamicResource BgDarkSecondary}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1.5" Cursor="Hand" Padding="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="14,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="44" Height="44" Background="#78350F" CornerRadius="10" Margin="0,0,14,0">
                                    <TextBlock Text="🔄" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding Loc[Rep_Tab_Returns]}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Card 4: Purchases & Supplier Invoices -->
            <Button Grid.Row="2" Grid.Column="0" Command="{Binding SwitchReportTabCommand}" CommandParameter="Purchases" 
                    Height="80" Margin="0,0,10,12" Background="{DynamicResource BgDarkSecondary}" BorderBrush="{DynamicResource PrimaryAccent}" BorderThickness="1.5" Cursor="Hand" Padding="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="14,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="44" Height="44" Background="#1E3A8A" CornerRadius="10" Margin="0,0,14,0">
                                    <TextBlock Text="📦" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding Loc[Rep_Tab_Purchases]}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Card 5: Inventory Valuation -->
            <Button Grid.Row="2" Grid.Column="1" Command="{Binding SwitchReportTabCommand}" CommandParameter="Inventory" 
                    Height="80" Margin="5,0,5,12" Background="{DynamicResource BgDarkSecondary}" BorderBrush="#059669" BorderThickness="1.5" Cursor="Hand" Padding="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="14,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="44" Height="44" Background="#064E3B" CornerRadius="10" Margin="0,0,14,0">
                                    <TextBlock Text="🏢" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding Loc[Rep_Tab_Inventory]}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Card 6: Customer Debts -->
            <Button Grid.Row="2" Grid.Column="2" Command="{Binding SwitchReportTabCommand}" CommandParameter="Debts" 
                    Height="80" Margin="10,0,0,12" Background="{DynamicResource BgDarkSecondary}" BorderBrush="#D97706" BorderThickness="1.5" Cursor="Hand" Padding="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="14,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="44" Height="44" Background="#78350F" CornerRadius="10" Margin="0,0,14,0">
                                    <TextBlock Text="👥" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding Loc[Rep_Tab_Debts]}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Card 7: Shift Cash Audit & Handover -->
            <Button Grid.Row="3" Grid.Column="0" Command="{Binding SwitchReportTabCommand}" CommandParameter="ShiftAudit" 
                    Height="80" Margin="0,0,10,0" Background="{DynamicResource BgDarkSecondary}" BorderBrush="#F59E0B" BorderThickness="1.5" Cursor="Hand" Padding="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="14,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="44" Height="44" Background="#78350F" CornerRadius="10" Margin="0,0,14,0">
                                    <TextBlock Text="🔒" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding Loc[Rep_Tab_ShiftAudit]}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Card 8: Cashier Performance & Peak Hours -->
            <Button Grid.Row="3" Grid.Column="1" Command="{Binding SwitchReportTabCommand}" CommandParameter="Performance" 
                    Height="80" Margin="5,0,5,0" Background="{DynamicResource BgDarkSecondary}" BorderBrush="#8B5CF6" BorderThickness="1.5" Cursor="Hand" Padding="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="14,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="44" Height="44" Background="#4C1D95" CornerRadius="10" Margin="0,0,14,0">
                                    <TextBlock Text="⚡" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding Loc[Rep_Tab_Performance]}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Card 9: Product Velocity & Movement -->
            <Button Grid.Row="3" Grid.Column="2" Command="{Binding SwitchReportTabCommand}" CommandParameter="StockMovement" 
                    Height="80" Margin="10,0,0,0" Background="{DynamicResource BgDarkSecondary}" BorderBrush="#10B981" BorderThickness="1.5" Cursor="Hand" Padding="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="14,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="44" Height="44" Background="#064E3B" CornerRadius="10" Margin="0,0,14,0">
                                    <TextBlock Text="📈" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding Loc[Rep_Tab_StockMovement]}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- ======================================================== -->
        <!-- 2: FULL SCREEN DEDICATED REPORT WORKSPACE (SHOWN WHEN REPORT IS CLICKED) -->
        <!-- ======================================================== -->
        <Grid Grid.Row="1" Visibility="{Binding IsReportDetailActive, Converter={StaticResource BoolToVis}}">

            <!-- ======================================================== -->
            <!-- TAB 0: MASTER COMPREHENSIVE ALL-IN-ONE REPORT -->
            <!-- ======================================================== -->
            <Grid Visibility="{Binding IsMasterTabActive, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <!-- 0: Summary Financial Interactive KPI Cards (8 Metrics) -->
                    <RowDefinition Height="Auto" />
                    <!-- 1: Navigation Sub-Tabs Switcher (List of views) -->
                    <RowDefinition Height="Auto" />
                    <!-- 2: Active Sub-Section Dynamic Container -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Row 0: 7 Interactive KPI Cards + Final Net Profit -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.3*" />
                    </Grid.ColumnDefinitions>

                    <!-- 1: Sales (Clickable) -->
                    <Border Grid.Column="0" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="10,8" Margin="0,0,4,0" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SetMasterSubSectionCommand}" CommandParameter="Sales" />
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="💰 إجمالي المبيعات" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Text="{Binding TotalSalesRevenue, StringFormat='{}{0:N0} د.ع'}" FontSize="14.5" FontWeight="Black" Foreground="{DynamicResource SuccessBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 2: Returns (Clickable) -->
                    <Border Grid.Column="1" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="10,8" Margin="2,0" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SetMasterSubSectionCommand}" CommandParameter="Sales" />
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="🔄 المرجوعات" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Text="{Binding TotalReturnsAmount, StringFormat='{}{0:N0} د.ع'}" FontSize="14.5" FontWeight="Black" Foreground="{DynamicResource DangerBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 3: Expenses (Clickable) -->
                    <Border Grid.Column="2" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="10,8" Margin="2,0" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SetMasterSubSectionCommand}" CommandParameter="Expenses" />
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="📉 المصروفات" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Text="{Binding TotalExpensesAmount, StringFormat='{}{0:N0} د.ع'}" FontSize="14.5" FontWeight="Black" Foreground="#F87171" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 4: Damaged / Losses (Clickable) -->
                    <Border Grid.Column="3" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="10,8" Margin="2,0" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SetMasterSubSectionCommand}" CommandParameter="Damaged" />
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="⚠️ التالف والضرر" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Text="{Binding TotalDamagedLoss, StringFormat='{}{0:N0} د.ع'}" FontSize="14.5" FontWeight="Black" Foreground="#F59E0B" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 5: Out of Stock (Clickable) -->
                    <Border Grid.Column="4" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="10,8" Margin="2,0" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SetMasterSubSectionCommand}" CommandParameter="Inventory" />
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="📦 نفد المخزون" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Text="{Binding OutOfStockCount, StringFormat='{}{0} مادة 0'}" FontSize="14.5" FontWeight="Black" Foreground="#EF4444" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 6: Debts (Clickable) -->
                    <Border Grid.Column="5" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="10,8" Margin="2,0" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SetMasterSubSectionCommand}" CommandParameter="Debts" />
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="👥 ديون العملاء" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Text="{Binding NetOutstandingCustomerDebts, StringFormat='{}{0:N0} د.ع'}" FontSize="14.5" FontWeight="Black" Foreground="#38BDF8" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 7: Final Real Net Profit (Hero Badge) -->
                    <Border Grid.Column="6" Background="#064E3B" CornerRadius="12" BorderBrush="#10B981" BorderThickness="1.5" Padding="12,8" Margin="4,0,0,0">
                        <StackPanel>
                            <TextBlock Text="🏆 صافي الأرباح الحقيقي" FontSize="11" FontWeight="Bold" Foreground="#A7F3D0" />
                            <TextBlock Text="{Binding FinalNetProfit, StringFormat='{}{0:N0} د.ع'}" FontSize="17" FontWeight="Black" Foreground="#FFFFFF" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Row 1: Sub-Section Navigation Toolbar -->
                <Border Grid.Row="1" Background="{DynamicResource BgDarkSecondary}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="12" Padding="6" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Sub-Tab 1: Sales Invoices -->
                        <Button Grid.Column="0" Command="{Binding SetMasterSubSectionCommand}" CommandParameter="Sales" Height="36" Cursor="Hand" Margin="0,0,4,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="8" Padding="8,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMasterSalesSectionActive}" Value="True">
                                                        <Setter Property="Background" Value="#0284C7" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="💰 " FontSize="12" />
                                            <TextBlock Text="سجل وفواتير المبيعات" FontSize="12" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMasterSalesSectionActive}" Value="True">
                                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Sub-Tab 2: Expenses Management -->
                        <Button Grid.Column="1" Command="{Binding SetMasterSubSectionCommand}" CommandParameter="Expenses" Height="36" Cursor="Hand" Margin="2,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="8" Padding="8,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMasterExpensesSectionActive}" Value="True">
                                                        <Setter Property="Background" Value="#DC2626" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="💸 " FontSize="12" />
                                            <TextBlock Text="إدارة وتسجيل المصروفات" FontSize="12" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMasterExpensesSectionActive}" Value="True">
                                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Sub-Tab 3: Damaged Items & Total Loss -->
                        <Button Grid.Column="2" Command="{Binding SetMasterSubSectionCommand}" CommandParameter="Damaged" Height="36" Cursor="Hand" Margin="2,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="8" Padding="8,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMasterDamagedSectionActive}" Value="True">
                                                        <Setter Property="Background" Value="#D97706" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="⚠️ " FontSize="12" />
                                            <TextBlock Text="المواد التالفة والهالكة والضرر" FontSize="12" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMasterDamagedSectionActive}" Value="True">
                                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Sub-Tab 4: Inventory & Stock Status -->
                        <Button Grid.Column="3" Command="{Binding SetMasterSubSectionCommand}" CommandParameter="Inventory" Height="36" Cursor="Hand" Margin="2,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="8" Padding="8,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMasterInventorySectionActive}" Value="True">
                                                        <Setter Property="Background" Value="#059669" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="📦 " FontSize="12" />
                                            <TextBlock Text="المخزون والتوفر والنفاد" FontSize="12" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMasterInventorySectionActive}" Value="True">
                                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Sub-Tab 5: Customer Debts -->
                        <Button Grid.Column="4" Command="{Binding SetMasterSubSectionCommand}" CommandParameter="Debts" Height="36" Cursor="Hand" Margin="4,0,0,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="8" Padding="8,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMasterDebtsSectionActive}" Value="True">
                                                        <Setter Property="Background" Value="#7C3AED" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="👥 " FontSize="12" />
                                            <TextBlock Text="ديون ومستحقات العملاء" FontSize="12" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMasterDebtsSectionActive}" Value="True">
                                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Row 2: Sub-Section Body Views -->
                <Grid Grid.Row="2">
                    <!-- ============================================== -->
                    <!-- SECTION 1: SALES INVOICES (قائمة وسجل المبيعات) -->
                    <!-- ============================================== -->
                    <Border Visibility="{Binding IsMasterSalesSectionActive, Converter={StaticResource BoolToVis}}" 
                            Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="📑 قائمة وسجل كافة فواتير المبيعات" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border Background="#064E3B" CornerRadius="6" Padding="8,3" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding Invoices.Count, StringFormat='{}إجمالي الفواتير: {0}'}" FontSize="11.5" FontWeight="Bold" Foreground="#34D399" />
                                    </Border>
                                    <Border Background="#450A0A" CornerRadius="6" Padding="8,3">
                                        <TextBlock Text="{Binding TotalReturnsAmount, StringFormat='{}المرتجعات: {0:N0} د.ع'}" FontSize="11.5" FontWeight="Bold" Foreground="#FCA5A5" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Invoices}" AutoGenerateColumns="False" 
                                      IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      Background="Transparent" RowBackground="Transparent" BorderThickness="0"
                                      HorizontalGridLinesBrush="{DynamicResource BorderDark}"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto" RowHeight="38">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="رقم الوصل" Binding="{Binding InvoiceNumber}" Width="150" Foreground="{DynamicResource PrimaryAccent}" FontWeight="Bold" />
                                    <DataGridTextColumn Header="التاريخ والوقت" Binding="{Binding CreatedAt, StringFormat='{}{0:yyyy/MM/dd - hh:mm tt}'}" Width="170" Foreground="{DynamicResource TextSecondary}" />
                                    <DataGridTextColumn Header="طريقة الدفع" Binding="{Binding PaymentMethod}" Width="110" Foreground="{DynamicResource TextPrimary}" />
                                    <DataGridTextColumn Header="المجموع" Binding="{Binding TotalAmount, StringFormat='{}{0:N0} د.ع'}" Width="130" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" />
                                    <DataGridTextColumn Header="المواد والأصناف" Binding="{Binding Items.Count, StringFormat='{}{0} أصناف'}" Width="110" Foreground="{DynamicResource TextSecondary}" />
                                    <DataGridTemplateColumn Header="معاينة" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{DynamicResource ActionButton}" Command="{Binding DataContext.OpenInvoiceDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="8,3" FontSize="11">
                                                    <TextBlock Text="معاينة" />
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- ============================================== -->
                    <!-- SECTION 2: EXPENSES MANAGEMENT (إدارة وتسجيل المصروفات) -->
                    <!-- ============================================== -->
                    <Grid Visibility="{Binding IsMasterExpensesSectionActive, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <!-- Input Form -->
                            <ColumnDefinition Width="380" />
                            <!-- Expenses List Table -->
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Form -->
                        <Border Grid.Column="0" Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="14" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="💸 تسجيل مصروف جديد" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12" />

                                <!-- Title -->
                                <TextBlock Text="بيان ووصف المصروف (مثل: إيجار المحل، كهرباء...):" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding NewExpenseTitle, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,10" Background="{DynamicResource BgDarkPrimary}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderDark}" />

                                <!-- Amount -->
                                <TextBlock Text="المبلغ المالي (دينار عراقي):" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding NewExpenseAmount, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,10" Background="{DynamicResource BgDarkPrimary}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderDark}" />

                                <!-- Category ComboBox -->
                                <TextBlock Text="نوع وتصنيف المصروف:" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding ExpenseCategoriesList}" SelectedItem="{Binding NewExpenseCategory}" Height="34" Margin="0,0,0,10" Background="{DynamicResource BgDarkPrimary}" Foreground="{DynamicResource TextPrimary}" />

                                <!-- Notes -->
                                <TextBlock Text="ملاحظات وتفاصيل إضافية:" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding NewExpenseNotes, UpdateSourceTrigger=PropertyChanged}" Height="55" TextWrapping="Wrap" Padding="8,4" Margin="0,0,0,14" Background="{DynamicResource BgDarkPrimary}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderDark}" />

                                <!-- Save Button -->
                                <Button Command="{Binding SaveExpenseCommand}" Style="{DynamicResource PrimaryAccentButton}" Height="40">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="➕ " FontSize="13" />
                                        <TextBlock Text="حفظ وحسم المصروف من الأرباح" FontWeight="Bold" FontSize="12.5" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Right: Expenses DataGrid -->
                        <Border Grid.Column="1" Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="📋 سجل المصروفات المسجلة للفترة" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                    <Border HorizontalAlignment="Left" Background="#450A0A" CornerRadius="6" Padding="8,3">
                                        <TextBlock Text="{Binding TotalExpensesAmount, StringFormat='{}إجمالي المصروفات: {0:N0} د.ع'}" FontSize="12" FontWeight="Bold" Foreground="#FCA5A5" />
                                    </Border>
                                </Grid>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding ExpensesList}" AutoGenerateColumns="False" 
                                          IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          Background="Transparent" RowBackground="Transparent" BorderThickness="0"
                                          HorizontalGridLinesBrush="{DynamicResource BorderDark}"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto" RowHeight="38">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="بيان المصروف" Binding="{Binding Title}" Width="*" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" />
                                        <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat='{}{0:N0} د.ع'}" Width="130" Foreground="#F87171" FontWeight="Black" />
                                        <DataGridTextColumn Header="الفئة والتصنيف" Binding="{Binding Category}" Width="140" Foreground="{DynamicResource TextSecondary}" />
                                        <DataGridTextColumn Header="التاريخ والوقت" Binding="{Binding CreatedAt, StringFormat='{}{0:yyyy/MM/dd - hh:mm tt}'}" Width="160" Foreground="{DynamicResource TextSecondary}" />
                                        <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="140" Foreground="{DynamicResource TextSecondary}" />
                                        <DataGridTemplateColumn Header="إجراء" Width="60">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.DeleteExpenseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                            CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="حذف المصروف">
                                                        <TextBlock Text="🗑️" FontSize="13" />
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- SECTION 3: DAMAGED ITEMS & TOTAL LOSS (المواد التالفة والهالكة وكم الضرر) -->
                    <!-- ============================================== -->
                    <Border Visibility="{Binding IsMasterDamagedSectionActive, Converter={StaticResource BoolToVis}}" 
                            Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="⚠️ تقرير المواد التالفة والهالكة ومقدار الضرر والخسائر" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border Background="#450A0A" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding TotalDamagedLoss, StringFormat='{}إجمالي خسائر الضرر: {0:N0} د.ع'}" FontSize="12" FontWeight="Black" Foreground="#F87171" />
                                    </Border>
                                    <Border Background="#78350F" CornerRadius="6" Padding="10,4">
                                        <TextBlock Text="{Binding TotalDamagedItemsCount, StringFormat='{}عدد القطع المتضررة: {0}'}" FontSize="12" FontWeight="Bold" Foreground="#FCD34D" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding DamagedItemsList}" AutoGenerateColumns="False" 
                                      IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      Background="Transparent" RowBackground="Transparent" BorderThickness="0"
                                      HorizontalGridLinesBrush="{DynamicResource BorderDark}"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto" RowHeight="38">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="اسم المادة المتضررة" Binding="{Binding ProductName}" Width="*" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" />
                                    <DataGridTextColumn Header="الباركود" Binding="{Binding Barcode}" Width="130" Foreground="{DynamicResource PrimaryAccent}" />
                                    <DataGridTextColumn Header="الكمية التالفة" Binding="{Binding Quantity, StringFormat='{}{0:N0} قطعة'}" Width="100" Foreground="{DynamicResource TextSecondary}" />
                                    <DataGridTextColumn Header="تكلفة القطعة" Binding="{Binding UnitCost, StringFormat='{}{0:N0} د.ع'}" Width="110" Foreground="{DynamicResource TextSecondary}" />
                                    <DataGridTextColumn Header="إجمالي الخسارة" Binding="{Binding TotalLossAmount, StringFormat='{}{0:N0} د.ع'}" Width="130" Foreground="#F87171" FontWeight="Black" />
                                    <DataGridTextColumn Header="سبب التلف والضرر" Binding="{Binding Reason}" Width="160" Foreground="#FCA5A5" />
                                    <DataGridTextColumn Header="تاريخ التسجيل" Binding="{Binding CreatedAt, StringFormat='{}{0:yyyy/MM/dd - hh:mm tt}'}" Width="160" Foreground="{DynamicResource TextSecondary}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- ============================================== -->
                    <!-- SECTION 4: INVENTORY & STOCK STATUS (المخزون والمواد المتوفرة والنافذة) -->
                    <!-- ============================================== -->
                    <Border Visibility="{Binding IsMasterInventorySectionActive, Converter={StaticResource BoolToVis}}" 
                            Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="📦 تقرير المخزون وحالة المواد المتوفرة والنافذة" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border Background="#064E3B" CornerRadius="6" Padding="8,3" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding InStockCount, StringFormat='{}متوفر بكثرة: {0}'}" FontSize="11.5" FontWeight="Bold" Foreground="#34D399" />
                                    </Border>
                                    <Border Background="#78350F" CornerRadius="6" Padding="8,3" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding LowStockCount, StringFormat='{}يوشك على النفاد: {0}'}" FontSize="11.5" FontWeight="Bold" Foreground="#FCD34D" />
                                    </Border>
                                    <Border Background="#450A0A" CornerRadius="6" Padding="8,3">
                                        <TextBlock Text="{Binding OutOfStockCount, StringFormat='{}نفد المخزون: {0}'}" FontSize="11.5" FontWeight="Bold" Foreground="#F87171" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding InventoryValuationList}" AutoGenerateColumns="False" 
                                      IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      Background="Transparent" RowBackground="Transparent" BorderThickness="0"
                                      HorizontalGridLinesBrush="{DynamicResource BorderDark}"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto" RowHeight="38">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="الباركود" Binding="{Binding Barcode}" Width="130" Foreground="{DynamicResource PrimaryAccent}" />
                                    <DataGridTextColumn Header="اسم المادة" Binding="{Binding ProductName}" Width="*" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" />
                                    <DataGridTextColumn Header="الكمية المتوفرة" Binding="{Binding StockQuantity, StringFormat='{}{0:N0}'}" Width="110" Foreground="{DynamicResource TextPrimary}" FontWeight="Black" />
                                    <DataGridTextColumn Header="سعر التكلفة" Binding="{Binding UnitCost, StringFormat='{}{0:N0} د.ع'}" Width="110" Foreground="{DynamicResource TextSecondary}" />
                                    <DataGridTextColumn Header="سعر البيع" Binding="{Binding UnitPrice, StringFormat='{}{0:N0} د.ع'}" Width="110" Foreground="{DynamicResource SuccessBrush}" />
                                    <DataGridTextColumn Header="إجمالي قيمة المخزون" Binding="{Binding TotalCostValue, StringFormat='{}{0:N0} د.ع'}" Width="135" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" />
                                    <DataGridTemplateColumn Header="حالة المخزون" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="6" Padding="6,2" HorizontalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#064E3B" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StockQuantity}" Value="0">
                                                                    <Setter Property="Background" Value="#7F1D1D" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StockStatus}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- ============================================== -->
                    <!-- SECTION 5: CUSTOMER DEBTS (ديون ومستحقات العملاء) -->
                    <!-- ============================================== -->
                    <Border Visibility="{Binding IsMasterDebtsSectionActive, Converter={StaticResource BoolToVis}}" 
                            Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="👥 تقرير ديون ومستحقات العملاء والآجل" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                <Border HorizontalAlignment="Left" Background="#78350F" CornerRadius="6" Padding="8,3">
                                    <TextBlock Text="{Binding NetOutstandingCustomerDebts, StringFormat='{}إجمالي الديون المتبقية: {0:N0} د.ع'}" FontSize="12" FontWeight="Bold" Foreground="#FCD34D" />
                                </Border>
                            </Grid>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding CustomerDebtsList}" AutoGenerateColumns="False" 
                                      IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      Background="Transparent" RowBackground="Transparent" BorderThickness="0"
                                      HorizontalGridLinesBrush="{DynamicResource BorderDark}"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto" RowHeight="38">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="اسم العميل" Binding="{Binding CustomerName}" Width="*" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" />
                                    <DataGridTextColumn Header="رقم الهاتف" Binding="{Binding PhoneNumber}" Width="130" Foreground="{DynamicResource PrimaryAccent}" />
                                    <DataGridTextColumn Header="إجمالي الدين" Binding="{Binding TotalDebt, StringFormat='{}{0:N0} د.ع'}" Width="120" Foreground="#F87171" FontWeight="Bold" />
                                    <DataGridTextColumn Header="المسدد" Binding="{Binding TotalPaid, StringFormat='{}{0:N0} د.ع'}" Width="110" Foreground="{DynamicResource SuccessBrush}" />
                                    <DataGridTextColumn Header="المتبقي بذمته" Binding="{Binding RemainingDebt, StringFormat='{}{0:N0} د.ع'}" Width="120" Foreground="#FCD34D" FontWeight="Black" />
                                    <DataGridTextColumn Header="آخر حركة" Binding="{Binding LastTransactionType}" Width="140" Foreground="{DynamicResource TextSecondary}" />
                                    <DataGridTemplateColumn Header="إجراءات" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Style="{DynamicResource PrimarySuccessButton}" Command="{Binding DataContext.PayCustomerDebtCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="6,2" FontSize="11" Margin="0,0,4,0">
                                                        <TextBlock Text="تسديد" />
                                                    </Button>
                                                    <Button Style="{DynamicResource DangerButton}" Command="{Binding DataContext.DeleteCustomerDebtCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="6,2" FontSize="11">
                                                        <TextBlock Text="حذف" />
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ======================================================== -->
            <!-- TAB 1: SALES & NET PROFITS REPORT -->
            <!-- ======================================================== -->
            <Grid Visibility="{Binding IsSalesTabActive, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <!-- Profit Type Breakdown Cards -->
                    <RowDefinition Height="Auto" />
                    <!-- Net Profit Summary Bar -->
                    <RowDefinition Height="Auto" />
                    <!-- Full Width Invoices Table -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Profit Types Cards -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" BorderBrush="#10B981" BorderThickness="1.5" Padding="14" Margin="0,0,8,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#064E3B" CornerRadius="6" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Loc[Rep_Sales_SingleTag]}" FontSize="11" FontWeight="Bold" Foreground="#34D399" />
                                </Border>
                                <TextBlock Text="{Binding Loc[Rep_Sales_SingleProfit]}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                            </StackPanel>
                            <TextBlock Text="{Binding RetailGrossProfit, StringFormat='{}{0:N0} د.ع'}" FontSize="20" FontWeight="Black" Foreground="#34D399" Margin="0,6,0,2" />
