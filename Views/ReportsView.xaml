<UserControl x:Class="HamoPos.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1300"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <!-- 0: Header & Filter Bar -->
            <RowDefinition Height="Auto" />
            <!-- 1: Hub 9-Reports Grid or Full-Screen Report View -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- 0: TOP HEADER & DATE CONTROLS -->
        <!-- ======================================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Navigation Button: Back to Main in Hub View, OR Back to Reports Hub in Detail View -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Back to Main (When in Hub Mode) -->
                <Button Style="{StaticResource ActionButton}" Command="{Binding BackToMainCommand}" 
                        Visibility="{Binding IsHubViewActive, Converter={StaticResource BoolToVis}}"
                        Padding="14,8" Margin="0,0,14,0" ToolTip="العودة للرئيسية">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔙 " FontSize="14" />
                        <TextBlock Text="{Binding Loc[Nav_BackToMain]}" FontWeight="Bold" />
                    </StackPanel>
                </Button>

                <!-- Back to Reports Hub (When in Report Detail Full-Screen Mode) -->
                <Button Style="{StaticResource PrimaryAccentButton}" Command="{Binding BackToHubCommand}" 
                        Visibility="{Binding IsReportDetailActive, Converter={StaticResource BoolToVis}}"
                        Padding="16,8" Margin="0,0,14,0" ToolTip="العودة لقائمة التقارير">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔙 " FontSize="14" />
                        <TextBlock Text="{Binding Loc[Rep_BackToHub]}" FontWeight="Bold" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Title & Subtitle -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Loc[Rep_Title]}" FontSize="18" FontWeight="Black" Foreground="{DynamicResource TextPrimary}" />
                <TextBlock Text="{Binding Loc[Rep_Subtitle]}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
            </StackPanel>

            <!-- Period Preset Buttons & Custom DatePickers -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource ActionButton}" Command="{Binding FilterTodayCommand}" Padding="10,6" Margin="0,0,6,0">
                    <TextBlock Text="{Binding Loc[Rep_Today]}" FontWeight="Bold" />
                </Button>
                <Button Style="{StaticResource ActionButton}" Command="{Binding FilterThisMonthCommand}" Padding="10,6" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Loc[Rep_ThisMonth]}" FontWeight="Bold" />
                </Button>

                <TextBlock Text="{Binding Loc[Rep_From]}" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}" Width="130" Height="36" VerticalContentAlignment="Center" Margin="0,0,10,0" />

                <TextBlock Text="{Binding Loc[Rep_To]}" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}" Width="130" Height="36" VerticalContentAlignment="Center" Margin="0,0,12,0" />

                <Button Style="{StaticResource PrimaryAccentButton}" Command="{Binding RefreshCommand}" Padding="14,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔍 " FontSize="12" />
                        <TextBlock Text="{Binding Loc[Rep_Refresh]}" FontWeight="Bold" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ======================================================== -->
        <!-- 1: HUB VIEW (9 COMPACT INTERACTIVE REPORT BUTTONS/CARDS) -->
        <!-- ======================================================== -->
        <Grid Grid.Row="1" Visibility="{Binding IsHubViewActive, Converter={StaticResource BoolToVis}}" VerticalAlignment="Top" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: Sales & Net Profits -->
            <Button Grid.Row="0" Grid.Column="0" Command="{Binding SwitchReportTabCommand}" CommandParameter="Sales" 
                    Height="80" Margin="0,0,10,12" Background="{DynamicResource BgDarkSecondary}" BorderBrush="#10B981" BorderThickness="1.5" Cursor="Hand" Padding="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="14,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="44" Height="44" Background="#064E3B" CornerRadius="10" Margin="0,0,14,0">
                                    <TextBlock Text="📊" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding Loc[Rep_Tab_Sales]}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Card 2: Damaged Items -->
            <Button Grid.Row="0" Grid.Column="1" Command="{Binding SwitchReportTabCommand}" CommandParameter="Damaged" 
                    Height="80" Margin="5,0,5,12" Background="{DynamicResource BgDarkSecondary}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1.5" Cursor="Hand" Padding="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="14,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="44" Height="44" Background="#450A0A" CornerRadius="10" Margin="0,0,14,0">
                                    <TextBlock Text="⚠️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding Loc[Rep_Tab_Damaged]}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Card 3: Returns & Refunds -->
            <Button Grid.Row="0" Grid.Column="2" Command="{Binding SwitchReportTabCommand}" CommandParameter="Returns" 
                    Height="80" Margin="10,0,0,12" Background="{DynamicResource BgDarkSecondary}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1.5" Cursor="Hand" Padding="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="14,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="44" Height="44" Background="#78350F" CornerRadius="10" Margin="0,0,14,0">
                                    <TextBlock Text="🔄" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding Loc[Rep_Tab_Returns]}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Card 4: Purchases & Supplier Invoices -->
            <Button Grid.Row="1" Grid.Column="0" Command="{Binding SwitchReportTabCommand}" CommandParameter="Purchases" 
                    Height="80" Margin="0,0,10,12" Background="{DynamicResource BgDarkSecondary}" BorderBrush="{DynamicResource PrimaryAccent}" BorderThickness="1.5" Cursor="Hand" Padding="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="14,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="44" Height="44" Background="#1E3A8A" CornerRadius="10" Margin="0,0,14,0">
                                    <TextBlock Text="📦" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding Loc[Rep_Tab_Purchases]}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Card 5: Inventory Valuation -->
            <Button Grid.Row="1" Grid.Column="1" Command="{Binding SwitchReportTabCommand}" CommandParameter="Inventory" 
                    Height="80" Margin="5,0,5,12" Background="{DynamicResource BgDarkSecondary}" BorderBrush="#059669" BorderThickness="1.5" Cursor="Hand" Padding="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="14,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="44" Height="44" Background="#064E3B" CornerRadius="10" Margin="0,0,14,0">
                                    <TextBlock Text="🏢" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding Loc[Rep_Tab_Inventory]}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Card 6: Customer Debts -->
            <Button Grid.Row="1" Grid.Column="2" Command="{Binding SwitchReportTabCommand}" CommandParameter="Debts" 
                    Height="80" Margin="10,0,0,12" Background="{DynamicResource BgDarkSecondary}" BorderBrush="#D97706" BorderThickness="1.5" Cursor="Hand" Padding="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="14,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="44" Height="44" Background="#78350F" CornerRadius="10" Margin="0,0,14,0">
                                    <TextBlock Text="👥" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding Loc[Rep_Tab_Debts]}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Card 7: Shift Cash Audit & Handover -->
            <Button Grid.Row="2" Grid.Column="0" Command="{Binding SwitchReportTabCommand}" CommandParameter="ShiftAudit" 
                    Height="80" Margin="0,0,10,0" Background="{DynamicResource BgDarkSecondary}" BorderBrush="#F59E0B" BorderThickness="1.5" Cursor="Hand" Padding="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="14,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="44" Height="44" Background="#78350F" CornerRadius="10" Margin="0,0,14,0">
                                    <TextBlock Text="🔒" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding Loc[Rep_Tab_ShiftAudit]}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Card 8: Cashier Performance & Peak Hours -->
            <Button Grid.Row="2" Grid.Column="1" Command="{Binding SwitchReportTabCommand}" CommandParameter="Performance" 
                    Height="80" Margin="5,0,5,0" Background="{DynamicResource BgDarkSecondary}" BorderBrush="#8B5CF6" BorderThickness="1.5" Cursor="Hand" Padding="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="14,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="44" Height="44" Background="#4C1D95" CornerRadius="10" Margin="0,0,14,0">
                                    <TextBlock Text="⚡" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding Loc[Rep_Tab_Performance]}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Card 9: Product Velocity & Movement -->
            <Button Grid.Row="2" Grid.Column="2" Command="{Binding SwitchReportTabCommand}" CommandParameter="StockMovement" 
                    Height="80" Margin="10,0,0,0" Background="{DynamicResource BgDarkSecondary}" BorderBrush="#10B981" BorderThickness="1.5" Cursor="Hand" Padding="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="14,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="44" Height="44" Background="#064E3B" CornerRadius="10" Margin="0,0,14,0">
                                    <TextBlock Text="📈" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding Loc[Rep_Tab_StockMovement]}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- ======================================================== -->
        <!-- 2: FULL SCREEN DEDICATED REPORT WORKSPACE (SHOWN WHEN REPORT IS CLICKED) -->
        <!-- ======================================================== -->
        <Grid Grid.Row="1" Visibility="{Binding IsReportDetailActive, Converter={StaticResource BoolToVis}}">

            <!-- ======================================================== -->
            <!-- TAB 1: SALES & NET PROFITS REPORT -->
            <!-- ======================================================== -->
            <Grid Visibility="{Binding IsSalesTabActive, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <!-- Profit Type Breakdown Cards -->
                    <RowDefinition Height="Auto" />
                    <!-- Net Profit Summary Bar -->
                    <RowDefinition Height="Auto" />
                    <!-- Full Width Invoices Table -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Profit Types Cards -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" BorderBrush="#10B981" BorderThickness="1.5" Padding="14" Margin="0,0,8,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#064E3B" CornerRadius="6" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Loc[Rep_Sales_SingleTag]}" FontSize="11" FontWeight="Bold" Foreground="#34D399" />
                                </Border>
                                <TextBlock Text="{Binding Loc[Rep_Sales_SingleProfit]}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                            </StackPanel>
                            <TextBlock Text="{Binding RetailGrossProfit, StringFormat='{}{0:N0} د.ع'}" FontSize="20" FontWeight="Black" Foreground="#34D399" Margin="0,6,0,2" />
                            <TextBlock Text="{Binding Loc[Rep_Sales_SingleFormula]}" FontSize="10" Foreground="{DynamicResource TextMuted}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" BorderBrush="#3B82F6" BorderThickness="1.5" Padding="14" Margin="4,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#1E3A8A" CornerRadius="6" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Loc[Rep_Sales_WholesaleTag]}" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" />
                                </Border>
                                <TextBlock Text="{Binding Loc[Rep_Sales_WholesaleProfit]}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                            </StackPanel>
                            <TextBlock Text="{Binding WholesaleGrossProfit, StringFormat='{}{0:N0} د.ع'}" FontSize="20" FontWeight="Black" Foreground="#60A5FA" Margin="0,6,0,2" />
                            <TextBlock Text="{Binding Loc[Rep_Sales_WholesaleFormula]}" FontSize="10" Foreground="{DynamicResource TextMuted}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" BorderBrush="#F59E0B" BorderThickness="1.5" Padding="14" Margin="8,0,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#78350F" CornerRadius="6" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Loc[Rep_Sales_CartonTag]}" FontSize="11" FontWeight="Bold" Foreground="#FBBF24" />
                                </Border>
                                <TextBlock Text="{Binding Loc[Rep_Sales_CartonProfit]}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                            </StackPanel>
                            <TextBlock Text="{Binding CartonGrossProfit, StringFormat='{}{0:N0} د.ع'}" FontSize="20" FontWeight="Black" Foreground="#FBBF24" Margin="0,6,0,2" />
                            <TextBlock Text="{Binding Loc[Rep_Sales_CartonFormula]}" FontSize="10" Foreground="{DynamicResource TextMuted}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Net Profit Bar -->
                <Border Grid.Row="1" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="14,10" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1.3*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Loc[Rep_TotalSales]}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Text="{Binding TotalSalesRevenue, StringFormat='{}{0:N0} د.ع'}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,0" />
                        </StackPanel>

                        <Separator Grid.Column="1" Background="{DynamicResource BorderDark}" Margin="12,0" />

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding Loc[Rep_Sales_TotalGrossProfit]}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Text="{Binding TotalGrossSalesProfit, StringFormat='{}{0:N0} د.ع'}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}" Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <TextBlock Text="{Binding Loc[Rep_Sales_Discounts]}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Text="{Binding TotalDiscountsGranted, StringFormat='- {0:N0} د.ع'}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <Border Grid.Column="4" Background="#064E3B" CornerRadius="10" BorderBrush="#10B981" BorderThickness="1" Padding="12,6">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[Rep_Sales_NetProfit]}" FontSize="11" FontWeight="Bold" Foreground="#A7F3D0" />
                                <TextBlock Text="{Binding FinalNetProfit, StringFormat='{}{0:N0} د.ع'}" FontSize="19" FontWeight="Black" Foreground="#34D399" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Invoices Table -->
                <Border Grid.Row="2" Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="12">
                    <DataGrid ItemsSource="{Binding Invoices}" AutoGenerateColumns="False" 
                              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              Background="Transparent" RowBackground="Transparent" BorderThickness="0"
                              CanUserResizeColumns="False" CanUserReorderColumns="False" CanUserResizeRows="False" CanUserSortColumns="False"
                              HorizontalGridLinesBrush="{DynamicResource BorderDark}"
                              RowHeight="44">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{Binding Loc[Rep_InvoiceNo]}" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ActionButton}" 
                                                Command="{Binding DataContext.OpenInvoiceDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}" 
                                                Padding="10,4" HorizontalAlignment="Left" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🧾 " FontSize="13" />
                                                <TextBlock Text="{Binding InvoiceNumber}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="{Binding Loc[Rep_DateTime]}" Binding="{Binding CreatedAt, StringFormat='{}{0:yyyy/MM/dd - hh:mm tt}'}" Width="170" Foreground="{DynamicResource TextSecondary}" />
                            <DataGridTextColumn Header="{Binding Loc[Rep_SubTotal]}" Binding="{Binding SubTotal, StringFormat='{}{0:N0} د.ع'}" Width="130" Foreground="{DynamicResource TextSecondary}" />
                            <DataGridTextColumn Header="{Binding Loc[Rep_Discount]}" Binding="{Binding DiscountAmount, StringFormat='{}{0:N0} د.ع'}" Width="110" Foreground="{DynamicResource WarningBrush}" />
                            <DataGridTextColumn Header="{Binding Loc[Rep_GrandTotal]}" Binding="{Binding TotalAmount, StringFormat='{}{0:N0} د.ع'}" Width="140" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" />
                            
                            <DataGridTemplateColumn Header="{Binding Loc[Rep_InvoiceNetProfit]}" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" Background="#1A10B981" BorderBrush="#10B981" BorderThickness="1" Padding="10,4" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding InvoiceNetProfit, StringFormat='{}{0:N0} د.ع'}" FontSize="13" FontWeight="Black" Foreground="#34D399" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="{Binding Loc[Rep_Action]}" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource PrimaryAccentButton}" 
                                                Command="{Binding DataContext.OpenInvoiceDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}" 
                                                Padding="12,5" FontSize="12">
                                            <TextBlock Text="{Binding Loc[Rep_ViewInvoice]}" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- ======================================================== -->
            <!-- TAB 2: DAMAGED ITEMS REPORT -->
            <!-- ======================================================== -->
            <Grid Visibility="{Binding IsDamagedTabActive, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="14" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc[Rep_Damaged_TotalQty]}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Text="{Binding TotalDamagedItemsCount, StringFormat='{}{0:N0}'}" FontSize="20" FontWeight="Black" Foreground="{DynamicResource DangerBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="14" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc[Rep_Damaged_TotalLoss]}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Text="{Binding TotalDamagedLoss, StringFormat='{}{0:N0} د.ع'}" FontSize="20" FontWeight="Black" Foreground="{DynamicResource WarningBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="1" Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="12">
                    <DataGrid ItemsSource="{Binding DamagedItemsList}" AutoGenerateColumns="False" 
                              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              Background="Transparent" RowBackground="Transparent" BorderThickness="0"
                              CanUserResizeColumns="False" CanUserReorderColumns="False" CanUserResizeRows="False" CanUserSortColumns="False"
                              HorizontalGridLinesBrush="{DynamicResource BorderDark}" RowHeight="44">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding Loc[Rep_Damaged_Date]}" Binding="{Binding CreatedAt, StringFormat='{}{0:yyyy/MM/dd - hh:mm tt}'}" Width="160" Foreground="{DynamicResource TextSecondary}" />
