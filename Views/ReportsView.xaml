                            <TextBlock Text="{Binding Loc[Rep_Debts_TotalDue]}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Text="{Binding TotalCustomerDebtsDue, StringFormat='{}{0:N0} د.ع'}" FontSize="20" FontWeight="Black" Foreground="{DynamicResource DangerBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="14" Margin="4,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc[Rep_Debts_TotalCollected]}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Text="{Binding TotalCustomerDebtsCollected, StringFormat='{}{0:N0} د.ع'}" FontSize="20" FontWeight="Black" Foreground="{DynamicResource SuccessBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="14" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc[Rep_Debts_NetRemaining]}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Text="{Binding NetOutstandingCustomerDebts, StringFormat='{}{0:N0} د.ع'}" FontSize="20" FontWeight="Black" Foreground="{DynamicResource WarningBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Debts Grid + Quick Entry -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3.5*" />
                        <ColumnDefinition Width="6.5*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="18" Margin="0,0,16,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc[Rep_Debts_NewTitle]}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,12" />

                            <TextBlock Text="{Binding Loc[Rep_Debts_CustomerName]}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource ModernDarkTextBox}" Text="{Binding NewCustomerName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                            <TextBlock Text="{Binding Loc[Rep_Debts_Phone]}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource ModernDarkTextBox}" Text="{Binding NewCustomerPhone, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                            <TextBlock Text="{Binding Loc[Rep_Debts_Amount]}" FontSize="12" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource ModernDarkTextBox}" Text="{Binding NewCustomerDebtAmount, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0}'}" 
                                     FontSize="16" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,10" />

                            <TextBlock Text="{Binding Loc[Rep_Debts_Statement]}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource ModernDarkTextBox}" Text="{Binding NewCustomerNotes, UpdateSourceTrigger=PropertyChanged}" Height="50" Margin="0,0,0,16" />

                            <Button Style="{StaticResource PrimarySuccessButton}" Command="{Binding SaveCustomerDebtCommand}" Height="40">
                                <TextBlock Text="{Binding Loc[Rep_Debts_SaveBtn]}" FontWeight="Bold" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="12">
                        <DataGrid ItemsSource="{Binding CustomerDebtsList}" AutoGenerateColumns="False" 
                                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  Background="Transparent" RowBackground="Transparent" BorderThickness="0"
                                  CanUserResizeColumns="False" CanUserReorderColumns="False" CanUserResizeRows="False" CanUserSortColumns="False"
                                  HorizontalGridLinesBrush="{DynamicResource BorderDark}" RowHeight="44">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{Binding Loc[Rep_Debts_CustomerName]}" Binding="{Binding CustomerName}" Width="160" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" />
                                <DataGridTextColumn Header="{Binding Loc[Rep_Debts_Phone]}" Binding="{Binding PhoneNumber}" Width="120" Foreground="{DynamicResource TextSecondary}" />
                                <DataGridTextColumn Header="{Binding Loc[Rep_Debts_TotalDebtCol]}" Binding="{Binding TotalDebt, StringFormat='{}{0:N0} د.ع'}" Width="120" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" />
                                <DataGridTextColumn Header="{Binding Loc[Rep_Debts_PaidCol]}" Binding="{Binding TotalPaid, StringFormat='{}{0:N0} د.ع'}" Width="110" Foreground="{DynamicResource SuccessBrush}" />
                                <DataGridTextColumn Header="{Binding Loc[Rep_Debts_RemainingCol]}" Binding="{Binding RemainingBalance, StringFormat='{}{0:N0} د.ع'}" Width="120" Foreground="{DynamicResource WarningBrush}" FontWeight="Bold" />
                                <DataGridTemplateColumn Header="{Binding Loc[Rep_Action]}" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Style="{StaticResource PrimarySuccessButton}" 
                                                        Command="{Binding DataContext.PayCustomerDebtCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                        CommandParameter="{Binding}" Padding="6,3" FontSize="11" Margin="0,0,4,0">
                                                    <TextBlock Text="{Binding DataContext.Loc[Rep_Debts_PayBtn], RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                </Button>
                                                <Button Style="{StaticResource DangerButton}" 
                                                        Command="{Binding DataContext.DeleteCustomerDebtCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                        CommandParameter="{Binding}" Padding="6,3" FontSize="11">
                                                    <TextBlock Text="🗑" />
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ======================================================== -->
            <!-- TAB 7: SHIFT END CASH AUDIT & HANDOVER (Z-REPORT) -->
            <!-- ======================================================== -->
            <Grid Visibility="{Binding IsShiftAuditTabActive, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <!-- Form (40%) -->
                    <ColumnDefinition Width="4*" />
                    <!-- Shift Log Table (60%) -->
                    <ColumnDefinition Width="6*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="18" Margin="0,0,16,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc[Rep_Shift_Title]}" FontSize="15" FontWeight="Bold" Foreground="#FBBF24" Margin="0,0,0,12" />

                            <TextBlock Text="{Binding Loc[Rep_Shift_OpeningFloat]}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource ModernDarkTextBox}" Text="{Binding ShiftOpeningBalance, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0}'}" Margin="0,0,0,10" />

                            <TextBlock Text="{Binding Loc[Rep_Shift_SystemSales]}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding TotalSalesRevenue, StringFormat='{}{0:N0} د.ع'}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,0,10" />

                            <TextBlock Text="{Binding Loc[Rep_Shift_CountedCash]}" FontSize="12" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource ModernDarkTextBox}" Text="{Binding ShiftActualCashCount, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0}'}" 
                                     FontSize="18" FontWeight="Black" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,0,12" />

                            <!-- Discrepancy Box -->
                            <Border Background="{DynamicResource BgDarkPrimary}" CornerRadius="10" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="12" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="{Binding Loc[Rep_Shift_MatchResult]}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text="{Binding ShiftDiscrepancyStatus}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding Loc[Rep_Shift_ReceiverName]}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource ModernDarkTextBox}" Text="{Binding ShiftSupervisorName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                            <TextBlock Text="{Binding Loc[Rep_Shift_HandoverNotes]}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource ModernDarkTextBox}" Text="{Binding ShiftHandoverNotes, UpdateSourceTrigger=PropertyChanged}" Height="40" Margin="0,0,0,16" />

                            <Button Style="{StaticResource PrimarySuccessButton}" Command="{Binding SaveShiftAuditCommand}" Height="44">
                                <TextBlock Text="{Binding Loc[Rep_Shift_SubmitBtn]}" FontWeight="Bold" />
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="1" Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="12">
                    <DataGrid ItemsSource="{Binding ShiftAuditsList}" AutoGenerateColumns="False" 
                              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              Background="Transparent" RowBackground="Transparent" BorderThickness="0"
                              CanUserResizeColumns="False" CanUserReorderColumns="False" CanUserResizeRows="False" CanUserSortColumns="False"
                              HorizontalGridLinesBrush="{DynamicResource BorderDark}" RowHeight="44">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding Loc[Rep_Shift_CloseTime]}" Binding="{Binding CreatedAt, StringFormat='{}{0:yyyy/MM/dd - hh:mm tt}'}" Width="160" Foreground="{DynamicResource TextSecondary}" />
                            <DataGridTextColumn Header="{Binding Loc[Rep_Shift_Cashier]}" Binding="{Binding CashierName}" Width="120" Foreground="{DynamicResource TextPrimary}" />
                            <DataGridTextColumn Header="{Binding Loc[Rep_Shift_Expected]}" Binding="{Binding ExpectedCashInDrawer, StringFormat='{}{0:N0} د.ع'}" Width="130" Foreground="{DynamicResource PrimaryAccent}" />
                            <DataGridTextColumn Header="{Binding Loc[Rep_Shift_Counted]}" Binding="{Binding ActualCountedCash, StringFormat='{}{0:N0} د.ع'}" Width="130" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" />
                            <DataGridTextColumn Header="{Binding Loc[Rep_Shift_Diff]}" Binding="{Binding DiscrepancyStatus}" Width="140" Foreground="{DynamicResource WarningBrush}" FontWeight="Bold" />
                            <DataGridTextColumn Header="{Binding Loc[Rep_Shift_Receiver]}" Binding="{Binding SupervisorName}" Width="*" Foreground="{DynamicResource TextSecondary}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- ======================================================== -->
            <!-- TAB 8: CASHIER PERFORMANCE & PEAK HOURS REPORT -->
            <!-- ======================================================== -->
            <Grid Visibility="{Binding IsPerformanceTabActive, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <!-- KPI Peak Bar -->
                    <RowDefinition Height="Auto" />
                    <!-- Split: Peak Hours Table + Cashier Performance -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Loc[Rep_Perf_PeakBanner]}" FontSize="14" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding BusiestHourText}" FontSize="16" FontWeight="Black" Foreground="{DynamicResource WarningBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <!-- Peak Hours Intensity (50%) -->
                        <ColumnDefinition Width="*" />
                        <!-- Cashier Stats (50%) -->
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="12" Margin="0,0,8,0">
                        <DataGrid ItemsSource="{Binding HourlyPeakList}" AutoGenerateColumns="False" 
                                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  Background="Transparent" RowBackground="Transparent" BorderThickness="0"
                                  CanUserResizeColumns="False" CanUserReorderColumns="False" CanUserResizeRows="False" CanUserSortColumns="False"
                                  HorizontalGridLinesBrush="{DynamicResource BorderDark}" RowHeight="44">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{Binding Loc[Rep_Perf_HourSlot]}" Binding="{Binding HourLabel}" Width="150" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" />
                                <DataGridTextColumn Header="{Binding Loc[Rep_Perf_InvoicesCount]}" Binding="{Binding InvoicesCount, StringFormat='{}{0:N0}'}" Width="110" Foreground="{DynamicResource PrimaryAccent}" />
                                <DataGridTextColumn Header="{Binding Loc[Rep_Perf_TotalSales]}" Binding="{Binding TotalSales, StringFormat='{}{0:N0} د.ع'}" Width="130" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" />
                                <DataGridTextColumn Header="{Binding Loc[Rep_Perf_PeakLevel]}" Binding="{Binding PeakBadge}" Width="*" Foreground="{DynamicResource WarningBrush}" FontWeight="Bold" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Border Grid.Column="1" Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="12" Margin="8,0,0,0">
                        <DataGrid ItemsSource="{Binding CashierPerformanceList}" AutoGenerateColumns="False" 
                                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  Background="Transparent" RowBackground="Transparent" BorderThickness="0"
                                  CanUserResizeColumns="False" CanUserReorderColumns="False" CanUserResizeRows="False" CanUserSortColumns="False"
                                  HorizontalGridLinesBrush="{DynamicResource BorderDark}" RowHeight="44">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{Binding Loc[Rep_Perf_CashierName]}" Binding="{Binding CashierName}" Width="170" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" />
                                <DataGridTextColumn Header="{Binding Loc[Rep_Perf_CompletedInvoices]}" Binding="{Binding InvoicesCount, StringFormat='{}{0:N0}'}" Width="120" Foreground="{DynamicResource PrimaryAccent}" />
                                <DataGridTextColumn Header="{Binding Loc[Rep_Perf_TotalRevenue]}" Binding="{Binding TotalSalesAmount, StringFormat='{}{0:N0} د.ع'}" Width="130" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" />
                                <DataGridTextColumn Header="{Binding Loc[Rep_Perf_AvgSpeed]}" Binding="{Binding AvgSpeedText}" Width="*" Foreground="{DynamicResource SuccessBrush}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ======================================================== -->
            <!-- TAB 9: PRODUCT VELOCITY & STOCK MOVEMENT REPORT -->
            <!-- ======================================================== -->
            <Grid Visibility="{Binding IsStockMovementTabActive, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <!-- Fast Moving -->
                    <RowDefinition Height="*" />
                    <!-- Dead Stock -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Fast Moving (🔥 الأكثر مبيعاً) -->
                <Border Grid.Row="0" Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{Binding Loc[Rep_Mov_FastTitle]}" FontSize="14" FontWeight="Bold" Foreground="#34D399" Margin="4,0,0,8" />
                        <DataGrid Grid.Row="1" ItemsSource="{Binding FastMovingProducts}" AutoGenerateColumns="False" 
                                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  Background="Transparent" RowBackground="Transparent" BorderThickness="0"
                                  CanUserResizeColumns="False" CanUserReorderColumns="False" CanUserResizeRows="False" CanUserSortColumns="False"
                                  HorizontalGridLinesBrush="{DynamicResource BorderDark}" RowHeight="40">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{Binding Loc[Rep_Barcode]}" Binding="{Binding Barcode}" Width="130" Foreground="{DynamicResource PrimaryAccent}" />
                                <DataGridTextColumn Header="{Binding Loc[Rep_ProductName]}" Binding="{Binding ProductName}" Width="2*" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" />
                                <DataGridTextColumn Header="{Binding Loc[Rep_Mov_QtySold]}" Binding="{Binding QuantitySold, StringFormat='{}{0:N0}'}" Width="120" Foreground="{DynamicResource SuccessBrush}" FontWeight="Black" />
                                <DataGridTextColumn Header="{Binding Loc[Rep_Mov_Revenue]}" Binding="{Binding TotalRevenue, StringFormat='{}{0:N0} د.ع'}" Width="140" Foreground="{DynamicResource SuccessBrush}" />
                                <DataGridTextColumn Header="{Binding Loc[Rep_Mov_Remaining]}" Binding="{Binding CurrentStock, StringFormat='{}{0:N0}'}" Width="130" Foreground="{DynamicResource WarningBrush}" />
                                <DataGridTextColumn Header="{Binding Loc[Rep_Mov_Category]}" Binding="{Binding MovementCategory}" Width="*" Foreground="#34D399" FontWeight="Bold" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Dead Stock (❄️ البضائع الراكدة) -->
                <Border Grid.Row="1" Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{Binding Loc[Rep_Mov_DeadTitle]}" FontSize="14" FontWeight="Bold" Foreground="#60A5FA" Margin="4,0,0,8" />
                        <DataGrid Grid.Row="1" ItemsSource="{Binding DeadStockProducts}" AutoGenerateColumns="False" 
                                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  Background="Transparent" RowBackground="Transparent" BorderThickness="0"
                                  CanUserResizeColumns="False" CanUserReorderColumns="False" CanUserResizeRows="False" CanUserSortColumns="False"
                                  HorizontalGridLinesBrush="{DynamicResource BorderDark}" RowHeight="40">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{Binding Loc[Rep_Barcode]}" Binding="{Binding Barcode}" Width="130" Foreground="{DynamicResource PrimaryAccent}" />
                                <DataGridTextColumn Header="{Binding Loc[Rep_ProductName]}" Binding="{Binding ProductName}" Width="2*" Foreground="{DynamicResource TextPrimary}" />
                                <DataGridTextColumn Header="{Binding Loc[Rep_Mov_PeriodSales]}" Binding="{Binding QuantitySold, StringFormat='{}{0:N0}'}" Width="120" Foreground="{DynamicResource DangerBrush}" />
                                <DataGridTextColumn Header="{Binding Loc[Rep_Mov_Remaining]}" Binding="{Binding CurrentStock, StringFormat='{}{0:N0}'}" Width="160" Foreground="{DynamicResource WarningBrush}" FontWeight="Bold" />
                                <DataGridTextColumn Header="{Binding Loc[Rep_Mov_Category]}" Binding="{Binding MovementCategory}" Width="*" Foreground="#60A5FA" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

        </Grid>

        <!-- ======================================================== -->
        <!-- POPUP MODAL: FULL INVOICE RECEIPT DETAILS MODAL -->
        <!-- ======================================================== -->
        <Border Grid.RowSpan="3" Background="#DD000000" 
                Visibility="{Binding IsInvoiceDetailsModalOpen, Converter={StaticResource BoolToVis}}" 
                Margin="-20,-16">
            <Border Width="650" MaxHeight="700" Background="{DynamicResource BgDarkSecondary}" CornerRadius="16" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Loc[Rep_Modal_InvoiceDetails]}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="{Binding SelectedInvoiceForDetails.InvoiceNumber}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}" Margin="8,0,0,0" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Command="{Binding CloseInvoiceDetailsCommand}" Cursor="Hand" Padding="4">
                            <TextBlock Text="✕" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" />
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" Background="{DynamicResource BgDarkPrimary}" CornerRadius="10" Padding="12" Margin="0,0,0,14" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Loc[Rep_Modal_SaleDate]}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="{Binding SelectedInvoiceForDetails.CreatedAt, StringFormat='{}{0:yyyy/MM/dd - hh:mm tt}'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Loc[Rep_Modal_PayMethod]}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="{Binding SelectedInvoiceForDetails.PaymentMethod}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding Loc[Rep_Modal_InvoiceStatus]}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="{Binding SelectedInvoiceForDetails.Status}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Background="{DynamicResource BgDarkPrimary}" CornerRadius="10" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="4" MaxHeight="320">
                        <DataGrid ItemsSource="{Binding SelectedInvoiceForDetails.Items}" AutoGenerateColumns="False" 
                                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  Background="Transparent" RowBackground="Transparent" BorderThickness="0"
                                  CanUserResizeColumns="False" CanUserReorderColumns="False" CanUserResizeRows="False" CanUserSortColumns="False"
                                  HorizontalGridLinesBrush="{DynamicResource BorderDark}"
                                  RowHeight="40">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{Binding Loc[Rep_Modal_Item]}" Binding="{Binding ProductName}" Width="2*" Foreground="{DynamicResource TextPrimary}" />
                                <DataGridTextColumn Header="{Binding Loc[Rep_Modal_UnitPrice]}" Binding="{Binding UnitPrice, StringFormat='{}{0:N0} د.ع'}" Width="120" Foreground="{DynamicResource TextSecondary}" />
                                <DataGridTextColumn Header="{Binding Loc[Rep_Modal_Quantity]}" Binding="{Binding Quantity, StringFormat='{}{0:N0}'}" Width="70" Foreground="{DynamicResource WarningBrush}" />
                                <DataGridTextColumn Header="{Binding Loc[Rep_Modal_Total]}" Binding="{Binding TotalPrice, StringFormat='{}{0:N0} د.ع'}" Width="120" Foreground="{DynamicResource SuccessBrush}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Grid Grid.Row="3" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Loc[Rep_Modal_PaidTotal]}" FontSize="14" Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="{Binding SelectedInvoiceForDetails.TotalAmount, StringFormat='{}{0:N0} د.ع'}" FontSize="18" FontWeight="Black" Foreground="{DynamicResource SuccessBrush}" Margin="6,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding Loc[Rep_Modal_Discount]}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="{Binding SelectedInvoiceForDetails.DiscountAmount, StringFormat='{}{0:N0} د.ع'}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" Margin="4,0,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="1" Style="{StaticResource ActionButton}" Command="{Binding CloseInvoiceDetailsCommand}" Padding="20,10" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Loc[Rep_Modal_Close]}" FontWeight="Bold" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
