<UserControl x:Class="HamoPos.Views.UserAccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="950" d:DesignWidth="1200"
             FlowDirection="RightToLeft"
             FontFamily="Times New Roman, Segoe UI, Tahoma, Arial">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <!-- 0: Header & Navigation Bar -->
            <RowDefinition Height="Auto" />
            <!-- 1: Top Cashier & Date Filter Bar -->
            <RowDefinition Height="Auto" />
            <!-- 2: Top 4 Financial KPI Cards (مبيعات، مرجوعات، صافي، أرباح) -->
            <RowDefinition Height="Auto" />
            <!-- 3: Dynamic Content (Cards Grid OR Cashier Details & Sales) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- 0: TOP HEADER BAR -->
        <!-- ======================================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="👤 " FontSize="22" />
                <TextBlock Text="إدارة وحسابات الكاشير والمبيعات اليومية" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- Search Box -->
                <TextBox Style="{StaticResource ModernDarkTextBox}" 
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                         Width="220" Padding="10,6" FontSize="13" Margin="0,0,10,0"
                         Visibility="{Binding IsCardsGridActive, Converter={StaticResource BoolToVis}}" 
                         ToolTip="ابحث باسم الكاشير أو اسم المستخدم..." />

                <!-- Add New Cashier Button -->
                <Button Style="{StaticResource PrimarySuccessButton}" Command="{Binding OpenAddUserModalCommand}" Padding="16,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="➕ " FontSize="13" />
                        <TextBlock Text="إنشاء حساب كاشير جديد" FontWeight="Bold" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ======================================================== -->
        <!-- 1: TOP CASHIER & DATE FILTER BAR (اختيار الكاشير والتاريخ) -->
        <!-- ======================================================== -->
        <Border Grid.Row="1" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Cashier Selector -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Date Presets -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Cashier Filter ComboBox (اختيار كاشير معين أو الكل) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="👤 اختيار الكاشير:" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding CashierFilterOptions}" 
                              SelectedItem="{Binding SelectedCashierFilter}" 
                              DisplayMemberPath="DisplayName"
                              Width="260" Height="36" 
                              Background="{DynamicResource BgDarkPrimary}" 
                              Foreground="{DynamicResource TextPrimary}" 
                              FontSize="13" />
                </StackPanel>

                <!-- Date Range & Preset Filter (اختيار اليوم / التاريخ) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="📅 الفترة:" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,8,0" />

                    <!-- Quick Preset Buttons -->
                    <Button Style="{StaticResource ActionButton}" Command="{Binding SetTodaySummaryCommand}" Padding="12,5" Margin="0,0,6,0">
                        <TextBlock Text="اليوم" FontWeight="Bold" />
                    </Button>
                    <Button Style="{StaticResource ActionButton}" Command="{Binding SetYesterdaySummaryCommand}" Padding="12,5" Margin="0,0,6,0">
                        <TextBlock Text="أمس" FontWeight="SemiBold" />
                    </Button>
                    <Button Style="{StaticResource PrimaryAccentButton}" Command="{Binding SetAllSummaryCommand}" Padding="14,5" Margin="0,0,14,0">
                        <TextBlock Text="الكل" FontWeight="Bold" />
                    </Button>

                    <!-- DatePickers -->
                    <TextBlock Text="من:" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <DatePicker SelectedDate="{Binding SummaryDateFrom, Mode=TwoWay}" Width="125" Height="32" Margin="0,0,8,0" />
                    <TextBlock Text="إلى:" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <DatePicker SelectedDate="{Binding SummaryDateTo, Mode=TwoWay}" Width="125" Height="32" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- 2: TOP 4 FINANCIAL KPI CARDS (المبيعات، المرجوعات، الصافي، الأرباح) -->
        <!-- ======================================================== -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 1: Total Sales (إجمالي المبيعات) -->
            <Border Grid.Column="0" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" BorderBrush="{DynamicResource PrimaryAccent}" BorderThickness="1.5" Padding="14,12" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="💰 إجمالي المبيعات" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding TopTotalSales, StringFormat='{}{0:N0}'}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource PrimaryAccent}" />
                        <TextBlock Text=" د.ع" FontSize="12" Foreground="{DynamicResource PrimaryAccent}" VerticalAlignment="Bottom" Margin="3,0,0,2" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="{Binding TopInvoicesCount, StringFormat='{}عدد الفواتير: {0:N0}'}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0" />
                </Grid>
            </Border>

            <!-- 2: Total Returns (إجمالي المرجوعات) -->
            <Border Grid.Column="1" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1.5" Padding="14,12" Margin="4,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="🔄 إجمالي المرجوعات" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding TopTotalReturns, StringFormat='{}{0:N0}'}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource DangerBrush}" />
                        <TextBlock Text=" د.ع" FontSize="12" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Bottom" Margin="3,0,0,2" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="{Binding TopReturnedCount, StringFormat='{}الفواتير المسترجعة: {0:N0}'}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0" />
                </Grid>
            </Border>

            <!-- 3: Net Sales (صافي المبيعات) -->
            <Border Grid.Column="2" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1.5" Padding="14,12" Margin="4,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="📊 صافي المبيعات (البيع - المرتجع)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding TopNetSales, StringFormat='{}{0:N0}'}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource WarningBrush}" />
                        <TextBlock Text=" د.ع" FontSize="12" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Bottom" Margin="3,0,0,2" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="المبلغ الصافي الفعلي" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0" />
                </Grid>
            </Border>

            <!-- 4: Net Profit (أرباح صافي) -->
            <Border Grid.Column="3" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1.5" Padding="14,12" Margin="4,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="📈 صافي الأرباح المحققة" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding TopNetProfit, StringFormat='{}{0:N0}'}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource SuccessBrush}" />
                        <TextBlock Text=" د.ع" FontSize="12" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Bottom" Margin="3,0,0,2" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="بعد خصم تكاليف الشراء" FontSize="11" Foreground="{DynamicResource SuccessBrush}" Margin="0,2,0,0" />
                </Grid>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- 3: VIEW A - CASHIERS CARDS GRID (مربعات الكاشير) -->
        <!-- ======================================================== -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsCardsGridActive, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding CashierCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Cashier Card Box -->
                        <Border Width="360" Margin="0,0,16,16" Background="{DynamicResource BgDarkSecondary}" 
                                CornerRadius="16" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" 
                                Padding="16" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenCashierDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            </Border.InputBindings>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccent}" />
                                            <Setter Property="Background" Value="#1E293B" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <!-- Header: Avatar + Name + Status -->
                                    <RowDefinition Height="Auto" />
                                    <!-- Divider -->
                                    <RowDefinition Height="Auto" />
                                    <!-- KPI Stats (Sales / Returns / Profit) -->
                                    <RowDefinition Height="Auto" />
                                    <!-- Actions -->
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Avatar -->
                                    <Border Grid.Column="0" Width="48" Height="48" Background="#1E3A8A" CornerRadius="24" Margin="0,0,12,0" BorderBrush="{DynamicResource PrimaryAccent}" BorderThickness="1.5">
                                        <TextBlock Text="👤" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                                    </Border>

                                    <!-- Name & Role -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FullName}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="@" FontSize="12" Foreground="{DynamicResource PrimaryAccent}" />
                                            <TextBlock Text="{Binding Username}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryAccent}" Margin="0,0,8,0" />
                                            <Border Background="#334155" CornerRadius="4" Padding="6,1">
                                                <TextBlock Text="{Binding RoleDisplayName}" FontSize="10" Foreground="#E2E8F0" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Status Pill -->
                                    <Border Grid.Column="2" CornerRadius="8" Padding="8,4" VerticalAlignment="Top">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#064E3B" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                        <Setter Property="Background" Value="#450A0A" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="10" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="نشط ✔" />
                                                    <Setter Property="Foreground" Value="#34D399" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Text" Value="معطل ✕" />
                                                            <Setter Property="Foreground" Value="#F87171" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>

                                <Separator Grid.Row="1" Background="{DynamicResource BorderDark}" Margin="0,10,0,10" />

                                <!-- KPI Summary Grid for this cashier in selected period -->
                                <Grid Grid.Row="2" Margin="0,0,0,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Invoices Count -->
                                    <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource BgDarkPrimary}" CornerRadius="8" Padding="8,6" Margin="0,0,4,6" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="الفواتير" FontSize="10" Foreground="{DynamicResource TextSecondary}" />
                                            <TextBlock Text="{Binding TotalInvoicesCount, StringFormat='{}{0:N0} وصل'}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Sales Amount -->
                                    <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource BgDarkPrimary}" CornerRadius="8" Padding="8,6" Margin="4,0,0,6" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="المبيعات" FontSize="10" Foreground="{DynamicResource TextSecondary}" />
                                            <TextBlock Text="{Binding TodaySalesAmount, StringFormat='{}{0:N0} د.ع'}" FontSize="13" FontWeight="Black" Foreground="{DynamicResource SuccessBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Returns Amount -->
                                    <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource BgDarkPrimary}" CornerRadius="8" Padding="8,6" Margin="0,0,4,0" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="المرجوعات" FontSize="10" Foreground="{DynamicResource TextSecondary}" />
                                            <TextBlock Text="{Binding TodayReturnsAmount, StringFormat='{}{0:N0} د.ع'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Net Profit -->
                                    <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource BgDarkPrimary}" CornerRadius="8" Padding="8,6" Margin="4,0,0,0" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="صافي الأرباح" FontSize="10" Foreground="{DynamicResource TextSecondary}" />
                                            <TextBlock Text="{Binding TodayNetProfit, StringFormat='{}{0:N0} د.ع'}" FontSize="12" FontWeight="Black" Foreground="{DynamicResource WarningBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Card Action Buttons -->
                                <Grid Grid.Row="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Style="{StaticResource PrimaryAccentButton}" 
                                            Command="{Binding DataContext.OpenCashierDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" Padding="8,6" FontSize="11" Margin="0,0,4,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="👁 " FontSize="11" />
                                            <TextBlock Text="عرض المبيعات" FontWeight="Bold" />
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Column="1" Style="{StaticResource ActionButton}" 
                                            Command="{Binding DataContext.OpenEditUserModalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" Padding="6,6" FontSize="11" Margin="0,0,4,0">
                                        <TextBlock Text="✏️ تعديل" />
                                    </Button>

                                    <Button Grid.Column="2" Style="{StaticResource DangerButton}" 
                                            Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" Padding="6,6" FontSize="11">
                                        <TextBlock Text="🗑 حذف" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ======================================================== -->
        <!-- 3: VIEW B - CASHIER DETAILS & SALES DRILLDOWN (FULL HEIGHT) -->
        <!-- ======================================================== -->
        <Grid Grid.Row="3" Visibility="{Binding IsDetailsActive, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <!-- Top Profile Bar -->
                <RowDefinition Height="Auto" />
                <!-- Full Height Sales History DataGrid -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Profile Card -->
            <Border Grid.Row="0" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="14,10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource ActionButton}" Command="{Binding BackToCardsGridCommand}" Padding="12,6" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔙 " FontSize="12" />
                            <TextBlock Text="العودة لكافة الكاشير" FontWeight="Bold" />
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="38" Height="38" Background="#1E3A8A" CornerRadius="19" Margin="0,0,10,0">
                            <TextBlock Text="👤" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedCashier.FullName}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                <Border Background="#334155" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding SelectedCashier.RoleDisplayName}" FontSize="10.5" Foreground="#93C5FD" FontWeight="Bold" />
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="اسم الدخول: @" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="{Binding SelectedCashier.Username}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ActionButton}" Command="{Binding OpenEditUserModalCommand}" CommandParameter="{Binding SelectedCashier}" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✏️ " FontSize="12" />
                                <TextBlock Text="تعديل الحساب" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Sales Invoices Table (Expanded Full Height with Scroll) -->
            <Border Grid.Row="1" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="📑 قائمة وسجل كافة مبيعات ومرتجعات هذا الكاشير" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                        <Border Background="#064E3B" CornerRadius="6" Padding="10,4" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding CashierSalesHistory.Count, StringFormat='{}إجمالي العمليات: {0}'}" FontSize="11.5" FontWeight="Bold" Foreground="#34D399" />
                        </Border>
                    </Grid>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding CashierSalesHistory}" AutoGenerateColumns="False" 
                              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              Background="Transparent" RowBackground="Transparent" BorderThickness="0"
                              CanUserResizeColumns="False" CanUserReorderColumns="False" CanUserResizeRows="False" CanUserSortColumns="False"
                              HorizontalGridLinesBrush="{DynamicResource BorderDark}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              RowHeight="42">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding InvoiceNumber}" Width="150" Foreground="{DynamicResource PrimaryAccent}" FontWeight="Bold" FontSize="12.5" />
                            <DataGridTextColumn Header="التاريخ والوقت" Binding="{Binding CreatedAt, StringFormat='{}{0:yyyy/MM/dd - hh:mm tt}'}" Width="170" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                            <DataGridTextColumn Header="طريقة الدفع" Binding="{Binding PaymentMethod}" Width="110" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" FontSize="12" />
                            <DataGridTextColumn Header="الخصم الممنوح" Binding="{Binding DiscountAmount, StringFormat='{}{0:N0} د.ع'}" Width="110" Foreground="{DynamicResource WarningBrush}" FontSize="12" />
                            
                            <!-- Amount Column with dynamic styling -->
                            <DataGridTemplateColumn Header="المبلغ الإجمالي" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TotalAmount, StringFormat='{}{0:N0} د.ع'}" FontWeight="Black" FontSize="13.5" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Returned">
                                                            <Setter Property="Foreground" Value="#F87171" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Status Badge Column -->
                            <DataGridTemplateColumn Header="حالة الفاتورة" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="8,3" HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#064E3B" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Returned">
                                                            <Setter Property="Background" Value="#450A0A" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="بيع مكتمل ✔" />
                                                        <Setter Property="Foreground" Value="#34D399" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Returned">
                                                                <Setter Property="Text" Value="مرتجع 🔄" />
                                                                <Setter Property="Foreground" Value="#F87171" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <!-- View Invoice Items Action -->
                            <DataGridTemplateColumn Header="تفاصيل الفاتورة" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource PrimaryAccentButton}" 
                                                Command="{Binding DataContext.OpenSaleItemsModalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}" Padding="10,4" FontSize="11" HorizontalAlignment="Center">
                                            <TextBlock Text="👁 عرض المواد" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- POPUP MODAL 1: ADD / EDIT CASHIER ACCOUNT -->
        <!-- ======================================================== -->
        <Border Grid.RowSpan="4" Background="#DD000000" 
                Visibility="{Binding IsAddEditModalOpen, Converter={StaticResource BoolToVis}}" 
                Margin="-20,-16">
            <Border Width="480" Background="{DynamicResource BgDarkSecondary}" CornerRadius="16" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <!-- Modal Header -->
                    <Grid Margin="0,0,0,18">
                        <TextBlock Text="{Binding ModalTitle}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Command="{Binding CloseAddEditModalCommand}" Cursor="Hand" Padding="4">
                            <TextBlock Text="✕" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" />
                        </Button>
                    </Grid>

                    <!-- Full Name -->
                    <TextBlock Text="الاسم الكامل للكاشير / الموظف:" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6" />
                    <TextBox Style="{StaticResource ModernDarkTextBox}" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="14" Margin="0,0,0,12" />

                    <!-- Username -->
                    <TextBlock Text="اسم الدخول (Username):" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6" />
                    <TextBox Style="{StaticResource ModernDarkTextBox}" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="14" Margin="0,0,0,12" />

                    <!-- Password / PIN -->
                    <TextBlock Text="الرمز السري / كلمة المرور (PIN):" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6" />
                    <TextBox Style="{StaticResource ModernDarkTextBox}" Text="{Binding PinPassword, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="14" Margin="0,0,0,12" />

                    <!-- Role -->
                    <TextBlock Text="الصلاحية / الدور:" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6" />
                    <ComboBox SelectedValue="{Binding Role, Mode=TwoWay}" SelectedValuePath="Content" Height="38" Background="{DynamicResource BgDarkPrimary}" Foreground="{DynamicResource TextPrimary}" FontSize="13" Margin="0,0,0,14">
                        <ComboBoxItem Content="Cashier" />
                        <ComboBoxItem Content="Admin" />
                        <ComboBoxItem Content="Manager" />
                    </ComboBox>

                    <!-- Active Toggle -->
                    <CheckBox IsChecked="{Binding IsActive}" Content="الحساب نشط ومفعل" Foreground="{DynamicResource TextPrimary}" FontSize="13" Margin="0,0,0,20" />

                    <!-- Save & Cancel Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource PrimarySuccessButton}" Command="{Binding SaveUserCommand}" Height="42" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💾 " FontSize="14" />
                                <TextBlock Text="حفظ الحساب" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Style="{StaticResource ActionButton}" Command="{Binding CloseAddEditModalCommand}" Height="42" Margin="6,0,0,0">
                            <TextBlock Text="إلغاء" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- ======================================================== -->
        <!-- POPUP MODAL 2: INVOICE ITEMS DETAILS -->
        <!-- ======================================================== -->
        <Border Grid.RowSpan="4" Background="#DD000000" 
                Visibility="{Binding IsInvoiceItemsModalOpen, Converter={StaticResource BoolToVis}}" 
                Margin="-20,-16">
            <Border Width="650" Background="{DynamicResource BgDarkSecondary}" CornerRadius="16" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🧾 " FontSize="20" />
                            <TextBlock Text="{Binding SelectedSale.InvoiceNumber, StringFormat='محتويات الفاتورة: {0}'}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Command="{Binding CloseSaleItemsModalCommand}" Cursor="Hand" Padding="4">
                            <TextBlock Text="✕" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" />
                        </Button>
                    </Grid>

                    <!-- Items List -->
                    <Border Grid.Row="1" Background="{DynamicResource BgDarkPrimary}" CornerRadius="8" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="6" Height="280">
                        <DataGrid ItemsSource="{Binding SelectedSaleItems}" AutoGenerateColumns="False" 
                                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  Background="Transparent" RowBackground="Transparent" BorderThickness="0"
                                  CanUserResizeColumns="False" CanUserReorderColumns="False" CanUserResizeRows="False" CanUserSortColumns="False"
                                  HorizontalGridLinesBrush="{DynamicResource BorderDark}"
                                  RowHeight="38">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="المادة" Binding="{Binding ProductName}" Width="2*" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" />
                                <DataGridTextColumn Header="سعر الوحدة" Binding="{Binding UnitPrice, StringFormat='{}{0:N0} د.ع'}" Width="120" Foreground="{DynamicResource SuccessBrush}" />
                                <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, StringFormat='{}{0:0}'}" Width="90" Foreground="{DynamicResource WarningBrush}" FontWeight="Bold" />
                                <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalPrice, StringFormat='{}{0:N0} د.ع'}" Width="120" Foreground="{DynamicResource PrimaryAccent}" FontWeight="Black" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Close Button -->
                    <Button Grid.Row="2" Style="{StaticResource ActionButton}" Command="{Binding CloseSaleItemsModalCommand}" Height="38" Margin="0,14,0,0">
                        <TextBlock Text="إغلاق" FontWeight="Bold" />
                    </Button>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
