<Window x:Class="HamoPos.Views.CashierAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إدارة حساب الكاشير"
        Height="530" Width="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI, Tahoma, Arial">

    <Border Background="{DynamicResource BgDarkSecondary}" 
            CornerRadius="16" 
            BorderBrush="{DynamicResource BorderDark}" 
            BorderThickness="1.5" 
            Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.6" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" Background="#0C2548" CornerRadius="10" Margin="0,0,10,0">
                        <TextBlock Text="👤" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtTitle" Text="إدارة حساب الكاشير" FontSize="16" FontWeight="Black" Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="تحديد بيانات الدخول، الصلاحيات، والرمز السري" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <Button HorizontalAlignment="Right" Click="Close_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6">
                    <TextBlock Text="✕" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" />
                </Button>
            </Grid>

            <!-- Form -->
            <StackPanel Grid.Row="1">
                <TextBlock Text="الاسم الكامل للكاشير / الموظف: *" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                <TextBox x:Name="TxtFullName" Style="{DynamicResource ModernDarkTextBox}" FontSize="13" Margin="0,0,0,10" Height="36" />

                <TextBlock Text="اسم المستخدم (Username): *" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                <TextBox x:Name="TxtUsername" Style="{DynamicResource ModernDarkTextBox}" FontSize="13" Margin="0,0,0,10" Height="36" />

                <TextBlock Text="الرمز السري / كلمة المرور (PIN):" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                <TextBox x:Name="TxtPassword" Style="{DynamicResource ModernDarkTextBox}" FontSize="13" Margin="0,0,0,10" Height="36" />

                <TextBlock Text="الصلاحية / الدور:" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                <ComboBox x:Name="CmbRole" Height="36" Background="{DynamicResource BgDarkPrimary}" Foreground="{DynamicResource TextPrimary}" FontSize="13" Margin="0,0,0,12">
                    <ComboBoxItem Content="Cashier" IsSelected="True" />
                    <ComboBoxItem Content="Admin" />
                    <ComboBoxItem Content="Manager" />
                </ComboBox>

                <CheckBox x:Name="ChkActive" Content="الحساب نشط ومفعل للبيع" IsChecked="True" Foreground="{DynamicResource TextPrimary}" FontSize="12.5" Margin="0,0,0,14" />
            </StackPanel>

            <!-- Footer Actions -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Click="Save_Click" Style="{DynamicResource PrimarySuccessButton}" Height="42" Cursor="Hand">
                    <TextBlock Text="💾 حفظ بيانات الحساب" FontWeight="Bold" FontSize="13" />
                </Button>
                <Button Grid.Column="2" Click="Close_Click" Style="{DynamicResource ActionButton}" Height="42" Cursor="Hand">
                    <TextBlock Text="إلغاء" FontWeight="Bold" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
