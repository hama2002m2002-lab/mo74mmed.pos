<UserControl x:Class="HamoPos.Views.SuppliersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1300"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="24,16">
        <!-- ======================================================== -->
        <!-- VIEW 1: SUPPLIERS GRID CARDS VIEW (MAIN VIEW) -->
        <!-- ======================================================== -->
        <Grid Visibility="{Binding IsCardsGridActive, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <!-- 0: Header & Action Bar -->
                <RowDefinition Height="Auto" />
                <!-- 1: Responsive Suppliers Cards Grid -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 0: Top Action & Search Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ActionButton}" Command="{Binding BackToMainCommand}" Padding="14,8" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔙 " FontSize="14" />
                            <TextBlock Text="{Binding Loc[Nav_BackToMain]}" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🤝 " FontSize="22" />
                        <TextBlock Text="{Binding Loc[Sup_Title]}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- Search Input in Middle -->
                <Border Grid.Column="1" HorizontalAlignment="Center" Width="360" Background="{DynamicResource BgDarkSecondary}" CornerRadius="10" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍 " FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="8,0" />
                        <TextBox Grid.Column="1" Style="{StaticResource ModernDarkTextBox}" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                 Padding="6,4" FontSize="13" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Right Actions: Add Supplier + Refresh -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimarySuccessButton}" Command="{Binding OpenAddSupplierModalCommand}" Padding="14,8" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕ " FontSize="14" />
                            <TextBlock Text="{Binding Loc[Sup_AddSupplier]}" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ActionButton}" Command="{Binding RefreshCommand}" Padding="12,8">
                        <TextBlock Text="🔄" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 1: Responsive Cards Grid (Small Tile for each Supplier) -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding SupplierCards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.OpenSupplierDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Margin="0,0,16,16" Width="290" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1.5" Padding="16">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccent}" />
                                                            <Setter Property="Background" Value="#1E293B" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- 0: Supplier Avatar & Name -->
                                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="42" Height="42" Background="#1E3A8A" CornerRadius="10" Margin="0,0,10,0">
                                                        <TextBlock Text="🏢" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Black" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Company}" FontSize="11" Foreground="{DynamicResource PrimaryAccent}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- 1: Phone & Location -->
                                                <Border Grid.Row="1" Background="{DynamicResource BgDarkPrimary}" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <TextBlock Text="📞 " FontSize="11" />
                                                            <TextBlock Text="{Binding Phone}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="📍 " FontSize="11" />
                                                            <TextBlock Text="{Binding Address}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>

                                                <!-- 2: Badges (Products Count & Invoices Count & Balance) -->
                                                <Grid Grid.Row="2" Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="6" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Products Count Badge -->
                                                    <Border Grid.Column="0" Background="#064E3B" CornerRadius="6" Padding="6,4">
                                                        <StackPanel HorizontalAlignment="Center">
                                                            <TextBlock Text="📦 أنواع المواد" FontSize="10" Foreground="#6EE7B7" />
                                                            <TextBlock Text="{Binding ProductsCount, StringFormat='{}{0} أصناف'}" FontSize="12" FontWeight="Black" Foreground="#A7F3D0" HorizontalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                    <!-- Invoices Count Badge -->
                                                    <Border Grid.Column="2" Background="#1E3A8A" CornerRadius="6" Padding="6,4">
                                                        <StackPanel HorizontalAlignment="Center">
                                                            <TextBlock Text="📜 عدد الوصولات" FontSize="10" Foreground="#93C5FD" />
                                                            <TextBlock Text="{Binding InvoicesCount, StringFormat='{}{0} وصل'}" FontSize="12" FontWeight="Black" Foreground="#BFDBFE" HorizontalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>

                                                <!-- 3: Financial Balance & Open Button -->
                                                <Grid Grid.Row="3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="الرصيد المستحق:" FontSize="10" Foreground="{DynamicResource TextSecondary}" />
                                                        <TextBlock Text="{Binding Balance, StringFormat='{}{0:N0} د.ع'}" FontSize="13" FontWeight="Black" Foreground="#F59E0B" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="#0F172A" CornerRadius="6" Padding="10,5" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1">
                                                        <TextBlock Text="عرض التفاصيل ➔" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}" />
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ======================================================== -->
        <!-- VIEW 2: DEDICATED SUPPLIER DETAILS FULL VIEW -->
        <!-- ======================================================== -->
        <Grid Visibility="{Binding IsSupplierDetailsActive, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <!-- 0: Header with Back button and Actions -->
                <RowDefinition Height="Auto" />
                <!-- 1: Top Metrics Bar -->
                <RowDefinition Height="Auto" />
                <!-- 2: Navigation Pills (Invoices, Products, Ledger) -->
                <RowDefinition Height="Auto" />
                <!-- 3: Tab Content Workspace -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 0: Top Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource PrimaryAccentButton}" Command="{Binding BackToCardsGridCommand}" Padding="16,8" Margin="0,0,14,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔙 " FontSize="14" />
                        <TextBlock Text="{Binding Loc[Sup_BackToCards]}" FontWeight="Bold" />
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding SelectedSupplier.Name}" FontSize="20" FontWeight="Black" Foreground="{DynamicResource TextPrimary}" />
                        <Border Background="#1E3A8A" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedSupplier.Company}" FontSize="12" FontWeight="Bold" Foreground="#93C5FD" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="📞 " FontSize="11" />
                        <TextBlock Text="{Binding SelectedSupplier.Phone}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,12,0" />
                        <TextBlock Text="📍 " FontSize="11" />
                        <TextBlock Text="{Binding SelectedSupplier.Address}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                    </StackPanel>
                </StackPanel>

                <!-- Actions: Record Payment + Delete -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimarySuccessButton}" Command="{Binding OpenPaymentModalCommand}" Padding="16,8" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💳 " FontSize="14" />
                            <TextBlock Text="تسجيل دفعة نقدية" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ActionButton}" Command="{Binding DeleteSupplierCommand}" Padding="12,8">
                        <TextBlock Text="🗑 حذف المندوب" Foreground="{DynamicResource DangerBrush}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 1: Top Metrics Cards (4 KPI Cards) -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="14,10" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="عدد أصناف المواد الموردة" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Text="{Binding SupplierProductsCount, StringFormat='{}{0:N0} أصناف'}" FontSize="18" FontWeight="Black" Foreground="{DynamicResource PrimaryAccent}" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="14,10" Margin="3,0">
                    <StackPanel>
                        <TextBlock Text="عدد وصولات وفواتير الشراء" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Text="{Binding SupplierInvoicesCount, StringFormat='{}{0:N0} وصل'}" FontSize="18" FontWeight="Black" Foreground="#38BDF8" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="14,10" Margin="3,0">
                    <StackPanel>
                        <TextBlock Text="قيمة بضاعة المندوب بالمخزن" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Text="{Binding SupplierTotalStockValue, StringFormat='{}{0:N0} د.ع'}" FontSize="18" FontWeight="Black" Foreground="{DynamicResource SuccessBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="#261A0C" CornerRadius="12" BorderBrush="#F59E0B" BorderThickness="1" Padding="14,10" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="الرصيد المستحق للمندوب (الديون)" FontSize="11" FontWeight="Bold" Foreground="#FDE68A" />
                        <TextBlock Text="{Binding SupplierNetBalance, StringFormat='{}{0:N0} د.ع'}" FontSize="18" FontWeight="Black" Foreground="#F59E0B" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 2: Navigation Pills (Invoices, Products, Ledger) -->
            <Border Grid.Row="2" Background="{DynamicResource BgDarkSecondary}" CornerRadius="10" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="6" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <!-- Tab 1: Invoices -->
                    <Button Style="{StaticResource ActionButton}" Command="{Binding ShowInvoicesTabCommand}" Padding="16,8" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📜 " FontSize="13" />
                            <TextBlock Text="{Binding Loc[Sup_InvoicesTab]}" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                    <!-- Tab 2: Products -->
                    <Button Style="{StaticResource ActionButton}" Command="{Binding ShowProductsTabCommand}" Padding="16,8" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📦 " FontSize="13" />
                            <TextBlock Text="{Binding Loc[Sup_ProductsTab]}" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                    <!-- Tab 3: Ledger -->
                    <Button Style="{StaticResource ActionButton}" Command="{Binding ShowLedgerTabCommand}" Padding="16,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📒 " FontSize="13" />
                            <TextBlock Text="{Binding Loc[Sup_LedgerTab]}" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- 3: Tab Content Workspace -->
            <Grid Grid.Row="3">
                <!-- TAB 1: PURCHASE INVOICES (WITH ATTACH / VIEW RECEIPT IMAGE) -->
                <Border Visibility="{Binding IsInvoicesTabActive, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="12">
                    <DataGrid ItemsSource="{Binding SupplierInvoices}" AutoGenerateColumns="False" 
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              Background="Transparent" RowBackground="Transparent" BorderThickness="0"
                              CanUserResizeColumns="False" CanUserReorderColumns="False" CanUserResizeRows="False" CanUserSortColumns="False"
                              HorizontalGridLinesBrush="{DynamicResource BorderDark}"
                              RowHeight="50">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم الوصل" Binding="{Binding InvoiceNumber}" Width="150" Foreground="{DynamicResource PrimaryAccent}" FontWeight="Bold" />
                            <DataGridTextColumn Header="تاريخ الشراء" Binding="{Binding CreatedAt, StringFormat='{}{0:yyyy/MM/dd - hh:mm tt}'}" Width="170" Foreground="{DynamicResource TextSecondary}" />
                            <DataGridTextColumn Header="المبلغ الإجمالي" Binding="{Binding TotalAmount, StringFormat='{}{0:N0} د.ع'}" Width="140" Foreground="{DynamicResource SuccessBrush}" FontWeight="Black" />
                            <DataGridTextColumn Header="المدفوع" Binding="{Binding PaidAmount, StringFormat='{}{0:N0} د.ع'}" Width="130" Foreground="#38BDF8" FontWeight="Bold" />
                            <DataGridTextColumn Header="المتبقي (آجل)" Binding="{Binding RemainingAmount, StringFormat='{}{0:N0} د.ع'}" Width="130" Foreground="{DynamicResource WarningBrush}" FontWeight="Bold" />
                            <DataGridTextColumn Header="طريقة الدفع" Binding="{Binding PaymentMethod}" Width="110" Foreground="{DynamicResource TextSecondary}" />
                            
                            <!-- Receipt Image Action Column -->
                            <DataGridTemplateColumn Header="صورة وصل المندوب المرفقة" Width="260">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- View Button (Visible if has image) -->
                                            <Button Style="{StaticResource PrimaryAccentButton}" 
                                                    Command="{Binding DataContext.ViewReceiptImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="10,5" Margin="0,0,6,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🖼 " FontSize="12" />
                                                    <TextBlock Text="عرض الصورة" FontSize="11" FontWeight="Bold" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Attach/Change Button -->
                                            <Button Style="{StaticResource ActionButton}" 
                                                    Command="{Binding DataContext.AttachReceiptImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="10,5">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📷 " FontSize="12" />
                                                    <TextBlock Text="إرفاق وصل" FontSize="11" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- TAB 2: SUPPLIED PRODUCTS TABLE -->
                <Border Visibility="{Binding IsProductsTabActive, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="12">
                    <DataGrid ItemsSource="{Binding SupplierProducts}" AutoGenerateColumns="False" 
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              Background="Transparent" RowBackground="Transparent" BorderThickness="0"
                              CanUserResizeColumns="False" CanUserReorderColumns="False" CanUserResizeRows="False" CanUserSortColumns="False"
                              HorizontalGridLinesBrush="{DynamicResource BorderDark}"
                              RowHeight="44">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الباركود" Binding="{Binding Barcode}" Width="140" Foreground="{DynamicResource PrimaryAccent}" />
                            <DataGridTextColumn Header="اسم المادة" Binding="{Binding Name}" Width="2*" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" />
                            <DataGridTextColumn Header="المخزون الحالي" Binding="{Binding StockQuantity, StringFormat='{}{0:N0}'}" Width="120" Foreground="{DynamicResource WarningBrush}" FontWeight="Black" />
                            <DataGridTextColumn Header="سعر شراء الكرتون" Binding="{Binding CartonPurchasePrice, StringFormat='{}{0:N0} د.ع'}" Width="140" Foreground="{DynamicResource TextSecondary}" />
                            <DataGridTextColumn Header="تكلفة المفرد" Binding="{Binding Cost, StringFormat='{}{0:N0} د.ع'}" Width="120" Foreground="{DynamicResource TextSecondary}" />
                            <DataGridTextColumn Header="سعر بيع المفرد" Binding="{Binding Price, StringFormat='{}{0:N0} د.ع'}" Width="130" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- TAB 3: FINANCIAL LEDGER & PAYMENTS TABLE -->
                <Border Visibility="{Binding IsLedgerTabActive, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="12">
                    <DataGrid ItemsSource="{Binding SupplierTransactions}" AutoGenerateColumns="False" 
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              Background="Transparent" RowBackground="Transparent" BorderThickness="0"
                              CanUserResizeColumns="False" CanUserReorderColumns="False" CanUserResizeRows="False" CanUserSortColumns="False"
                              HorizontalGridLinesBrush="{DynamicResource BorderDark}"
                              RowHeight="44">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="التاريخ والوقت" Binding="{Binding CreatedAt, StringFormat='{}{0:yyyy/MM/dd - hh:mm tt}'}" Width="170" Foreground="{DynamicResource TextSecondary}" />
                            <DataGridTextColumn Header="نوع المعاملة" Binding="{Binding TransactionType}" Width="130" Foreground="{DynamicResource PrimaryAccent}" FontWeight="Bold" />
                            <DataGridTextColumn Header="المبلغ (د.ع)" Binding="{Binding Amount, StringFormat='{}{0:N0} د.ع'}" Width="140" Foreground="{DynamicResource SuccessBrush}" FontWeight="Black" />
                            <DataGridTextColumn Header="رقم إيصال السداد" Binding="{Binding ReceiptNumber}" Width="160" Foreground="{DynamicResource TextSecondary}" />
                            <DataGridTextColumn Header="البيان والملاحظات" Binding="{Binding Notes}" Width="2*" Foreground="{DynamicResource TextPrimary}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>

        <!-- ======================================================== -->
        <!-- POPUP MODAL 1: ADD NEW SUPPLIER MODAL -->
        <!-- ======================================================== -->
        <Border Background="#DD000000" 
                Visibility="{Binding IsAddSupplierModalOpen, Converter={StaticResource BoolToVis}}" 
                Margin="-24,-16">
            <Border Width="480" Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="➕ إضافة مندوب أو شركة جديدة" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Command="{Binding CloseAddSupplierModalCommand}" Cursor="Hand" Padding="4">
                            <TextBlock Text="✕" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" />
                        </Button>
                    </Grid>

                    <TextBlock Text="اسم المندوب:" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource ModernDarkTextBox}" Text="{Binding InputName, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Margin="0,0,0,10" />

                    <TextBlock Text="اسم الشركة / المكان:" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource ModernDarkTextBox}" Text="{Binding InputCompany, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Margin="0,0,0,10" />

                    <TextBlock Text="رقم هاتف المندوب:" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource ModernDarkTextBox}" Text="{Binding InputPhone, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Margin="0,0,0,10" />

                    <TextBlock Text="عنوان المكتب أو المدينة:" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource ModernDarkTextBox}" Text="{Binding InputAddress, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Margin="0,0,0,10" />

                    <TextBlock Text="الرصيد الافتتاحي (د.ع):" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource ModernDarkTextBox}" Text="{Binding InputOpeningBalance, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0}'}" FontSize="13" TextAlignment="Center" Margin="0,0,0,16" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource PrimarySuccessButton}" Command="{Binding SaveNewSupplierCommand}" Height="40">
                            <TextBlock Text="{Binding Loc[Gen_Save]}" FontWeight="Bold" />
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource ActionButton}" Command="{Binding CloseAddSupplierModalCommand}" Height="40">
                            <TextBlock Text="{Binding Loc[Gen_Cancel]}" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- ======================================================== -->
        <!-- POPUP MODAL 2: RECORD PAYMENT MODAL -->
        <!-- ======================================================== -->
        <Border Background="#DD000000" 
                Visibility="{Binding IsPaymentModalOpen, Converter={StaticResource BoolToVis}}" 
                Margin="-24,-16">
            <Border Width="460" Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="💳 تسجيل دفعة نقدية للمندوب" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Command="{Binding ClosePaymentModalCommand}" Cursor="Hand" Padding="4">
                            <TextBlock Text="✕" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" />
                        </Button>
                    </Grid>

                    <TextBlock Text="المبلغ المدفوع (د.ع):" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource ModernDarkTextBox}" Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0}'}" 
                             FontSize="18" FontWeight="Black" TextAlignment="Center" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,0,12" />

                    <TextBlock Text="رقم الوصل / الإيصال:" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource ModernDarkTextBox}" Text="{Binding PaymentReceiptNumber, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Margin="0,0,0,12" />

                    <TextBlock Text="ملاحظات وبيان السداد:" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource ModernDarkTextBox}" Text="{Binding PaymentNotes, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Margin="0,0,0,18" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource PrimarySuccessButton}" Command="{Binding ConfirmPaymentCommand}" Height="40">
                            <TextBlock Text="✔ تأكيد السداد" FontWeight="Bold" />
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource ActionButton}" Command="{Binding ClosePaymentModalCommand}" Height="40">
                            <TextBlock Text="{Binding Loc[Gen_Cancel]}" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- ======================================================== -->
        <!-- POPUP MODAL 3: VIEW RECEIPT IMAGE MODAL -->
        <!-- ======================================================== -->
        <Border Background="#EE000000" 
                Visibility="{Binding IsReceiptImageModalOpen, Converter={StaticResource BoolToVis}}" 
                Margin="-24,-16">
            <Border Width="700" MaxHeight="750" Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Header -->
                        <RowDefinition Height="Auto" />
                        <!-- Image Container -->
                        <RowDefinition Height="*" />
                        <!-- Footer -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📷 " FontSize="18" />
                            <TextBlock Text="{Binding Loc[Sup_ReceiptModalTitle]}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="{Binding CurrentReceiptInvoiceNumber, StringFormat='{} - فاتورة رقم: {0}'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryAccent}" Margin="8,0,0,0" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Command="{Binding CloseReceiptImageModalCommand}" Cursor="Hand" Padding="4">
                            <TextBlock Text="✕" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" />
                        </Button>
                    </Grid>

                    <!-- Receipt Image Viewer -->
                    <Border Grid.Row="1" Background="#0F172A" CornerRadius="10" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="8" MaxHeight="520">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Image Source="{Binding CurrentReceiptImagePath}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </ScrollViewer>
                    </Border>

                    <!-- Footer Actions -->
                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Button HorizontalAlignment="Left" Style="{StaticResource ActionButton}" Command="{Binding DeleteReceiptImageCommand}" CommandParameter="{Binding SelectedInvoiceForImage}" Padding="14,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗑 " FontSize="12" />
                                <TextBlock Text="حذف الصورة" Foreground="{DynamicResource DangerBrush}" />
                            </StackPanel>
                        </Button>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource PrimaryAccentButton}" Command="{Binding AttachReceiptImageCommand}" CommandParameter="{Binding SelectedInvoiceForImage}" Padding="16,8" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔄 " FontSize="12" />
                                    <TextBlock Text="تغيير الصورة" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ActionButton}" Command="{Binding CloseReceiptImageModalCommand}" Padding="16,8">
                                <TextBlock Text="إغلاق" FontWeight="Bold" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
