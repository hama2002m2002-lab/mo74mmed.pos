<UserControl x:Class="HamoPos.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:HamoPos.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100"
             Background="{DynamicResource BgDarkPrimary}"
             Foreground="{DynamicResource TextPrimary}"
             FlowDirection="RightToLeft"
             FontFamily="Segoe UI, Tahoma, Arial">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20">
        <StackPanel MaxWidth="900" HorizontalAlignment="Center">
            
            <!-- Page Header -->
            <Border Background="{DynamicResource BgDarkSecondary}" CornerRadius="16" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="20,16" Margin="0,0,0,20">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="48" Height="48" Background="#0C2548" CornerRadius="12" Margin="0,0,16,0">
                            <TextBlock Text="⚙️" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="إعدادات النظام والشبكة والتحديثات" FontSize="19" FontWeight="Black" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="إدارة ربط ومزامنة الأجهزة المتعددة (مدير وكاشير)، فحص التحديثات، ومعلومات النظام" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Status Badge on Right -->
                    <Border HorizontalAlignment="Right" Background="#064E3B" CornerRadius="10" Padding="12,6" BorderBrush="#10B981" BorderThickness="1">
                        <TextBlock Text="{Binding StatusBadgeText}" FontSize="12" FontWeight="Bold" Foreground="#34D399" />
                    </Border>
                </Grid>
            </Border>

            <!-- SECTION 1: NETWORK & MULTI-DEVICE SYNCHRONIZATION -->
            <Border Background="{DynamicResource BgDarkSecondary}" CornerRadius="16" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="22" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="🌐 " FontSize="18" />
                        <TextBlock Text="إعدادات الشبكة ومزامنة الأجهزة المتعددة (Multi-POS)" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}" />
                    </StackPanel>

                    <TextBlock Text="حدد دور هذا اللابتوب على شبكة الواي فاي / الشبكة المحلية:" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10" />

                    <!-- Radio Buttons: Server vs Client -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Radio 1: Server Mode -->
                        <RadioButton Grid.Column="0" IsChecked="{Binding IsServerMode}" GroupName="MainDeviceRole" Cursor="Hand" Margin="0,0,8,0">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border CornerRadius="12" Padding="16,14" BorderThickness="2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#0F172A" />
                                                <Setter Property="BorderBrush" Value="#334155" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                                        <Setter Property="Background" Value="#064E3B" />
                                                        <Setter Property="BorderBrush" Value="#10B981" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🖥️ " FontSize="16" />
                                                <TextBlock Text="جهاز رئيسي (سيرفر / مدير)" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" />
                                            </StackPanel>
                                            <TextBlock Text="يستضيف قاعدة البيانات الأصلية، يدير المخزن والمشتريات والتقارير العامة" FontSize="11" Foreground="#94A3B8" Margin="0,6,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- Radio 2: Client Mode -->
                        <RadioButton Grid.Column="1" IsChecked="{Binding IsClientMode}" GroupName="MainDeviceRole" Cursor="Hand" Margin="8,0,0,0">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border CornerRadius="12" Padding="16,14" BorderThickness="2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#0F172A" />
                                                <Setter Property="BorderBrush" Value="#334155" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                                        <Setter Property="Background" Value="#1E3A8A" />
                                                        <Setter Property="BorderBrush" Value="#3B82F6" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="💻 " FontSize="16" />
                                                <TextBlock Text="جهاز فرعي (كاشير للبيع)" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" />
                                            </StackPanel>
                                            <TextBlock Text="يتصل بسيرفر المدير عبر الواي فاي للبيع المباشر والخصم اللحظي من المخزن" FontSize="11" Foreground="#94A3B8" Margin="0,6,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>
                    </Grid>

                    <!-- Details Area -->
                    <Border Background="{DynamicResource BgDarkPrimary}" CornerRadius="12" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <!-- SERVER VIEW -->
                            <StackPanel Visibility="{Binding IsServerMode, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="📍 معلومات الاتصال بهذا اللابتوب (السيرفر):" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,0,10" />
                                
                                <Border Background="#0C152B" CornerRadius="10" Padding="12,10" BorderBrush="#1E293B" BorderThickness="1" Margin="0,0,0,10">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="عنوان IP المحلي لهذا الجهاز: " FontSize="13" Foreground="{DynamicResource TextSecondary}" />
                                            <TextBlock Text="{Binding LocalIp}" FontSize="16" FontWeight="Black" Foreground="{DynamicResource SuccessBrush}" Margin="10,0,0,0" />
                                        </StackPanel>
                                        <Button HorizontalAlignment="Right" Style="{DynamicResource ActionButton}" Command="{Binding CopyIpCommand}" Padding="12,5" FontSize="11.5" Cursor="Hand">
                                            <TextBlock Text="📋 نسخ الـ IP" FontWeight="Bold" />
                                        </Button>
                                    </Grid>
                                </Border>

                                <TextBlock Text="💡 لتوصيل لابتوب الكاشير بهذا الجهاز:" FontSize="12" FontWeight="Bold" Foreground="#E2E8F0" Margin="0,4,0,4" />
                                <TextBlock Text="1. شارك مجلد البرنامج أو مجلد قاعدة البيانات عبر شبكة الواي فاي.\n2. على لابتوب الكاشير، اختر (جهاز فرعي) وحدد مسار قاعدة البيانات المشترك." FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" LineHeight="18" />
                            </StackPanel>

                            <!-- CLIENT VIEW -->
                            <StackPanel Visibility="{Binding IsClientMode, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="🔗 مسار قاعدة بيانات السيرفر المشتركة (pos_data.db):" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}" Margin="0,0,0,8" />
                                
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{DynamicResource ModernDarkTextBox}" 
                                             Text="{Binding SharedDatabasePath, UpdateSourceTrigger=PropertyChanged}" 
                                             FontSize="13.5" Padding="10,8" Margin="0,0,8,0" />
                                    <Button Grid.Column="1" Style="{DynamicResource ActionButton}" Command="{Binding BrowseDatabasePathCommand}" Padding="16,8" Cursor="Hand">
                                        <TextBlock Text="📁 استعراض..." FontWeight="Bold" />
                                    </Button>
                                </Grid>

                                <TextBlock Text="💡 مثال للمسار: \\192.168.1.50\HamoPos\pos_data.db أو مسار المجلد المشترك" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Test Connection & Save Action Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Test Button -->
                        <Button Grid.Column="0" Style="{DynamicResource PrimaryAccentButton}" Command="{Binding TestConnectionCommand}" Padding="16,10" Height="42" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍 " FontSize="14" />
                                <TextBlock Text="فحص الاتصال بقاعدة البيانات" FontWeight="Bold" FontSize="12.5" />
                            </StackPanel>
                        </Button>

                        <!-- Status Message -->
                        <TextBlock Grid.Column="1" Text="{Binding TestStatusMessage}" 
                                   FontSize="12" FontWeight="Bold" 
                                   VerticalAlignment="Center" Margin="14,0" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnectionSuccessful}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsConnectionSuccessful}" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Save Button -->
                        <Button Grid.Column="2" Style="{DynamicResource PrimarySuccessButton}" Command="{Binding SaveSettingsCommand}" Padding="20,10" Height="42" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💾 " FontSize="14" />
                                <TextBlock Text="حفظ إعدادات الشبكة" FontWeight="Black" FontSize="13" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- SECTION 2: STORE, LOGO & RECEIPT SETTINGS (إعدادات المخزن، الشعار، والوصل) -->
            <Border Background="{DynamicResource BgDarkSecondary}" CornerRadius="16" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="22" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="🏢 " FontSize="18" />
                        <TextBlock Text="إعدادات بيانات المخزن / المحل، الشعار (Logo)، والوصل وفواتير A4" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}" />
                    </StackPanel>

                    <TextBlock Text="هذه المعلومات وشعار المحل ستظهر تلقائياً في أعلى وأسفل كافة فواتير البيع ووصلات A4 المطبوعة:" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,16" />

                    <!-- Logo and Basic Info Grid -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Logo Picker & Preview -->
                        <Border Grid.Column="0" Background="#0B132B" BorderBrush="#23334D" BorderThickness="1.5" CornerRadius="12" Padding="8" Margin="0,0,14,0" VerticalAlignment="Top">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="شعار المحل (Logo)" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                
                                <Border Width="110" Height="80" Background="#151D30" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,8">
                                    <Grid>
                                        <TextBlock Text="🖼️ لا يوجد شعار" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasStoreLogo, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}" />
                                        <Image Source="{Binding StoreLogoPath}" Stretch="Uniform" Visibility="{Binding HasStoreLogo, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </Border>

                                <Button Command="{Binding BrowseLogoCommand}" Style="{DynamicResource ActionButton}" Padding="8,5" Margin="0,0,0,4" Cursor="Hand">
                                    <TextBlock Text="📁 اختيار لوجو" FontSize="11" FontWeight="Bold" />
                                </Button>
                                <Button Command="{Binding RemoveLogoCommand}" Style="{DynamicResource ActionButton}" Padding="8,4" Cursor="Hand" Visibility="{Binding HasStoreLogo, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="🗑️ إزالة" FontSize="10.5" Foreground="#EF4444" />
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Fields Col -->
                        <StackPanel Grid.Column="1">
                            <!-- Row 1: Store Name & Tagline -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="اسم المخزن / المحل:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding StoreName, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DarkTextBox}" Height="38" FontSize="13" FontWeight="Bold" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="وصف النشاط / الشعار النصي:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding StoreTagline, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DarkTextBox}" Height="38" FontSize="12" />
                                </StackPanel>
                            </Grid>

                            <!-- Row 2: Phone 1 & Phone 2 -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="رقم الهاتف الأساسي:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding StorePhone1, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DarkTextBox}" Height="38" FontSize="13" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="رقم الهاتف الإضافي (اختياري):" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding StorePhone2, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DarkTextBox}" Height="38" FontSize="13" />
                                </StackPanel>
                            </Grid>

                            <!-- Row 3: Address -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="عنوان وموقع المخزن / المحل:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding StoreAddress, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DarkTextBox}" Height="38" FontSize="12.5" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Receipt Footer & A4 Terms -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="تذييل الوصل الترحيبي (Footer):" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding ReceiptFooterNotes, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DarkTextBox}" Height="38" FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="شروط وسياسة الإرجاع بفواتير A4:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding A4Terms, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DarkTextBox}" Height="38" FontSize="12" />
                        </StackPanel>
                    </Grid>

                    <!-- Save Store Settings Button -->
                    <Button Style="{DynamicResource PrimarySuccessButton}" Command="{Binding SaveStoreSettingsCommand}" HorizontalAlignment="Right" Padding="24,10" Height="42" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾 " FontSize="14" />
                            <TextBlock Text="حفظ إعدادات المخزن واللوجو" FontWeight="Black" FontSize="13" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- SECTION 3: AUTO-UPDATER & SYSTEM -->
            <Border Background="{DynamicResource BgDarkSecondary}" CornerRadius="16" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="22" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="🚀 " FontSize="18" />
                            <TextBlock Text="تحديثات البرنامج التلقائية (Auto-Updater)" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}" />
                        </StackPanel>
                        <TextBlock Text="فحص وتنزيل أحدث الإصدارات والميزات وتثبيتها تلقائياً دون لمس قاعدة البيانات أو المبيعات." FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Check Updates Button -->
                    <Button Grid.Column="1" Style="{DynamicResource PrimaryAccentButton}" Command="{Binding CheckUpdatesCommand}" Padding="20,12" Height="44" Cursor="Hand" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄 " FontSize="14" />
                            <TextBlock Text="فحص وجود تحديثات الآن" FontWeight="Black" FontSize="13" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- SECTION 3: EMERGENCY ROLLBACK (الرجوع إلى الإصدار السابق لحالة الطوارئ) -->
            <Border Background="{DynamicResource BgDarkSecondary}" CornerRadius="16" BorderBrush="#EF4444" BorderThickness="1.5" Padding="22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="⚠️ " FontSize="18" />
                            <TextBlock Text="{Binding Loc[Settings_RollbackTitle]}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Loc[Settings_RollbackDesc]}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" LineHeight="18" />
                    </StackPanel>

                    <!-- Rollback Button -->
                    <Button Grid.Column="1" Style="{DynamicResource PrimaryDangerButton}" Command="{Binding RollbackPreviousVersionCommand}" Padding="20,12" Height="46" Cursor="Hand" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏪ " FontSize="15" />
                            <TextBlock Text="{Binding Loc[Settings_RollbackBtn]}" FontWeight="Black" FontSize="13" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
