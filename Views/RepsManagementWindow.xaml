<Window x:Class="HamoPos.Views.RepsManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HamoPos.ViewModels"
        mc:Ignorable="d"
        Title="👥 إدارة وتفعيل حسابات المناديب ورموز الدخول (PIN)" 
        Height="580" Width="860"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgDarkPrimary}"
        Foreground="{DynamicResource TextPrimary}"
        FlowDirection="RightToLeft"
        ResizeMode="NoResize"
        FontFamily="Segoe UI, Tahoma, Arial">

    <Border Padding="20" Background="{DynamicResource BgDarkPrimary}">
        <Grid>
            <Grid.RowDefinitions>
                <!-- 0: Header -->
                <RowDefinition Height="Auto" />
                <!-- 1: Body Split (Add Form & Table) -->
                <RowDefinition Height="*" />
                <!-- 2: Footer Actions -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 0: Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" Background="#0C2548" CornerRadius="10" Margin="0,0,12,0">
                        <TextBlock Text="👥" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="إدارة حسابات المناديب ورموز الدخول (PIN)" FontSize="16" FontWeight="Black" Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="إنشاء حسابات للمناديب وتعيين رمز PIN للدخول من الموبايل وإرسال الطلبيات" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" Click="Close_Click" Style="{DynamicResource ActionButton}" Padding="14,6" Cursor="Hand" Background="#334155">
                    <TextBlock Text="✖ إغلاق النافذة" FontSize="12.5" FontWeight="Bold" Foreground="#F87171" />
                </Button>
            </Grid>

            <!-- 1: Body Split -->
            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Add Rep Form -->
                <Border Grid.Column="0" Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="16" Margin="0,0,14,0">
                    <StackPanel>
                        <TextBlock Text="➕ إنشاء حساب مندوب جديد" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}" Margin="0,0,0,12" />

                        <TextBlock Text="اسم المندوب الرباعي / الشهرة:" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                        <TextBox x:Name="TxtRepName" Style="{DynamicResource DarkTextBox}" Height="36" FontSize="13" Margin="0,0,0,8" />

                        <TextBlock Text="رقم هاتف المندوب:" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                        <TextBox x:Name="TxtRepPhone" Style="{DynamicResource DarkTextBox}" Height="36" FontSize="13" Margin="0,0,0,8" />

                        <TextBlock Text="رمز الدخول السري (PIN):" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                        <TextBox x:Name="TxtRepPin" Text="1234" Style="{DynamicResource DarkTextBox}" Height="36" FontSize="14" FontWeight="Bold" Margin="0,0,0,14" />

                        <Button Click="AddRep_Click" Style="{DynamicResource PrimarySuccessButton}" Height="40" Cursor="Hand" Margin="0,0,0,12" Background="#059669">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="➕ " FontSize="13" />
                                <TextBlock Text="حفظ وتفعيل حساب المندوب" FontWeight="Black" FontSize="12.5" />
                            </StackPanel>
                        </Button>

                        <Border Background="#0C2548" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="8" Padding="10">
                            <StackPanel>
                                <TextBlock Text="💡 كيف يسجل المندوب دخوله؟" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,2" />
                                <TextBlock Text="1. يفتح المندوب الرابط من هاتفه." FontSize="10.5" Foreground="#94A3B8" />
                                <TextBlock Text="2. يختار اسمه ويكتب رمز الـ PIN." FontSize="10.5" Foreground="#94A3B8" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Reps Table -->
                <Border Grid.Column="1" Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="قائمة المناديب المسجلين والمصرح لهم" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                        </Grid>

                        <DataGrid x:Name="RepsDataGrid"
                                  Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  RowHeight="40"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource BorderDark}"
                                  HeadersVisibility="Column"
                                  VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="اسم المندوب" Binding="{Binding Name}" Width="1.5*" FontWeight="Bold" />
                                <DataGridTextColumn Header="رقم الهاتف" Binding="{Binding Phone}" Width="*" />
                                <DataGridTextColumn Header="رمز الـ PIN" Binding="{Binding PinCode}" Width="95" FontWeight="Black" Foreground="#F59E0B" />
                                
                                <DataGridTemplateColumn Header="الحالة" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}" Content="نشط" Foreground="#34D399" FontWeight="Bold" HorizontalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="إجراءات" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Click="DeleteRep_Click"
                                                    Style="{DynamicResource ActionButton}"
                                                    Padding="6,3"
                                                    HorizontalAlignment="Center"
                                                    Cursor="Hand"
                                                    ToolTip="حذف حساب المندوب">
                                                <TextBlock Text="🗑️" FontSize="12" Foreground="#EF4444" />
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- 2: Footer -->
            <Grid Grid.Row="2">
                <Button HorizontalAlignment="Right" Click="SaveAndClose_Click" Style="{DynamicResource PrimarySuccessButton}" Padding="20,8" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💾 " FontSize="13" />
                        <TextBlock Text="حفظ التعديلات وإغلاق" FontWeight="Bold" FontSize="12.5" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
