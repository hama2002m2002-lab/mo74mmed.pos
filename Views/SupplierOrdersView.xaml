<UserControl x:Class="HamoPos.Views.SupplierOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:HamoPos.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="{DynamicResource BgDarkPrimary}"
             Foreground="{DynamicResource TextPrimary}"
             FlowDirection="RightToLeft"
             FontFamily="Segoe UI, Tahoma, Arial">

    <Grid>
        <!-- MAIN CONTENT LAYER -->
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <!-- 0: Header -->
                <RowDefinition Height="Auto" />
                <!-- 1: KPI Cards -->
                <RowDefinition Height="Auto" />
                <!-- 2: Filters & Search Toolbar -->
                <RowDefinition Height="Auto" />
                <!-- 3: Orders List & Details Grid -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ======================================================== -->
            <!-- 0: HEADER & ACTIONS TOOLBAR -->
            <!-- ======================================================== -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="44" Height="44" Background="#0C2548" CornerRadius="12" Margin="0,0,14,0">
                        <TextBlock Text="📦" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="طلبيات وحسابات المناديب والمحلات" FontSize="18" FontWeight="Black" Foreground="{DynamicResource TextPrimary}" />
                            <!-- Store Code Badge -->
                            <Border Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" CornerRadius="8" Padding="8,2" Margin="10,0,0,0">
                                <TextBlock Text="{Binding StoreId, StringFormat='{}كود المخزن: {0}'}" FontSize="11" FontWeight="Bold" Foreground="#34D399" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="استقبال ومتابعة طلبيات البضائع سحابياً 24/7، إدارة حسابات المناديب، وطباعة فواتير A4" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Actions Top Right -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Manage Reps Modal Button -->
                    <Button Style="{DynamicResource ActionButton}" Command="{Binding OpenRepsModalCommand}" Padding="12,8" Margin="0,0,8,0" Cursor="Hand" Background="#0C2548" BorderBrush="#38BDF8" ToolTip="إنشاء وإدارة حسابات المناديب ورموز الدخول PIN">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👥 " FontSize="13" />
                            <TextBlock Text="إدارة حسابات المناديب (PIN)" FontWeight="Bold" FontSize="12" Foreground="#38BDF8" />
                        </StackPanel>
                    </Button>

                    <!-- Cloud 24/7 Portal Button -->
                    <Button Style="{DynamicResource ActionButton}" Command="{Binding OpenCloudPortalCommand}" Padding="12,8" Margin="0,0,8,0" Cursor="Hand" Background="#0C2548" BorderBrush="#0284C7" ToolTip="فتح صفحة الموبايل السحابية الخاصة بهذا المخزن">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌐 " FontSize="13" />
                            <TextBlock Text="بوابة الموبايل السحابية" FontWeight="Bold" FontSize="12" />
                        </StackPanel>
                    </Button>
                    
                    <!-- Copy Cloud Link -->
                    <Button Style="{DynamicResource ActionButton}" Command="{Binding CopyCloudPortalUrlCommand}" Padding="10,8" Margin="0,0,8,0" Cursor="Hand" ToolTip="نسخ رابط السحابة المخصص لمخزنك لمشاركته مع المناديب">
                        <TextBlock Text="📋 نسخ رابط المندوب" FontSize="11.5" FontWeight="Bold" />
                    </Button>

                    <Button Style="{DynamicResource PrimarySuccessButton}" Command="{Binding AddNewOrderCommand}" Padding="16,8" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕ " FontSize="14" />
                            <TextBlock Text="تسجيل طلبية جديدة" FontWeight="Bold" FontSize="13" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ======================================================== -->
            <!-- 1: KPI SUMMARY CARDS STRIP -->
            <!-- ======================================================== -->
            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Total Orders -->
                <Border Grid.Column="0" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" Padding="14,10" Margin="0,0,6,0" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="إجمالي الطلبيات" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Text="{Binding TotalOrdersCount}" FontSize="19" FontWeight="Black" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <!-- Pending Orders -->
                <Border Grid.Column="1" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" Padding="14,10" Margin="3,0,3,0" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#F59E0B" Margin="0,0,5,0" />
                            <TextBlock Text="قيد الانتظار" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                        <TextBlock Text="{Binding PendingOrdersCount}" FontSize="19" FontWeight="Black" Foreground="#F59E0B" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <!-- In Prep Orders -->
                <Border Grid.Column="2" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" Padding="14,10" Margin="3,0,3,0" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#3B82F6" Margin="0,0,5,0" />
                            <TextBlock Text="جاري التجهيز" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                        <TextBlock Text="{Binding InPrepOrdersCount}" FontSize="19" FontWeight="Black" Foreground="#3B82F6" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <!-- Delivered Orders -->
                <Border Grid.Column="3" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" Padding="14,10" Margin="3,0,3,0" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#10B981" Margin="0,0,5,0" />
                            <TextBlock Text="تم التوصيل والتوريد" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                        <TextBlock Text="{Binding DeliveredOrdersCount}" FontSize="19" FontWeight="Black" Foreground="#10B981" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <!-- Total Amount -->
                <Border Grid.Column="4" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" Padding="14,10" Margin="6,0,0,0" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="إجمالي قيمة الطلبيات" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Text="{Binding TotalOrdersValue, StringFormat='{}{0:N0} د.ع'}" FontSize="17" FontWeight="Black" Foreground="{DynamicResource PrimaryAccent}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ======================================================== -->
            <!-- 2: FILTERS & SEARCH TOOLBAR -->
            <!-- ======================================================== -->
            <Grid Grid.Row="2" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,16,0">
                    <RadioButton Content="جميع الطلبيات" IsChecked="{Binding IsFilterAll}" Command="{Binding SetFilterCommand}" CommandParameter="All" Style="{DynamicResource FilterTabRadioButton}" />
                    <RadioButton Content="⏳ قيد الانتظار" IsChecked="{Binding IsFilterPending}" Command="{Binding SetFilterCommand}" CommandParameter="Pending" Style="{DynamicResource FilterTabRadioButton}" Margin="6,0,0,0" />
                    <RadioButton Content="📦 جاري التجهيز" IsChecked="{Binding IsFilterInPrep}" Command="{Binding SetFilterCommand}" CommandParameter="InPreparation" Style="{DynamicResource FilterTabRadioButton}" Margin="6,0,0,0" />
                    <RadioButton Content="✔ تم التوصيل" IsChecked="{Binding IsFilterDelivered}" Command="{Binding SetFilterCommand}" CommandParameter="Delivered" Style="{DynamicResource FilterTabRadioButton}" Margin="6,0,0,0" />
                </StackPanel>

                <!-- Search Box -->
                <Border Grid.Column="1" Background="{DynamicResource BgDarkSecondary}" CornerRadius="10" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" VerticalAlignment="Center" FontSize="12.5" Height="34" VerticalContentAlignment="Center" CaretBrush="White" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ======================================================== -->
            <!-- 3: ORDERS DATA GRID & ORDER DETAILS VIEW -->
            <!-- ======================================================== -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6.5*" />
                    <ColumnDefinition Width="3.5*" />
                </Grid.ColumnDefinitions>

                <!-- Orders DataGrid -->
                <Border Grid.Column="0" Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Margin="0,0,14,0" Padding="8">
                    <DataGrid ItemsSource="{Binding FilteredOrders}"
                              SelectedItem="{Binding SelectedOrder}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              Background="Transparent"
                              BorderThickness="0"
                              RowHeight="42"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource BorderDark}"
                              HeadersVisibility="Column"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم الطلبية" Binding="{Binding OrderNumber}" Width="130" FontWeight="Bold" />
                            <DataGridTextColumn Header="الماركت / العميل" Binding="{Binding MarketName}" Width="1.5*" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="المندوب" Binding="{Binding RepresentativeName}" Width="*" />
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding OrderDate, StringFormat='{}{0:yyyy/MM/dd}'}" Width="95" />
                            <DataGridTextColumn Header="المبلغ" Binding="{Binding TotalAmount, StringFormat='{}{0:N0} د.ع'}" Width="105" FontWeight="Black" Foreground="{DynamicResource PrimaryAccent}" />
                            
                            <!-- Status Badge -->
                            <DataGridTemplateColumn Header="الحالة" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" Padding="8,3" HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#334155" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                            <Setter Property="Background" Value="#854D0E" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="InPreparation">
                                                            <Setter Property="Background" Value="#1E40AF" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Delivered">
                                                            <Setter Property="Background" Value="#065F46" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold" Foreground="White" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Order Details Panel -->
                <Border Grid.Column="1" Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="14">
                    <Grid>
                        <!-- EMPTY STATE -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding HasSelectedOrder, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                            <TextBlock Text="📋" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Text="اختر طلبية لعرض تفاصيلها" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- ORDER DETAILS VIEW -->
                        <Grid Visibility="{Binding HasSelectedOrder, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Order Info Header -->
                            <Border Grid.Row="0" Background="{DynamicResource BgDarkPrimary}" CornerRadius="10" Padding="12" Margin="0,0,0,10" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="{Binding SelectedOrder.MarketName, StringFormat='{}ماركت: {0}'}" FontSize="14.5" FontWeight="Black" Foreground="{DynamicResource PrimaryAccent}" />
                                        <TextBlock HorizontalAlignment="Right" Text="{Binding SelectedOrder.OrderNumber}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" />
                                    </Grid>

                                    <Grid Margin="0,0,0,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📞 " FontSize="11" />
                                            <TextBlock Text="{Binding SelectedOrder.MarketPhone}" FontSize="11" FontWeight="Bold" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="👤 " FontSize="11" />
                                            <TextBlock Text="{Binding SelectedOrder.RepresentativeName}" FontSize="11" FontWeight="Bold" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="📍 " FontSize="11" />
                                        <TextBlock Text="{Binding SelectedOrder.MarketAddress}" FontSize="11" Foreground="{DynamicResource TextPrimary}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Order Items List -->
                            <Border Grid.Row="1" Background="{DynamicResource BgDarkPrimary}" CornerRadius="10" Padding="8" Margin="0,0,0,10" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1">
                                <DataGrid ItemsSource="{Binding SelectedOrderItems}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          RowHeight="32"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="{DynamicResource BorderDark}"
                                          HeadersVisibility="Column"
                                          VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="المادة" Binding="{Binding ProductName}" Width="*" FontWeight="SemiBold" />
                                        <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity}" Width="50" FontWeight="Bold" />
                                        <DataGridTextColumn Header="الوحدة" Binding="{Binding UnitType}" Width="50" />
                                        <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalPrice, StringFormat='{}{0:N0}'}" Width="75" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <!-- Actions Footer -->
                            <StackPanel Grid.Row="2">
                                <!-- Status Modifier Buttons -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Command="{Binding SetPendingStatusCommand}" Padding="4,5" Margin="0,0,3,0" Background="#854D0E" Foreground="White" BorderThickness="0" Cursor="Hand">
                                        <TextBlock Text="⏳ انتظار" FontSize="11" FontWeight="Bold" />
                                    </Button>
                                    <Button Grid.Column="1" Command="{Binding SetInPrepStatusCommand}" Padding="4,5" Margin="2,0" Background="#1E40AF" Foreground="White" BorderThickness="0" Cursor="Hand">
                                        <TextBlock Text="📦 تجهيز" FontSize="11" FontWeight="Bold" />
                                    </Button>
                                    <Button Grid.Column="2" Command="{Binding SetDeliveredStatusCommand}" Padding="4,5" Margin="3,0,0,0" Background="#065F46" Foreground="White" BorderThickness="0" Cursor="Hand">
                                        <TextBlock Text="✔ توصيل" FontSize="11" FontWeight="Bold" />
                                    </Button>
                                </Grid>

                                <!-- Deliver and Print A4 Button (Top Action) -->
                                <Button Command="{Binding DeliverAndPrintA4Command}" Style="{DynamicResource PrimarySuccessButton}" Height="38" Margin="0,0,0,6" Cursor="Hand" Background="#059669" ToolTip="تغيير حالة الطلبية إلى تم التسليم وطباعة فاتورة A4 رسمية فوراً">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🖨️ " FontSize="14" />
                                        <TextBlock Text="تسليم وطباعة وصل A4 فوري" FontWeight="Black" FontSize="12" />
                                    </StackPanel>
                                </Button>

                                <!-- Convert to Purchase Invoice Button -->
                                <Button Command="{Binding ConvertToInvoiceCommand}" Style="{DynamicResource ActionButton}" Height="34" Margin="0,0,0,6" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🛒 " FontSize="12" />
                                        <TextBlock Text="تحويل الطلبية لفاتورة شراء وتوريد" FontWeight="Bold" FontSize="11" />
                                    </StackPanel>
                                </Button>

                                <!-- Print A4 & Delete Buttons Grid -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Command="{Binding PrintA4InvoiceCommand}" Style="{DynamicResource ActionButton}" Height="34" Margin="0,0,3,0" Cursor="Hand" ToolTip="طباعة فاتورة A4 رسمية">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📄 " FontSize="12" />
                                            <TextBlock Text="وصل A4" FontSize="11" FontWeight="Bold" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Command="{Binding PrintOrderCommand}" Style="{DynamicResource ActionButton}" Height="34" Margin="3,0,3,0" Cursor="Hand" ToolTip="طباعة كشف تجهيز سريع">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🧾 " FontSize="12" />
                                            <TextBlock Text="كشف تجهيز" FontSize="11" FontWeight="Bold" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Command="{Binding DeleteOrderCommand}" Style="{DynamicResource ActionButton}" Height="34" Padding="12,0" Margin="3,0,0,0" Cursor="Hand" ToolTip="حذف الطلبية">
                                        <TextBlock Text="🗑️" FontSize="13" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ======================================================== -->
        <!-- MODAL OVERLAY: REPS MANAGEMENT & PIN (إدارة حسابات المناديب) -->
        <!-- ======================================================== -->
        <Grid Visibility="{Binding IsRepsModalOpen, Converter={StaticResource BoolToVis}}" Background="#E0000000">
            <Border Width="880" Height="580" Background="{DynamicResource BgDarkPrimary}" CornerRadius="18" BorderBrush="{DynamicResource PrimaryAccent}" BorderThickness="1.5" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Modal Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="👥 " FontSize="20" />
                            <TextBlock Text="إدارة حسابات المناديب ورموز الدخول (PIN)" FontSize="16" FontWeight="Black" Foreground="{DynamicResource TextPrimary}" />
                        </StackPanel>

                        <Button Grid.Column="1" Style="{DynamicResource ActionButton}" Command="{Binding CloseRepsModalCommand}" Click="CloseModal_Click" Padding="14,6" Cursor="Hand" Background="#334155">
                            <TextBlock Text="✖ إغلاق النافذة" FontSize="12.5" FontWeight="Bold" Foreground="#F87171" />
                        </Button>
                    </Grid>

                    <!-- Modal Body: Split Form & Table -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Add Rep Form -->
                        <Border Grid.Column="0" Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="16" Margin="0,0,14,0">
                            <StackPanel>
                                <TextBlock Text="➕ إنشاء حساب مندوب جديد" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}" Margin="0,0,0,12" />

                                <TextBlock Text="اسم المندوب الرباعي / الشهرة:" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding NewRepName, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DarkTextBox}" Height="36" FontSize="12.5" Margin="0,0,0,8" />

                                <TextBlock Text="رقم هاتف المندوب:" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding NewRepPhone, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DarkTextBox}" Height="36" FontSize="12.5" Margin="0,0,0,8" />

                                <TextBlock Text="رمز الدخول السري (PIN):" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding NewRepPin, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DarkTextBox}" Height="36" FontSize="14" FontWeight="Bold" Margin="0,0,0,14" />

                                <Button Style="{DynamicResource PrimarySuccessButton}" Command="{Binding AddRepAccountCommand}" Height="40" Cursor="Hand" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="➕ " FontSize="13" />
                                        <TextBlock Text="حفظ وتفعيل حساب المندوب" FontWeight="Black" FontSize="12" />
                                    </StackPanel>
                                </Button>

                                <Border Background="#0C2548" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="8" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="💡 كيف يسجل المندوب دخوله؟" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,2" />
                                        <TextBlock Text="1. يفتح المندوب الرابط من هاتفه." FontSize="10.5" Foreground="#94A3B8" />
                                        <TextBlock Text="2. يختار اسمه ويكتب رمز الـ PIN." FontSize="10.5" Foreground="#94A3B8" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Reps Table -->
                        <Border Grid.Column="1" Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="قائمة المناديب المسجلين" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                    <Button HorizontalAlignment="Right" Style="{DynamicResource ActionButton}" Command="{Binding SaveRepsCommand}" Padding="10,5" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="💾 " FontSize="11" />
                                            <TextBlock Text="حفظ التعديلات" FontWeight="Bold" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <DataGrid Grid.Row="1"
                                          ItemsSource="{Binding RepAccounts}"
                                          SelectedItem="{Binding SelectedRepAccount}"
                                          AutoGenerateColumns="False"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          RowHeight="40"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="{DynamicResource BorderDark}"
                                          HeadersVisibility="Column"
                                          VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="اسم المندوب" Binding="{Binding Name}" Width="1.5*" FontWeight="Bold" />
                                        <DataGridTextColumn Header="رقم الهاتف" Binding="{Binding Phone}" Width="*" />
                                        <DataGridTextColumn Header="رمز الـ PIN" Binding="{Binding PinCode}" Width="95" FontWeight="Black" Foreground="#F59E0B" />
                                        
                                        <DataGridTemplateColumn Header="الحالة" Width="80">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}" Content="نشط" Foreground="#34D399" FontWeight="Bold" HorizontalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="إجراءات" Width="80">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.DeleteRepAccountCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{DynamicResource ActionButton}"
                                                            Padding="6,3"
                                                            HorizontalAlignment="Center"
                                                            Cursor="Hand"
                                                            ToolTip="حذف حساب المندوب">
                                                        <TextBlock Text="🗑️" FontSize="12" Foreground="#EF4444" />
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
