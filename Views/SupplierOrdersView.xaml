<UserControl x:Class="HamoPos.Views.SupplierOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:HamoPos.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="{DynamicResource BgDarkPrimary}"
             Foreground="{DynamicResource TextPrimary}"
             FlowDirection="RightToLeft"
             FontFamily="Segoe UI, Tahoma, Arial">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto" />
            <!-- 1: KPI Summary Cards -->
            <RowDefinition Height="Auto" />
            <!-- 2: Filters & Search Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- 3: Full Width Orders Table Grid -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- 0: HEADER & ACTIONS TOOLBAR -->
        <!-- ======================================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="44" Height="44" Background="#0C2548" CornerRadius="12" Margin="0,0,14,0">
                    <TextBlock Text="📦" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="سجل ومتابعة طلبيات المناديب والمحلات" FontSize="18" FontWeight="Black" Foreground="{DynamicResource TextPrimary}" />
                        <!-- Store Code Badge -->
                        <Border Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" CornerRadius="8" Padding="8,2" Margin="10,0,0,0">
                            <TextBlock Text="{Binding StoreId, StringFormat='{}كود المخزن: {0}'}" FontSize="11" FontWeight="Bold" Foreground="#34D399" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="استقبال ومتابعة طلبيات البضائع، اعتماد التسليم، طباعة وتصدير فواتير A4 بصيغة PDF وحفظها بالجهاز" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- Actions Top Right -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- Manage Reps Button -->
                <Button Click="OpenRepsWindow_Click" Style="{DynamicResource ActionButton}" Padding="12,8" Margin="0,0,8,0" Cursor="Hand" Background="#0C2548" BorderBrush="#38BDF8" ToolTip="إنشاء وإدارة حسابات المناديب ورموز الدخول PIN">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👥 " FontSize="13" />
                        <TextBlock Text="إدارة حسابات المناديب (PIN)" FontWeight="Bold" FontSize="12" Foreground="#38BDF8" />
                    </StackPanel>
                </Button>

                <!-- Cloud 24/7 Portal Button -->
                <Button Style="{DynamicResource ActionButton}" Command="{Binding OpenCloudPortalCommand}" Padding="12,8" Margin="0,0,8,0" Cursor="Hand" Background="#0C2548" BorderBrush="#0284C7" ToolTip="فتح صفحة الموبايل السحابية الخاصة بهذا المخزن">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🌐 " FontSize="13" />
                        <TextBlock Text="بوابة الموبايل السحابية" FontWeight="Bold" FontSize="12" />
                    </StackPanel>
                </Button>
                
                <!-- Copy Cloud Link -->
                <Button Style="{DynamicResource ActionButton}" Command="{Binding CopyCloudPortalUrlCommand}" Padding="10,8" Margin="0,0,8,0" Cursor="Hand" ToolTip="نسخ رابط السحابة المخصص لمخزنك لمشاركته مع المناديب">
                    <TextBlock Text="📋 نسخ الرابط" FontSize="11.5" FontWeight="Bold" />
                </Button>

                <!-- Invoices PDF Folder Button -->
                <Button Click="OpenPdfFolder_Click" Style="{DynamicResource ActionButton}" Padding="11,8" Margin="0,0,8,0" Cursor="Hand" Background="#1E293B" ToolTip="فتح مجلد فواتير PDF المحفوظة في المستندات">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📂 " FontSize="13" />
                        <TextBlock Text="مجلد فواتير PDF" FontWeight="Bold" FontSize="11.5" />
                    </StackPanel>
                </Button>

                <Button Style="{DynamicResource PrimarySuccessButton}" Command="{Binding AddNewOrderCommand}" Padding="16,8" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="➕ " FontSize="14" />
                        <TextBlock Text="تسجيل طلبية جديدة" FontWeight="Bold" FontSize="13" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ======================================================== -->
        <!-- 1: KPI SUMMARY CARDS STRIP -->
        <!-- ======================================================== -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Total Orders -->
            <Border Grid.Column="0" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" Padding="14,10" Margin="0,0,6,0" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="إجمالي الطلبيات" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock Text="{Binding TotalOrdersCount}" FontSize="19" FontWeight="Black" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- Pending Orders -->
            <Border Grid.Column="1" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" Padding="14,10" Margin="3,0,3,0" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="#F59E0B" Margin="0,0,5,0" />
                        <TextBlock Text="قيد الانتظار" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                    </StackPanel>
                    <TextBlock Text="{Binding PendingOrdersCount}" FontSize="19" FontWeight="Black" Foreground="#F59E0B" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- In Prep Orders -->
            <Border Grid.Column="2" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" Padding="14,10" Margin="3,0,3,0" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="#3B82F6" Margin="0,0,5,0" />
                        <TextBlock Text="جاري التجهيز" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                    </StackPanel>
                    <TextBlock Text="{Binding InPrepOrdersCount}" FontSize="19" FontWeight="Black" Foreground="#3B82F6" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- Delivered Orders -->
            <Border Grid.Column="3" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" Padding="14,10" Margin="3,0,3,0" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="#10B981" Margin="0,0,5,0" />
                        <TextBlock Text="تم التوصيل والتوريد" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                    </StackPanel>
                    <TextBlock Text="{Binding DeliveredOrdersCount}" FontSize="19" FontWeight="Black" Foreground="#10B981" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- Total Amount -->
            <Border Grid.Column="4" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" Padding="14,10" Margin="6,0,0,0" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="إجمالي قيمة الطلبيات" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock Text="{Binding TotalOrdersValue, StringFormat='{}{0:N0} د.ع'}" FontSize="17" FontWeight="Black" Foreground="{DynamicResource PrimaryAccent}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- 2: FILTERS & SEARCH TOOLBAR -->
        <!-- ======================================================== -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,16,0">
                <RadioButton Content="جميع الطلبيات" IsChecked="{Binding IsFilterAll}" Command="{Binding SetFilterCommand}" CommandParameter="All" Style="{DynamicResource FilterTabRadioButton}" />
                <RadioButton Content="⏳ قيد الانتظار" IsChecked="{Binding IsFilterPending}" Command="{Binding SetFilterCommand}" CommandParameter="Pending" Style="{DynamicResource FilterTabRadioButton}" Margin="6,0,0,0" />
                <RadioButton Content="📦 جاري التجهيز" IsChecked="{Binding IsFilterInPrep}" Command="{Binding SetFilterCommand}" CommandParameter="InPreparation" Style="{DynamicResource FilterTabRadioButton}" Margin="6,0,0,0" />
                <RadioButton Content="✔ تم التوصيل" IsChecked="{Binding IsFilterDelivered}" Command="{Binding SetFilterCommand}" CommandParameter="Delivered" Style="{DynamicResource FilterTabRadioButton}" Margin="6,0,0,0" />
            </StackPanel>

            <!-- Search Box -->
            <Border Grid.Column="1" Background="{DynamicResource BgDarkSecondary}" CornerRadius="10" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔍" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" VerticalAlignment="Center" FontSize="12.5" Height="34" VerticalContentAlignment="Center" CaretBrush="White" />
                </Grid>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- 3: FULL WIDTH ORDERS TABLE WITH ACTION BUTTONS -->
        <!-- ======================================================== -->
        <Border Grid.Row="3" Background="{DynamicResource BgDarkSecondary}" CornerRadius="16" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="12">
            <DataGrid x:Name="MainOrdersDataGrid"
                      ItemsSource="{Binding FilteredOrders}"
                      SelectedItem="{Binding SelectedOrder}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      Background="Transparent"
                      BorderThickness="0"
                      RowHeight="48"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource BorderDark}"
                      HeadersVisibility="Column"
                      VerticalScrollBarVisibility="Auto"
                      MouseDoubleClick="MainOrdersDataGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <!-- Order Number -->
                    <DataGridTextColumn Header="رقم الطلبية" Binding="{Binding OrderNumber}" Width="135" FontWeight="Bold" />
                    
                    <!-- Market Name -->
                    <DataGridTextColumn Header="الماركت / المحل" Binding="{Binding MarketName}" Width="1.5*" FontWeight="Black" Foreground="{DynamicResource PrimaryAccent}" />
                    
                    <!-- Phone -->
                    <DataGridTextColumn Header="الهاتف" Binding="{Binding MarketPhone}" Width="110" />

                    <!-- Representative -->
                    <DataGridTextColumn Header="المندوب" Binding="{Binding RepresentativeName}" Width="*" />

                    <!-- Date -->
                    <DataGridTextColumn Header="التاريخ والوقت" Binding="{Binding OrderDate, StringFormat='{}{0:yyyy/MM/dd - hh:mm tt}'}" Width="150" />

                    <!-- Total Amount -->
                    <DataGridTextColumn Header="المبلغ الإجمالي" Binding="{Binding TotalAmount, StringFormat='{}{0:N0} د.ع'}" Width="125" FontWeight="Black" Foreground="{DynamicResource SuccessBrush}" />
                    
                    <!-- Status Badge -->
                    <DataGridTemplateColumn Header="الحالة" Width="115">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" Padding="8,4" HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#334155" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                    <Setter Property="Background" Value="#854D0E" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="InPreparation">
                                                    <Setter Property="Background" Value="#1E40AF" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Delivered">
                                                    <Setter Property="Background" Value="#065F46" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Status}" FontSize="11.5" FontWeight="Bold" Foreground="White" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Row Actions Column (Full Features) -->
                    <DataGridTemplateColumn Header="خيارات وإجراءات الطلبية" Width="360">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <!-- View Details Button -->
                                    <Button Click="ViewOrderDetails_Click" Style="{DynamicResource ActionButton}" Padding="10,5" Margin="0,0,4,0" Cursor="Hand" Background="#0C2548" BorderBrush="#0284C7" ToolTip="عرض تفاصيل الطلبية والمواد كاملة">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📋 " FontSize="12" />
                                            <TextBlock Text="تفاصيل الطلبية" FontWeight="Bold" FontSize="11.5" Foreground="#38BDF8" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Quick Deliver Button -->
                                    <Button Click="QuickDeliver_Click" Style="{DynamicResource ActionButton}" Padding="9,5" Margin="0,0,4,0" Cursor="Hand" Background="#065F46" ToolTip="اعتماد وتسليم الطلبية فوراً">
                                        <TextBlock Text="✔ تسليم" FontWeight="Bold" FontSize="11.5" Foreground="White" />
                                    </Button>

                                    <!-- PDF Export Button -->
                                    <Button Click="QuickPdf_Click" Style="{DynamicResource ActionButton}" Padding="9,5" Margin="0,0,4,0" Cursor="Hand" Background="#1E293B" BorderBrush="#38BDF8" ToolTip="حفظ وتصدير الفاتورة بصيغة PDF بالجهاز">
                                        <TextBlock Text="📄 PDF" FontWeight="Bold" FontSize="11.5" Foreground="#38BDF8" />
                                    </Button>

                                    <!-- A4 Print Button -->
                                    <Button Click="QuickPrintA4_Click" Style="{DynamicResource ActionButton}" Padding="9,5" Cursor="Hand" Background="#334155" ToolTip="طباعة وصل A4 بالطابعة">
                                        <TextBlock Text="🖨️ A4" FontWeight="Bold" FontSize="11.5" Foreground="White" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
