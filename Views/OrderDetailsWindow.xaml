<Window x:Class="HamoPos.Views.OrderDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HamoPos.ViewModels"
        mc:Ignorable="d"
        Title="📋 تفاصيل الطلبية والفاتورة الرسمية A4 - 7amo POS" 
        Height="680" Width="920"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgDarkPrimary}"
        Foreground="{DynamicResource TextPrimary}"
        FlowDirection="RightToLeft"
        ResizeMode="CanResize"
        FontFamily="Segoe UI, Tahoma, Arial">

    <Border Padding="20" Background="{DynamicResource BgDarkPrimary}">
        <Grid>
            <Grid.RowDefinitions>
                <!-- 0: Header & Order Meta -->
                <RowDefinition Height="Auto" />
                <!-- 1: Items List DataGrid -->
                <RowDefinition Height="*" />
                <!-- 2: Summary & Totals -->
                <RowDefinition Height="Auto" />
                <!-- 3: Action Buttons Footer -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 0: Order Meta Header -->
            <Border Grid.Row="0" Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" Padding="16" Margin="0,0,0,14" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top Bar: Market Name & Order # -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="38" Height="38" Background="#0C2548" CornerRadius="10" Margin="0,0,10,0">
                                <TextBlock Text="🏪" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TxtMarketName" Text="اسم الماركت / العميل" FontSize="17" FontWeight="Black" Foreground="{DynamicResource PrimaryAccent}" />
                                <TextBlock x:Name="TxtOrderNumber" Text="ORD-0000-000" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Status Badge Top Left -->
                        <Border x:Name="BadgeStatus" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#854D0E" CornerRadius="8" Padding="12,5">
                            <TextBlock x:Name="TxtStatus" Text="⏳ قيد الانتظار" FontSize="12.5" FontWeight="Bold" Foreground="White" />
                        </Border>
                    </Grid>

                    <!-- Info Grid -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="📞 هاتف الماركت:" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock x:Name="TxtPhone" Text="--" FontSize="13" FontWeight="Bold" Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="👤 المندوب المسؤول:" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock x:Name="TxtRep" Text="مندوب المبيعات" FontSize="13" FontWeight="Bold" Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="📍 عنوان التوصيل:" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock x:Name="TxtAddress" Text="--" FontSize="12.5" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 1: Items List DataGrid -->
            <Border Grid.Row="1" Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" Padding="12" Margin="0,0,0,12" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="📋 قائمة الأصناف والمواد المطلوبة:" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" />

                    <DataGrid x:Name="ItemsDataGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Background="Transparent"
                              BorderThickness="0"
                              RowHeight="38"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource BorderDark}"
                              HeadersVisibility="Column"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="اسم المادة" Binding="{Binding ProductName}" Width="2*" FontWeight="Bold" />
                            <DataGridTextColumn Header="الباركود" Binding="{Binding Barcode}" Width="*" />
                            <DataGridTextColumn Header="نوع الوحدة" Binding="{Binding UnitType}" Width="90" />
                            <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, StringFormat='{}{0:N0}'}" Width="80" FontWeight="Black" />
                            <DataGridTextColumn Header="سعر الوحدة" Binding="{Binding UnitPrice, StringFormat='{}{0:N0} د.ع'}" Width="110" />
                            <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalPrice, StringFormat='{}{0:N0} د.ع'}" Width="120" FontWeight="Black" Foreground="{DynamicResource SuccessBrush}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- 2: Summary & Notes Bar -->
            <Grid Grid.Row="2" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" Padding="12" Margin="0,0,10,0" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="📝 ملاحظات التوصيل:" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock x:Name="TxtNotes" Text="لا توجد ملاحظات إضافية." FontSize="12" Margin="0,3,0,0" Foreground="{DynamicResource TextPrimary}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#0C2548" CornerRadius="12" Padding="14,10" BorderBrush="#0284C7" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="المجموع الصافي المستحق:" FontSize="11" Foreground="#93C5FD" />
                        <TextBlock x:Name="TxtGrandTotal" Text="0 د.ع" FontSize="20" FontWeight="Black" Foreground="#38BDF8" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3: Action Buttons Footer -->
            <Border Grid.Row="3" Background="{DynamicResource BgDarkSecondary}" CornerRadius="14" Padding="14" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Status modifier -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Click="DeliverOrder_Click" Style="{DynamicResource PrimarySuccessButton}" Padding="16,9" Height="42" Cursor="Hand" Background="#059669" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✔ " FontSize="14" />
                                <TextBlock Text="تسليم واعتماد الطلبية" FontWeight="Black" FontSize="13" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Center: Export PDF & Print A4 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <!-- Export PDF Button (Highlighted) -->
                        <Button Click="ExportPdf_Click" Style="{DynamicResource ActionButton}" Padding="16,9" Height="42" Cursor="Hand" Background="#0C2548" BorderBrush="#38BDF8" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📄 " FontSize="15" />
                                <TextBlock Text="حفظ وتصدير PDF" FontWeight="Bold" FontSize="13" Foreground="#38BDF8" />
                            </StackPanel>
                        </Button>

                        <!-- Print A4 -->
                        <Button Click="PrintA4_Click" Style="{DynamicResource ActionButton}" Padding="16,9" Height="42" Cursor="Hand" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🖨️ " FontSize="14" />
                                <TextBlock Text="طباعة وصل A4" FontWeight="Bold" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <!-- Convert to Invoice -->
                        <Button Click="ConvertToInvoice_Click" Style="{DynamicResource ActionButton}" Padding="14,9" Height="42" Cursor="Hand" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🛒 " FontSize="13" />
                                <TextBlock Text="تحويل لمخزن الشراء" FontWeight="Bold" FontSize="12.5" />
                            </StackPanel>
                        </Button>

                        <!-- Open Invoices Folder -->
                        <Button Click="OpenFolder_Click" Style="{DynamicResource ActionButton}" Padding="12,9" Height="42" Cursor="Hand" ToolTip="فتح مجلد ملفات فواتير PDF">
                            <TextBlock Text="📂 مجلد PDF" FontSize="12" />
                        </Button>
                    </StackPanel>

                    <!-- Right: Close -->
                    <Button Grid.Column="2" Click="Close_Click" Style="{DynamicResource ActionButton}" Padding="16,9" Height="42" Cursor="Hand" Background="#334155">
                        <TextBlock Text="✖ إغلاق" FontSize="13" FontWeight="Bold" Foreground="#F87171" />
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
