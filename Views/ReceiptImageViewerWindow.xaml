<Window x:Class="HamoPos.Views.ReceiptImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="عرض صورة وصل المندوب"
        Height="700" Width="800"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI, Tahoma, Arial">

    <Border Background="{DynamicResource BgDarkSecondary}" 
            CornerRadius="16" 
            BorderBrush="{DynamicResource BorderDark}" 
            BorderThickness="1.5" 
            Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.6" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- 0: Header -->
                <RowDefinition Height="Auto" />
                <!-- 1: Image Viewer -->
                <RowDefinition Height="*" />
                <!-- 2: Footer Actions -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 0: Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" Background="#0C2548" CornerRadius="10" Margin="0,0,10,0">
                        <TextBlock Text="📷" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtInvoiceTitle" Text="صورة وصل المندوب المرفقة" FontSize="16" FontWeight="Black" Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock x:Name="TxtInvoiceSubtitle" Text="معاينة الوصل الورقي أو إرفاق صورة جديدة" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <Button HorizontalAlignment="Right" Click="Close_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6">
                    <TextBlock Text="✕" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" />
                </Button>
            </Grid>

            <!-- 1: Image Viewer Container -->
            <Border Grid.Row="1" Background="#0A0F1D" CornerRadius="12" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="10">
                <Grid>
                    <!-- Empty State Placeholder -->
                    <StackPanel x:Name="EmptyPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="🖼️" FontSize="44" HorizontalAlignment="Center" Opacity="0.4" />
                        <TextBlock Text="لم يتم إرفاق صورة لهذا الوصل بعد." FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        <Button Click="AttachImage_Click" Style="{DynamicResource PrimaryAccentButton}" Padding="16,8" HorizontalAlignment="Center" Margin="0,14,0,0" Cursor="Hand">
                            <TextBlock Text="📷 اختيار وإرفاق صورة الآن" FontWeight="Bold" />
                        </Button>
                    </StackPanel>

                    <!-- Image Display -->
                    <ScrollViewer x:Name="ImageScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Image x:Name="ImgReceipt" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 2: Footer Actions -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Button Click="DeleteImage_Click" Style="{DynamicResource ActionButton}" Padding="14,8" HorizontalAlignment="Left" Cursor="Hand" Background="#450A0A" BorderBrush="#EF4444">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🗑 " FontSize="13" />
                        <TextBlock Text="حذف الصورة المرفقة" FontWeight="Bold" Foreground="#FCA5A5" />
                    </StackPanel>
                </Button>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Click="AttachImage_Click" Style="{DynamicResource PrimaryAccentButton}" Padding="16,8" Margin="0,0,10,0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄 " FontSize="13" />
                            <TextBlock Text="تغيير الصورة" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                    <Button Click="Close_Click" Style="{DynamicResource ActionButton}" Padding="20,8" Cursor="Hand">
                        <TextBlock Text="إغلاق" FontWeight="Bold" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
