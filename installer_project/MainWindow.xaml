<Window x:Class="HamoPos.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="⚡ معالج تثبيت برنامج 7amo POS" 
        Height="440" Width="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgDarkPrimary}"
        Foreground="{DynamicResource TextPrimary}"
        FlowDirection="RightToLeft"
        ResizeMode="NoResize"
        FontFamily="Segoe UI, Tahoma, Arial">

    <Border Background="{DynamicResource BgDarkPrimary}" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <!-- 0: Header with Logo & Title -->
                <RowDefinition Height="Auto" />
                <!-- 1: Body Content (Wizard Step) -->
                <RowDefinition Height="*" />
                <!-- 2: Footer / Buttons -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 0: Header -->
            <Border Grid.Row="0" Background="{DynamicResource BgDarkSecondary}" CornerRadius="12" Padding="14" Margin="0,0,0,16" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="48" Height="48" Background="#0C2548" CornerRadius="12" Margin="0,0,14,0">
                            <TextBlock Text="⚡" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="7amo.pos - نظام نقاط البيع والمخازن المتكامل" FontSize="16" FontWeight="Black" Foreground="#38BDF8" />
                            <TextBlock Text="مرحباً بك في معالج التثبيت السريع لنظام الكاشير والمخازن" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 1: Body Content -->
            <Grid Grid.Row="1">
                <!-- VIEW 1: CONFIGURATION VIEW -->
                <StackPanel x:Name="ConfigPanel" Visibility="Visible">
                    <!-- Install Directory -->
                    <TextBlock Text="📁 مسار تثبيت البرنامج على هذا الكمبيوتر:" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtInstallPath" 
                                 Background="#0C152B" Foreground="#FFFFFF" BorderBrush="#334155" 
                                 FontSize="13" Padding="10,7" Margin="0,0,8,0" />
                        <Button Grid.Column="1" Click="BrowseButton_Click" Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" Padding="14,7" Cursor="Hand">
                            <TextBlock Text="استعراض..." FontWeight="Bold" />
                        </Button>
                    </Grid>

                    <!-- Checkbox Options -->
                    <Border Background="{DynamicResource BgDarkSecondary}" CornerRadius="10" Padding="14,10" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Margin="0,0,0,10">
                        <StackPanel>
                            <CheckBox x:Name="ChkDesktopShortcut" IsChecked="True" Foreground="#F8FAFC" FontSize="12.5" Margin="0,0,0,8" Cursor="Hand">
                                <TextBlock Text="إنشاء أيقونة واختصار تشغيل على سطح المكتب (Desktop Shortcut)" />
                            </CheckBox>
                            <CheckBox x:Name="ChkStartMenuShortcut" IsChecked="True" Foreground="#F8FAFC" FontSize="12.5" Margin="0,0,0,8" Cursor="Hand">
                                <TextBlock Text="إنشاء اختصار في قائمة ابدأ (Start Menu)" />
                            </CheckBox>
                            <CheckBox x:Name="ChkLaunchAfter" IsChecked="True" Foreground="#34D399" FontSize="12.5" FontWeight="Bold" Cursor="Hand">
                                <TextBlock Text="تشغيل البرنامج فوراً بعد اكتمال التثبيت" />
                            </CheckBox>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- VIEW 2: PROGRESS VIEW -->
                <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatus" Text="جارٍ استخراج وتثبيت ملفات النظام..." FontSize="14" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <ProgressBar x:Name="InstallProgressBar" Height="22" IsIndeterminate="True" Foreground="#10B981" Background="#0C152B" BorderBrush="#334155" />
                    <TextBlock Text="يرجى الانتظار بضع ثوانٍ حتى يتم تجهيز البرنامج بالكامل..." FontSize="11" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>

                <!-- VIEW 3: SUCCESS VIEW -->
                <StackPanel x:Name="SuccessPanel" Visibility="Collapsed" VerticalAlignment="Center">
                    <Border Width="56" Height="56" Background="#064E3B" CornerRadius="28" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <TextBlock Text="✔" FontSize="28" Foreground="#34D399" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="تم تثبيت برنامج 7amo POS بنجاح!" FontSize="18" FontWeight="Black" Foreground="#34D399" HorizontalAlignment="Center" Margin="0,0,0,6" />
                    <TextBlock Text="البرنامج جاهز للاستخدام الآن على هذا الجهاز." FontSize="12" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- 2: Footer Buttons -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnInstall" Grid.Column="0" Click="InstallButton_Click" Background="#059669" Foreground="#FFFFFF" BorderThickness="0" Height="42" Cursor="Hand" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🚀 " FontSize="15" />
                        <TextBlock Text="تثبيت البرنامج الآن" FontWeight="Black" FontSize="14" />
                    </StackPanel>
                </Button>

                <Button x:Name="BtnFinish" Grid.Column="0" Click="FinishButton_Click" Visibility="Collapsed" Background="#0284C7" Foreground="#FFFFFF" BorderThickness="0" Height="42" Cursor="Hand" Margin="0,0,8,0">
                    <TextBlock Text="إنهاء وتشغيل البرنامج" FontWeight="Black" FontSize="14" />
                </Button>

                <Button x:Name="BtnCancel" Grid.Column="1" Click="CancelButton_Click" Background="#1E293B" Foreground="#94A3B8" BorderThickness="0" Width="100" Height="42" Cursor="Hand">
                    <TextBlock Text="إلغاء" FontWeight="SemiBold" FontSize="13" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
