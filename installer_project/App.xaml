<Application x:Class="HamoPos.Installer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Dark Modern Theme Colors -->
        <SolidColorBrush x:Key="BgDarkPrimary" Color="#0B132B" />
        <SolidColorBrush x:Key="BgDarkSecondary" Color="#1C2541" />
        <SolidColorBrush x:Key="PrimaryAccent" Color="#0284C7" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#10B981" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8" />
        <SolidColorBrush x:Key="BorderDark" Color="#1E293B" />
    </Application.Resources>
</Application>
