<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Modern Tech Vibrant Night Mode Palette -->
    <Color x:Key="BgDarkPrimaryColor">#090D16</Color>
    <Color x:Key="BgDarkSecondaryColor">#0F172A</Color>
    <Color x:Key="BgDarkCardColor">#162032</Color>
    <Color x:Key="BgDarkHoverColor">#1E2C44</Color>
    <Color x:Key="BgDarkInputColor">#0D1424</Color>
    <Color x:Key="BorderDarkColor">#263750</Color>
    
    <Color x:Key="PrimaryAccentColor">#3B82F6</Color>
    <Color x:Key="PrimaryAccentHoverColor">#2563EB</Color>
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="SuccessHoverColor">#059669</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="WarningHoverColor">#D97706</Color>
    <Color x:Key="DangerColor">#F43F5E</Color>
    <Color x:Key="DangerHoverColor">#E11D48</Color>
    
    <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#94A3B8</Color>
    <Color x:Key="TextMutedColor">#64748B</Color>

    <SolidColorBrush x:Key="BgDarkPrimary" Color="{StaticResource BgDarkPrimaryColor}" />
    <SolidColorBrush x:Key="BgDarkSecondary" Color="{StaticResource BgDarkSecondaryColor}" />
    <SolidColorBrush x:Key="BgDarkCard" Color="{StaticResource BgDarkCardColor}" />
    <SolidColorBrush x:Key="BgDarkHover" Color="{StaticResource BgDarkHoverColor}" />
    <SolidColorBrush x:Key="BgDarkInput" Color="{StaticResource BgDarkInputColor}" />
    <SolidColorBrush x:Key="BorderDark" Color="{StaticResource BorderDarkColor}" />
    
    <SolidColorBrush x:Key="PrimaryAccent" Color="{StaticResource PrimaryAccentColor}" />
    <SolidColorBrush x:Key="PrimaryAccentHover" Color="{StaticResource PrimaryAccentHoverColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessBrushHover" Color="{StaticResource SuccessHoverColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningBrushHover" Color="{StaticResource WarningHoverColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerBrushHover" Color="{StaticResource DangerHoverColor}" />
    
    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMuted" Color="{StaticResource TextMutedColor}" />
</ResourceDictionary>
